  { icon: '👤', title: 'Cuentas premium y no premium', description: 'Configura tu cuenta según tu caso para poder entrar.', linkKey: 'wikiCuenta', color: 'text-cyan-400', border: 'hover:border-cyan-500', order: 7 },
