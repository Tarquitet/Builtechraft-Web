---
// src/pages/wiki.astro
import Layout from '../layouts/Layout.astro';

interface WikiPage {
    id: string;
    title: string;
    category: string;
    order: number;
    isNative: boolean;
    Content?: any;
    frontmatter?: Record<string, any>;
}

// 1. CARGAMOS LOS MARKDOWN (Historia, Fundador, Guías)
const mdFiles = import.meta.glob([
    '../data/historia/*.md',
    '../data/wiki/**/*.md'
], { eager: true });

const mdPages: WikiPage[] = Object.entries(mdFiles).map(([path, doc]: any) => {
    const parts = path.split('/');
    const fileName = parts.pop().replace('.md', '');
    const folderName = parts.pop();
    
    let title = doc.frontmatter.title || fileName;
    if (doc.frontmatter.titulo_blanco || doc.frontmatter.titulo_color) {
        title = `${doc.frontmatter.titulo_blanco || ''} ${doc.frontmatter.titulo_color || ''}`.trim();
    } else if (doc.frontmatter.nombre) {
        title = doc.frontmatter.nombre;
    }

    let category = doc.frontmatter.category;
    if (!category) {
        if (folderName === 'historia') category = 'Historia del Servidor';
        else if (fileName === 'fundador') category = 'Historia del Servidor';
        else category = 'General';
    }

    return {
        id: fileName.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
        title: title,
        category: category,
        order: doc.frontmatter.order || 99,
        isNative: false,
        Content: doc.default,
        frontmatter: doc.frontmatter
    };
});

// 2. CARGAMOS LOS COMPONENTES .ASTRO DINÁMICAMENTE (Modpack, Roadmap, etc.)
const astroFiles = import.meta.glob('../components/wiki/*.astro', { eager: true });

const astroPages: WikiPage[] = Object.entries(astroFiles).map(([path, module]: any) => {
    const fileName = path.split('/').pop().replace('.astro', '');
    
    return {
        id: fileName.toLowerCase().replace(/[^a-z0-9]+/g, '-'),
        title: module.title || fileName,         
        category: module.category || 'General',  
        order: module.order || 99,               
        isNative: true,
        Content: module.default                  
    };
});

// 3. JUNTAMOS AMBAS LISTAS Y ORDENAMOS
const allPages = [...mdPages, ...astroPages].sort((a, b) => a.order - b.order);

// 4. AGRUPAMOS POR CATEGORÍAS
const groupedPages = allPages.reduce((acc: Record<string, WikiPage[]>, page) => {
    if (!acc[page.category]) acc[page.category] = [];
    acc[page.category].push(page);
    return acc;
}, {} as Record<string, WikiPage[]>);
---

<Layout title="Wiki | Builtechraft" description="Documentación oficial, guías, lore y staff del servidor.">
    
    <!-- WRAPPER PRINCIPAL -->
    <div class="flex flex-col md:flex-row flex-1 w-full bg-[#0a0a0c] pt-20">
        
        <!-- SIDEBAR (Escritorio) - AHORA ES STICKY, NO PISARÁ EL FOOTER -->
        <aside class="hidden md:block w-72 shrink-0 border-r border-white/5 bg-[#111] z-30">
            <div class="sticky top-20 h-[calc(100vh-5rem)] overflow-y-auto custom-scrollbar p-6">
                <h2 class="text-xl font-display font-bold text-white mb-6 uppercase tracking-widest border-b border-white/10 pb-4">
                    Índice
                </h2>
                <div class="space-y-2">
                    {Object.entries(groupedPages).map(([category, items]) => (
                        <details class="group">
                            <summary class="flex justify-between items-center cursor-pointer list-none text-[10px] font-bold text-zinc-400 hover:text-white uppercase tracking-[0.2em] py-2 select-none transition-colors">
                                {category}
                                <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                            </summary>
                            <ul class="space-y-1 border-l border-white/10 ml-2 pl-3 mb-4 mt-1">
                                {items.map((item: WikiPage) => (
                                    <li>
                                        <a href={`#${item.id}`} class="wiki-nav-trigger sidebar-link text-xs font-medium text-zinc-500 hover:text-btc-orange transition-colors block py-1.5" data-target={item.id}>
                                            {item.title}
                                        </a>
                                    </li>
                                ))}
                            </ul>
                        </details>
                    ))}
                </div>
            </div>
        </aside>

        <!-- COLUMNA DERECHA (Índice Móvil + Contenido) -->
        <div class="flex-1 min-w-0 w-full flex flex-col relative">
            
            <!-- ÍNDICE PARA MÓVILES -->
            <div class="md:hidden w-full bg-[#111] border-b border-white/5 p-4 z-30 relative">
                <details class="group bg-black/40 rounded-xl border border-white/5 p-4">
                    <summary class="flex justify-between items-center cursor-pointer list-none text-xs font-bold text-btc-orange uppercase tracking-widest select-none">
                        Menú de Información
                        <svg class="w-5 h-5 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </summary>
                    <div class="mt-4 grid grid-cols-1 gap-4 pt-4 border-t border-white/10">
                        {Object.entries(groupedPages).map(([category, items]) => (
                            <div>
                                <h4 class="text-[10px] text-zinc-500 font-bold uppercase tracking-widest mb-2">{category}</h4>
                                <ul class="space-y-2 flex flex-col gap-1 pl-2 border-l border-white/10">
                                    {items.map((item: WikiPage) => (
                                        <li>
                                            <a href={`#${item.id}`} class="wiki-nav-trigger sidebar-link text-xs text-zinc-300 hover:text-btc-orange transition-colors block py-1" data-target={item.id}>
                                                {item.title}
                                            </a>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        ))}
                    </div>
                </details>
            </div>

            <!-- CONTENIDO PRINCIPAL -->
            <main class="p-6 md:p-12 lg:p-16 max-w-5xl mx-auto w-full flex-1">
                
                <!-- PANTALLA DE BIENVENIDA -->
                <div id="wiki-welcome" class="flex flex-col items-center justify-center text-center min-h-[50vh] mt-8 md:mt-12 animate-fade-in px-4">
                    <div class="w-20 h-20 bg-btc-orange/10 rounded-2xl flex items-center justify-center border border-btc-orange/20 mb-6 shadow-lg shadow-btc-orange/5">
                        <svg class="w-10 h-10 text-btc-orange" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"></path></svg>
                    </div>
                    <h1 class="text-4xl md:text-5xl font-display font-bold text-white uppercase tracking-tight mb-4 drop-shadow-md">
                        Info & <span class="text-btc-orange">Wiki</span>
                    </h1>
                    <p class="text-zinc-400 text-lg max-w-lg">
                        Toda la documentación, guías técnicas, equipo y normativas del servidor. Selecciona un apartado en el menú para comenzar.
                    </p>
                </div>

                <!-- CONTENEDOR DE ARTÍCULOS -->
                <div id="articles-container">
                    {allPages.map((page, index) => {
                        const prevPage = index > 0 ? allPages[index - 1] : null;
                        const nextPage = index < allPages.length - 1 ? allPages[index + 1] : null;
                        
                        const DynamicContent = page.Content;

                        return (
                            <article id={`article-${page.id}`} class="wiki-article hidden animate-fade-in pb-16">
                                
                                {!page.isNative && (
                                    <header class="border-b border-white/10 pb-8 mb-10 mt-2">
                                        <span class="text-btc-orange font-bold uppercase tracking-[0.2em] text-[10px] mb-2 block">{page.category}</span>
                                        <h1 class="text-3xl md:text-5xl font-display font-bold text-white uppercase tracking-tight m-0 p-0">
                                            {page.title}
                                        </h1>
                                    </header>
                                )}

                                {page.isNative ? (
                                    <div class="w-full relative mt-4 -mx-6 md:mx-0 px-6 md:px-0">
                                        {DynamicContent && <DynamicContent />}
                                    </div>
                                ) : (
                                    <div class="wiki-prose">
                                        {page.frontmatter?.imagen && (
                                            <img 
                                                src={page.frontmatter.imagen} 
                                                alt={page.title} 
                                                class="w-full h-48 md:h-80 object-cover rounded-3xl mb-10 border border-white/10 shadow-2xl" 
                                                loading="lazy" 
                                            />
                                        )}
                                        {DynamicContent && <DynamicContent />}
                                    </div>
                                )}

                                <!-- NAVEGACIÓN ANTERIOR / SIGUIENTE -->
                                <div class="mt-20 pt-8 border-t border-white/10 flex flex-col sm:flex-row items-stretch justify-between gap-4 w-full">
                                    {prevPage ? (
                                        <button class="wiki-nav-trigger w-full sm:w-1/2 flex flex-col items-start p-5 rounded-2xl bg-black/40 border border-white/5 hover:border-btc-orange hover:bg-black/60 transition-all text-left group" data-target={prevPage.id}>
                                            <span class="text-[10px] text-zinc-500 font-bold uppercase tracking-widest mb-2 group-hover:text-btc-orange transition-colors flex items-center gap-2">
                                                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg> Anterior
                                            </span>
                                            <span class="text-sm font-bold text-zinc-300 group-hover:text-white transition-colors">{prevPage.title}</span>
                                        </button>
                                    ) : <div class="w-full sm:w-1/2"></div>}

                                    {nextPage ? (
                                        <button class="wiki-nav-trigger w-full sm:w-1/2 flex flex-col items-end p-5 rounded-2xl bg-black/40 border border-white/5 hover:border-btc-orange hover:bg-black/60 transition-all text-right group" data-target={nextPage.id}>
                                            <span class="text-[10px] text-zinc-500 font-bold uppercase tracking-widest mb-2 group-hover:text-btc-orange transition-colors flex items-center gap-2">
                                                Siguiente <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
                                            </span>
                                            <span class="text-sm font-bold text-zinc-300 group-hover:text-white transition-colors">{nextPage.title}</span>
                                        </button>
                                    ) : <div class="w-full sm:w-1/2"></div>}
                                </div>
                            </article>
                        )
                    })}
                </div>

            </main>
        </div>
    </div>
</Layout>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const sidebarLinks = document.querySelectorAll('.sidebar-link');
        const navTriggers = document.querySelectorAll('.wiki-nav-trigger');
        const articles = document.querySelectorAll('.wiki-article');
        const welcomeScreen = document.getElementById('wiki-welcome');

        function showArticle(targetId) {
            let found = false;
            
            articles.forEach(art => {
                if (art.id === `article-${targetId}`) {
                    art.classList.remove('hidden');
                    art.classList.add('block');
                    found = true;
                } else {
                    art.classList.remove('block');
                    art.classList.add('hidden');
                }
            });

            sidebarLinks.forEach(link => {
                const isTarget = link.getAttribute('data-target') === targetId;
                if (isTarget) {
                    link.classList.remove('text-zinc-500');
                    link.classList.add('text-btc-orange', 'font-bold');
                    const detailsParent = link.closest('details');
                    if (detailsParent && !detailsParent.open) {
                        detailsParent.open = true;
                    }
                } else {
                    link.classList.remove('text-btc-orange', 'font-bold');
                    link.classList.add('text-zinc-500');
                }
            });

            if (found && welcomeScreen) {
                welcomeScreen.classList.add('hidden');
                welcomeScreen.classList.remove('flex');
            }

            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        const hash = window.location.hash.substring(1);
        if (hash) showArticle(hash);

        navTriggers.forEach(trigger => {
            trigger.addEventListener('click', (e) => {
                const targetId = trigger.getAttribute('data-target');
                showArticle(targetId);
                window.history.pushState(null, '', `#${targetId}`);
            });
        });
    });
</script>

<style is:global>
    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
    .animate-fade-in { animation: fadeIn 0.4s ease-out forwards; }

    /* Forzamos que cualquier modal de Staff aparezca por encima del Navbar en la Wiki */
    dialog#staff-modal { z-index: 100 !important; }

    .wiki-prose h1 { display: none; }
    
    .wiki-prose h2 { 
        font-family: 'Rajdhani', sans-serif; font-size: 1.8rem; font-weight: 700; 
        color: #f97316; text-transform: uppercase; margin-top: 3rem; margin-bottom: 1rem; 
        border-bottom: 1px solid rgba(255,255,255,0.05); padding-bottom: 0.5rem;
    }
    
    .wiki-prose h3 { font-size: 1.3rem; font-weight: 700; color: #fbbf24; margin-top: 2rem; margin-bottom: 1rem; }
    
    .wiki-prose p { color: #d4d4d8; font-size: 1rem; line-height: 1.8; margin-bottom: 1.5rem; text-align: justify; }
    
    .wiki-prose a { color: #f97316; font-weight: 600; transition: all 0.2s; }
    .wiki-prose a:hover { color: #ffffff; text-decoration: underline; text-underline-offset: 4px; text-decoration-color: #f97316; }
    
    .wiki-prose strong { color: #ffffff; font-weight: 700; }
    .wiki-prose em { color: #a1a1aa; font-style: italic; }
    
    .wiki-prose ul { list-style-type: none; padding-left: 0; margin-bottom: 1.5rem; color: #d4d4d8; }
    .wiki-prose ul li { position: relative; padding-left: 1.5rem; margin-bottom: 0.5rem; }
    .wiki-prose ul li::before { content: "▹"; position: absolute; left: 0; top: 0; color: #f97316; font-weight: bold; }
    
    .wiki-prose blockquote {
        border-left: 4px solid #f97316; background: rgba(255,255,255,0.02); 
        padding: 1.5rem; margin: 2rem 0; border-radius: 0 1rem 1rem 0; font-style: italic; color: #a1a1aa;
    }

    details > summary::-webkit-details-marker { display: none; }

    .custom-scrollbar::-webkit-scrollbar { width: 4px; }
    .custom-scrollbar::-webkit-scrollbar-track { background: transparent; }
    .custom-scrollbar::-webkit-scrollbar-thumb { background: #3f3f46; border-radius: 10px; }
    .custom-scrollbar:hover::-webkit-scrollbar-thumb { background: #f97316; }
</style>