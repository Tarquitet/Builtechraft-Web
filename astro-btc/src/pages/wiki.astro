---
import Layout from '../layouts/Layout.astro';
import DiscordBanner from '../components/discord/DiscordBanner.astro';

// Lee TODOS los intro.mdx que estén dentro de una carpeta de primer nivel en wiki/
// Ejemplo de ruta detectada: './wiki/gameplay/intro.mdx'
const categoryModules = import.meta.glob('./wiki/*/intro.mdx', { eager: true }) as any;

const categories = Object.entries(categoryModules).map(([path, mod]: [string, any]) => {
  const fm = mod.frontmatter ?? {};
  // Extrae el nombre de la carpeta: './wiki/gameplay/intro.mdx' -> 'gameplay'
  const slug = path.split('/')[2]; 
  return {
    slug,
    title: fm.title || slug,
    description: fm.description || 'Explora los artículos de esta categoría.',
    icon: fm.icon || '📂',
    color: fm.color || 'text-btc-orange',
    border: fm.border || 'hover:border-btc-orange',
    order: fm.order ?? 99,
    url: `/wiki/${slug}`
  };
}).sort((a, b) => a.order - b.order);
---

<Layout title="Wiki | Builtechraft" description="Guías, tutoriales y documentación del servidor Builtechraft.">
  <main class="pt-32 pb-24 min-h-screen bg-theme-section">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-16">
        <span class="comparative-badge">Biblioteca</span>
        <h1 class="category-title mt-4">Artículos de la <span class="text-btc-orange">Wiki</span></h1>
        <p class="category-subtitle">Elige una categoría para explorar guías, tutoriales y documentación.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {categories.map((cat) => (
          <a href={cat.url} class={`card-retro ${cat.border} group relative p-8 flex flex-col gap-4`}>
            <span class="text-5xl mb-2 block">{cat.icon}</span>
            <h2 class={`text-2xl font-display font-bold uppercase tracking-tight ${cat.color}`}>{cat.title}</h2>
            <p class="text-theme-muted text-sm leading-relaxed flex-grow">{cat.description}</p>
            <span class="text-xs font-bold uppercase tracking-widest text-btc-orange group-hover:translate-x-1 transition-transform inline-flex items-center gap-1">Explorar categoría <span>→</span></span>
          </a>
        ))}
      </div>
    </div>
  </main>
  <DiscordBanner />
</Layout>