---
import Layout from '../layouts/Layout.astro';
import DiscordBanner from '../components/discord/DiscordBanner.astro';
import { getDictionary, getLocaleFromPath, localizePath } from '../lib/i18n';
import { getWikiCategories } from '../lib/wikiContent';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
const categories = getWikiCategories(locale).map(({ category: slug, module: mod }) => {
  const fm = mod.frontmatter ?? {};
  const categoryCopy = (dict.common.wiki.categories as any)[slug];
  return {
    slug,
    title: categoryCopy?.title || fm.title || slug,
    description: categoryCopy?.description || fm.description || dict.common.wiki.categoryFallback,
    icon: fm.icon || '📂',
    color: fm.color || 'text-btc-orange',
    border: fm.border || 'hover:border-btc-orange',
    order: fm.order ?? 99,
    url: localizePath(`/wiki/${slug}`, locale)
  };
}).sort((a, b) => a.order - b.order);
---

<Layout title={`Wiki | Builtechraft`} description={dict.common.wiki.portalDescription} lang={locale}>
  <main class="pt-32 pb-24 min-h-screen bg-theme-section">
    <div class="container mx-auto px-6 max-w-6xl">
      <div class="text-center mb-16">
        <span class="px-4 py-1.5 rounded-full border border-btc-orange/30 bg-btc-orange/10 text-btc-orange text-[10px] font-bold uppercase tracking-[0.2em] mb-3 inline-block">
          {dict.common.wiki.pageTitle}
        </span>
        <h1 class="text-4xl md:text-5xl font-display font-bold uppercase tracking-tight text-theme-main mt-4">
          {dict.common.wiki.portalTitle}
        </h1>
        <p class="text-theme-muted mt-4 max-w-2xl mx-auto text-lg">
          {dict.common.wiki.portalDescription}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        {categories.map((cat) => (
          <a 
            href={cat.url} 
            class={`group flex items-start gap-5 p-6 bg-theme-card border border-theme-1 transition-all duration-300 hover:border-btc-orange/50 hover:-translate-y-0.5`}
            style="box-shadow: 4px 4px 0px rgba(0,0,0,0.3);"
          >
            <!-- Icono contenido y profesional -->
            <div class={`w-12 h-12 flex items-center justify-center shrink-0 border bg-theme-app transition-transform duration-300 group-hover:scale-110 ${cat.border.replace('hover:border-', 'border-')} ${cat.color.replace('text-', 'text-')}`}>
              <span class="text-2xl">{cat.icon}</span>
            </div>
            
            <div class="flex-1 min-w-0">
              <h2 class={`text-lg font-display font-bold uppercase tracking-wide mb-1 text-theme-main group-hover:text-btc-orange transition-colors`}>
                {cat.title}
              </h2>
              <p class="text-sm text-theme-muted leading-relaxed">
                {cat.description}
              </p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
  <DiscordBanner />
</Layout>