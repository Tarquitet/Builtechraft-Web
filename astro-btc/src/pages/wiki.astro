  { icon: '🚀', title: 'Launchers e instalación', description: 'Instala el modpack paso a paso en Modrinth App, Prism y más.', linkKey: 'wikiLaunchers', color: 'text-blue-400', border: 'hover:border-blue-500', order: 3 },
  { icon: '⚙️', title: 'Mecánicas del servidor', description: 'Comandos personalizados y sistemas únicos de Builtechcraft.', linkKey: 'wikiMecanicas', color: 'text-purple-400', border: 'hover:border-purple-500', order: 4 },
  { icon: '📜', title: 'Whitelist', description: 'Cómo pedir tu acceso y los requisitos para entrar a jugar.', linkKey: 'wikiWhitelist', color: 'text-btc-yellow', border: 'hover:border-btc-yellow', order: 5 },
