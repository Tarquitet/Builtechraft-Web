---
import Layout from '../../../layouts/Layout.astro';
import DiscordBanner from '../../../components/discord/DiscordBanner.astro';
import { getDictionary, getLocaleFromPath } from '../../../lib/i18n';
import { getWikiArticles, getWikiCategories, getWikiIntro } from '../../../lib/wikiContent';

interface Props {
  category?: string;
}

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
const localizedPrefix = Astro.url.pathname.startsWith('/en/') || Astro.url.pathname.startsWith('/es/') ? `/${locale}` : '';

// 1. OBTENER RUTAS DINÁMICAS - Busca intro.mdx (no index.mdx)
export function getStaticPaths() {
  return getWikiCategories('es').map(({ category }) => ({ params: { category } }));
}

const category = Astro.props.category || Astro.params.category;

// 2. LEER LA INFO DE LA CATEGORÍA (intro.mdx)
const introEntry = getWikiIntro(locale, category);
const catInfo = introEntry?.module.frontmatter ?? {};
const categoryCopy = (dict.common.wiki.categories as any)[category];
const categoryTitle = categoryCopy?.title || catInfo.title || category;
const categoryDescription = categoryCopy?.description || catInfo.description || '';

// 3. LEER ARTÍCULOS DESDE articles/
const articles = getWikiArticles(locale, category).map(({ slug, module }) => ({
  ...(module.frontmatter ?? {}),
  slug,
  url: `${localizedPrefix}/wiki/${category}/articles/${slug}`,
}));
---

<Layout title={`${categoryTitle} | Wiki Builtechraft`} description={categoryDescription} lang={locale}>
  <main class="pt-32 pb-24 min-h-screen bg-theme-section">
    <div class="container mx-auto px-6 max-w-6xl">
      <a href={`${localizedPrefix}/wiki`} class="wiki-back mb-8">{dict.common.wiki.backToWiki}</a>

      <div class="flex items-center gap-4 mb-12">
        <span class="text-6xl">{catInfo.icon ?? '📂'}</span>
        <div>
          <h1 class={`text-4xl font-display font-bold uppercase tracking-tight ${catInfo.color ?? 'text-btc-orange'}`}>{categoryTitle}</h1>
          <p class="text-theme-muted text-lg mt-2">{categoryDescription}</p>
        </div>
      </div>

      {articles.length > 0 ? (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {articles.map((article: any) => (
            <a href={article.url} class={`card-retro ${article.border ?? 'hover:border-btc-orange'} group relative`}>
              {article.tag && <span class="badge-retro absolute top-4 right-4 text-btc-orange border-btc-orange/40">{article.tag}</span>}
              <span class="text-4xl mb-4 block">{article.icon ?? '📄'}</span>
              <h3 class={`text-lg font-display font-bold uppercase tracking-tight mb-2 ${article.color ?? 'text-btc-orange'} group-hover:underline`}>{article.title}</h3>
              <p class="text-theme-muted text-sm leading-relaxed">{article.description}</p>
            </a>
          ))}
        </div>
      ) : (
        <div class="text-center py-20 border border-dashed border-theme rounded-lg">
          <p class="text-theme-muted text-lg">{dict.common.wiki.noArticles}</p>
        </div>
      )}
    </div>
  </main>
  <DiscordBanner />
</Layout>