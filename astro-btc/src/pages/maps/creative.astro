---
import Layout from '../../layouts/Layout.astro';
import { SERVER_INFO } from '../../config-ip';

const mapUrl = SERVER_INFO.maps.creative;
---

<Layout title="Mapa Creativo - Builtechraft">
    <main class="pt-32 min-h-screen bg-creative-gradient flex flex-col">
        
        <div class="container mx-auto px-6 mb-8 text-center md:text-left">
            <h1 class="text-3xl font-display font-bold text-white uppercase tracking-tighter">
                Mapa 3D: <span class="text-blue-400">Creativo</span>
            </h1>
            <p class="text-zinc-400 text-sm">Visualiza los proyectos y diseños antes de que lleguen al Survival.</p>
        </div>

        <div class="flex-grow w-full h-[75vh] px-4 pb-12 max-w-7xl mx-auto">
            <div class="w-full h-full rounded-none overflow-hidden border border-white/10 shadow-2xl bg-black relative">
                
                <div id="map-status" class="absolute inset-0 z-20 flex flex-col items-center justify-center bg-zinc-900/95 backdrop-blur-sm transition-opacity duration-500">
                    
                    <div id="status-loading" class="flex flex-col items-center">
                        <div class="w-12 h-12 border-4 border-white/10 border-t-blue-400 rounded-full animate-spin mb-4"></div>
                        <p class="text-zinc-400 font-bold uppercase tracking-widest text-[10px] animate-pulse">Cargando visualizador 3D...</p>
                    </div>

                    <div id="status-error" class="hidden flex-col items-center text-center px-4">
                        <div class="w-20 h-20 bg-red-500/10 rounded-full flex items-center justify-center mb-6 border border-red-500/20">
                            <svg class="w-10 h-10 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                        </div>
                        <h2 class="text-2xl font-bold text-white mb-2 uppercase tracking-tight">Conexión Perdida</h2>
                        <p class="text-zinc-400 text-sm max-w-md mx-auto mb-8">El servidor creativo o el mapa web no responden en este momento. Es posible que esté en mantenimiento.</p>
                        <button onclick="window.location.reload()" class="px-6 py-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-xl text-white font-bold uppercase tracking-widest text-[10px] transition-all flex items-center gap-2 group">
                            <svg class="w-4 h-4 group-hover:-rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                            Reintentar Conexión
                        </button>
                    </div>
                </div>

                <iframe 
                    id="map-iframe"
                    src="" 
                    class="w-full h-full border-none bg-black opacity-0 transition-opacity duration-1000" 
                    title="BlueMap Creativo"
                    allowfullscreen
                ></iframe>
                
                <div class="absolute inset-0 pointer-events-none border border-white/5 rounded-none z-30"></div>
            </div>
        </div>
    </main>
</Layout>

<script is:inline define:vars={{ mapUrl }}>
  document.addEventListener('DOMContentLoaded', () => {
      const statusOverlay = document.getElementById('map-status');
      const stateLoading = document.getElementById('status-loading');
      const stateError = document.getElementById('status-error');
      const iframe = document.getElementById('map-iframe');

      const showError = () => {
          stateLoading.classList.add('hidden');
          stateError.classList.remove('hidden');
          stateError.classList.add('flex');
      };

      const showMap = () => {
          statusOverlay.classList.add('opacity-0');
          iframe.classList.remove('opacity-0');
          setTimeout(() => {
              statusOverlay.classList.add('hidden');
          }, 500); // Espera a que termine la transición de opacidad
      };

      // Establecemos un tiempo límite de 8 segundos.
      const controller = new AbortController();
      const timeoutId = setTimeout(() => controller.abort(), 8000);

      // Hacemos el ping preventivo
      fetch(mapUrl, { mode: 'no-cors', signal: controller.signal })
          .then(() => {
              clearTimeout(timeoutId);
              // El servidor vive. Inyectamos la URL.
              iframe.src = mapUrl;
              
              // Cuando cargue, revelamos el mapa
              iframe.onload = () => {
                  showMap();
              };

              // Respaldo por si el onload se traba
              setTimeout(showMap, 5000);
          })
          .catch(() => {
              // Error o Timeout -> Pantalla roja
              clearTimeout(timeoutId);
              showError();
          });
  });
</script>