---
// src/pages/instrucciones.astro
import Layout from '../layouts/Layout.astro';
import ConfigLoader from '../components/ip/ConfigLoader.astro';
import Steps from '../components/ip/Steps.astro';

const bgImage = "url('/images/gallery/2_4.avif')";
---

<Layout title="Play | Builtechraft" description="Guía paso a paso para conectarte al servidor.">
    
    <ConfigLoader />

    <main id="ingreso" class="pt-20 pb-0 min-h-screen bg-[#0a0a0c]">
        
        <!-- HERO CENTRALIZADO -->
        <section class="relative w-full py-24 md:py-32 overflow-hidden flex flex-col items-center justify-center text-center">
            <!-- Fondo -->
            <div class="absolute inset-0 z-0 bg-cover bg-center opacity-40" style={{ backgroundImage: bgImage }}></div>
            <div class="absolute inset-0 z-1 bg-gradient-to-b to-black/25"></div>

            <div class="container mx-auto px-6 max-w-4xl relative z-10">
                <h1 class="text-5xl md:text-7xl font-display font-bold text-white uppercase tracking-tight mb-6 drop-shadow-lg">
                    ¿Listo para <span class="text-btc-orange">jugar?</span>
                </h1>
                <p class="text-zinc-300 text-lg md:text-xl leading-relaxed mb-8 font-medium">
                    Sigue las instrucciones detalladas para unirte a Builtechraft. Configura tu cliente, revisa los requisitos y sumérgete en el servidor.
                    <br><span class="text-btc-yellow font-bold mt-2 inline-block">¡Te esperamos!</span>
                </p>
            </div>
        </section>

        <!-- REQUISITOS DE CUENTA Y VERSIÓN -->
        <section class="bg-[#111] py-16 border-y border-white/5 relative z-10">
            <div class="container mx-auto px-6 max-w-5xl">
                <h2 class="text-3xl font-display font-bold text-white text-center mb-12 uppercase tracking-tight">Requisitos Mínimos</h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-center md:text-left divide-y md:divide-y-0 md:divide-x divide-white/10">
                    <!-- Req 1: Versión -->
                    <div class="flex flex-col md:flex-row items-center md:items-start gap-6 md:pr-12 pt-6 md:pt-0">
                        <div class="w-14 h-14 shrink-0 bg-green-500/10 text-green-500 rounded-full flex items-center justify-center border border-green-500/20">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2 uppercase">Versión del Juego</h3>
                            <p class="text-zinc-400 text-sm leading-relaxed">Asegúrate de entrar con <strong id="req-version-text" class="text-white">Minecraft 1.21.x</strong>. El servidor está siempre actualizado a las últimas versiones estables.</p>
                        </div>
                    </div>
                    
                    <!-- Req 2: Cuentas Ely.by / Premium -->
                    <div class="flex flex-col md:flex-row items-center md:items-start gap-6 md:pl-12 pt-12 md:pt-0">
                        <div class="w-14 h-14 shrink-0 bg-blue-500/10 text-blue-500 rounded-full flex items-center justify-center border border-blue-500/20">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                        </div>
                        <div>
                            <h3 class="text-xl font-bold text-white mb-2 uppercase">Cuenta de Minecraft</h3>
                            <p class="text-zinc-400 text-sm leading-relaxed">Necesitas una cuenta <strong>Premium</strong> oficial, o bien utilizar una cuenta gratuita vinculada a <strong class="text-white">Ely.by</strong> si no cuentas con una.</p>
                        </div>
                    </div>
                </div>
            </div>
        </section>

        <!-- SECCIÓN DE IP E INSTRUCCIONES DINÁMICAS -->
        <Steps />
    </main>
</Layout>

<script is:inline>
    // Actualizamos el texto de la versión en los requisitos según el ConfigLoader
    window.addEventListener('btc:config-loaded', (e) => {
        document.getElementById('req-version-text').innerText = `Minecraft ${e.detail["JavaMax"] || 'Actual'}`;
    });
</script>