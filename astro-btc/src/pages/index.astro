---
import Layout from '../layouts/Layout.astro';
import ConfigLoader from '../components/ip/ConfigLoader.astro';
import Hero from '../components/home/HeroO.astro';
import StatsRow from '../components/home/StatsRow.astro';
import WelcomeSection from '../components/home/WelcomeSection.astro';
import CategoryCards from '../components/home/CategoryCards.astro';
import HowToSection from '../components/ip/HowToSection.astro';
import VisionBanner from '../components/about/VisionBanner.astro';
import WorldsGrid from '../components/about/WorldsGrid.astro';
import ModsAndDatapacks from '../components/about/ModsAndDatapacks.astro';
import Staff from '../components/about/Staff.astro';
import Roadmap from '../components/about/Roadmap.astro'; // Ajusta la ruta si es necesario
import ComparisonCards from '../components/about/ComparisonCards.astro';
import Modpack from '../components/about/Modpack.astro';
import DonateBanner from '../components/donation/DonationMini.astro';
import DiscordBanner from '../components/discord/DiscordBanner.astro';
---

<Layout title="Inicio | Builtechraft" description="Servidor privado de Minecraft semi-vanilla enfocado en construcción, ingeniería y comunidad.">
  <main class="min-h-screen bg-theme-app text-theme-main">
    
    <Hero />
    <VisionBanner />
    <WelcomeSection />
    <CategoryCards />
    <WorldsGrid />

    <!-- Mods y Comparativa -->
    <section id="mods" class="container mx-auto px-6 max-w-7xl py-16">
      <div class="text-center mb-10 mt-16">
        <span class="px-4 py-1.5 rounded-full border border-btc-orange/30 bg-btc-orange/10 text-btc-orange text-[10px] font-bold uppercase tracking-[0.2em] mb-3 inline-block">
          La gran pregunta
        </span>
        <h3 class="text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-theme-main">
          ¿Mods, Plugins o <span class="text-btc-orange">Datapacks</span>?
        </h3>
        <p class="text-theme-muted mt-3 max-w-2xl mx-auto leading-relaxed">
          Tres formas de modificar Minecraft, tres filosofías muy distintas.
          Probamos las tres durante años y aquí te contamos por qué elegimos el camino más fiel al juego original.
        </p>
      </div>
      <ComparisonCards />

      <div class="text-center mb-12 mt-16">
        <span class="px-4 py-1.5 rounded-full border border-blue-500/30 bg-blue-500/10 text-blue-400 text-[10px] font-bold uppercase tracking-[0.2em] mb-3 inline-block">
          Mods & Datapacks
        </span>
        <h2 class="text-4xl font-display font-bold uppercase tracking-tight text-theme-main">
          Las mejoras del <span class="text-blue-400">servidor</span>
        </h2>
        <p class="text-theme-muted mt-3 max-w-2xl mx-auto leading-relaxed">
          Utilizamos una selección de mods y datapacks centrados en el rendimiento, la calidad de vida y las herramientas de construcción.
        </p>
      </div>
      <ModsAndDatapacks />
    </section>

    <!-- Modpack -->
    <section id="modpack">
      <Modpack />
    </section>

    <!-- 1. STAFF (Arriba de todo en este bloque final) -->
    <section id="staff" class="py-16">
      <Staff />
    </section>

    <!-- 2. ROADMAP (Arriba de HowTo) -->
    <section class="container mx-auto px-6 max-w-6xl py-24">
      <div class="text-center mb-12">
        <span class="px-4 py-1.5 rounded-full border border-btc-orange/30 bg-btc-orange/10 text-btc-orange text-[10px] font-bold uppercase tracking-[0.2em] mb-3 inline-block">
          Roadmap
        </span>
        <h2 class="text-4xl font-display font-bold uppercase tracking-tight text-theme-main">
          Lo que <span class="text-btc-orange">estamos preparando</span>
        </h2>
        <p class="text-theme-muted mt-3 max-w-2xl mx-auto leading-relaxed">
          Consulta nuestras futuras expansiones, mantenimientos planeados y actualizaciones del servidor.
        </p>
      </div>
      <!-- El componente Roadmap se renderiza aquí -->
      <Roadmap />
    </section>

    <!-- 3. HOW TO SECTION (Arriba de los banners) -->
    <HowToSection />

    <!-- 4. BANNERS DE COMUNIDAD (Antes del footer) -->
    <DiscordBanner />

    <!-- 5. CONFIG LOADER / FOOTER -->
    <ConfigLoader />
    
  </main>
</Layout>