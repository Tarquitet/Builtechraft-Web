---
// src/pages/index.astro
import Layout from '../layouts/Layout.astro';
import ConfigLoader from '../components/ip/ConfigLoader.astro';
import WelcomeSection from '../components/home/WelcomeSection.astro';
import HowToSection from '../components/ip/HowToSection.astro';
import CategoryCards from '../components/home/CategoryCards.astro';

const bgImage = "url('/images/gallery/2_1.avif')";
---

<Layout title="Home | Builtechraft SMP" description="Servidor Semi-Vanilla enfocado en la creatividad y la ingeniería." image="/images/logo-text.webp">
    <ConfigLoader />
    
    <!-- 1. HERO SECTION (INTACTO) -->
    <section id="inicio" class="w-full min-h-screen flex flex-col justify-center items-center relative bg-[#111] pt-24 pb-16">
        <div class="absolute inset-0 z-0 bg-cover bg-center" style={{ backgroundImage: bgImage }}></div>
        <div class="absolute inset-0 z-1 bg-black/20"></div>
        <div class="relative z-10 flex flex-col items-center px-6 max-w-4xl text-center mt-8">
            <img src="/images/logo-text.webp" alt="Builtechraft" class="w-full max-w-lg mb-8 drop-shadow-2xl" />
            
            <p class="text-zinc-200 text-sm md:text-base leading-relaxed mb-12 max-w-2xl font-medium">
                Survival privado inspirado en <strong>Minecraft Vanilla</strong>, con Fabric, datapacks y mods cuidadosamente seleccionados para construir un mundo épico.
            </p>
            
            <!-- PANEL DE CONEXIÓN -->
            <div class="bg-black/60 backdrop-blur-md border border-white/10 rounded-2xl p-6 w-full max-w-xl shadow-2xl relative">
                <div class="flex flex-col sm:flex-row items-center justify-between gap-4 py-2">
                    <div class="flex flex-col text-center sm:text-left w-full">
                        <span class="text-[10px] uppercase tracking-widest text-zinc-500 font-bold mb-1">Dirección IP (Java)</span>
                        <code id="hero-ip-address" class="text-xl md:text-2xl text-white font-mono font-bold select-all truncate">Consultando...</code>
                    </div>
                    
                    <button id="hero-copy-btn" class="shrink-0 bg-btc-orange hover:bg-white hover:text-btc-orange text-white px-6 py-3 rounded-xl font-bold uppercase text-xs tracking-widest transition-all w-full sm:w-auto">
                        Copiar IP
                    </button>
                </div>

                <!-- Footer del Panel -->
                <div class="flex flex-col sm:flex-row justify-between items-center gap-2 mt-4 pt-4 border-t border-white/5">
                    <span id="hero-version-display" class="text-[10px] text-zinc-500 uppercase tracking-widest font-bold">Consultando versión...</span>
                    
                    <div class="flex items-center gap-4">
                        <a id="hero-bedrock-link" href="#ingreso" class="items-center gap-1 text-[10px] text-blue-400 hover:text-blue-300 uppercase tracking-widest font-bold transition-colors" style="display: none;">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                            Bedrock
                        </a>
                        
                        <a href="#ingreso" class="text-[10px] text-btc-orange hover:text-white uppercase tracking-widest font-bold transition-colors underline underline-offset-4 decoration-btc-orange/30">
                             ¿Cómo ingresar?
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- 2. NUEVA BIENVENIDA -->
    <WelcomeSection />

    <!-- 4. TARJETAS DE CATEGORÍAS -->
    <CategoryCards />

    <!-- 3. SECCIÓN DE INGRESO -->
    <HowToSection />

</Layout>

<script is:inline>
    window.addEventListener('btc:config-loaded', (e) => {
        const data = e.detail;
        const ipEl = document.getElementById('hero-ip-address');
        const versionEl = document.getElementById('hero-version-display');
        
        if (ipEl) ipEl.innerText = data.JavaIP || 'Consultando...';
        
        if (versionEl) {
            if (data.isMultiVersion) {
                versionEl.innerText = `Java: ${data.JavaMin} - ${data.JavaMax}`;
            } else {
                versionEl.innerText = `Java: ${data.JavaMax || '1.21.x'}`;
            }
        }

        if (data.isBedrock) {
            const bedrockLink = document.getElementById('hero-bedrock-link');
            if (bedrockLink) bedrockLink.style.display = 'flex';
        }
    });

    document.getElementById('hero-copy-btn')?.addEventListener('click', async () => {
        const ipEl = document.getElementById('hero-ip-address');
        if (!ipEl) return;
        
        await navigator.clipboard.writeText(ipEl.innerText);
        const btn = document.getElementById('hero-copy-btn');
        const originalText = btn.innerText;
        
        btn.innerText = '¡COPIADO!';
        btn.classList.add('bg-green-500', 'text-white');
        btn.classList.remove('bg-btc-orange', 'hover:bg-white', 'hover:text-btc-orange');
        
        setTimeout(() => {
            btn.innerText = originalText;
            btn.classList.remove('bg-green-500', 'text-white');
            btn.classList.add('bg-btc-orange', 'hover:bg-white', 'hover:text-btc-orange');
        }, 2000);
    });
</script>