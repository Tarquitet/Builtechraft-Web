---
// src/pages/nosotros.astro
import Layout from '../layouts/Layout.astro';
import VisionBanner from '../components/about/VisionBanner.astro';
import WorldsGrid from '../components/about/WorldsGrid.astro';
import ModsAndDatapacks from '../components/wiki/ModsAndDatapacks.astro';
import Staff from '../components/wiki/Staff.astro';
import Roadmap from '../components/wiki/Roadmap.astro';
---

<Layout title="About | Builtechraft SMP" description="Conoce nuestra visión, historia, características técnicas, equipo y roadmap.">
    <main class="min-h-screen bg-[#0a0a0c] text-white">
        
        <!-- 1. Banner Superior de Visión -->
        <VisionBanner />

        <!-- 2. Cuadrícula de Mundos -->
        <WorldsGrid />

        <!-- 4. Mods y Datapacks -->
        <section id="mods" class="container mx-auto px-6 max-w-5xl py-16 border-t border-white/5">
            <div class="text-center mb-12">
                <span class="px-4 py-1.5 rounded-full border border-blue-500/30 bg-blue-500/10 text-blue-400 text-[10px] font-bold uppercase tracking-[0.2em] mb-3 inline-block">
                    Transparencia Técnica
                </span>
                <h2 class="text-4xl font-display font-bold uppercase tracking-tight text-white">
                    Base de Datos de <span class="text-blue-400">Mods & Datapacks</span>
                </h2>
                <p class="text-zinc-400 mt-2 text-sm">Control en tiempo real de las modificaciones activas en el servidor.</p>
            </div>
            
            <ModsAndDatapacks />
        </section>

        <!-- 5. Staff -->
        <div id="staff">
            <Staff />
        </div>

        <!-- 6. Roadmap -->
        <section class="container mx-auto px-6 max-w-6xl py-24">
            <div class="text-center mb-12">
                <h2 class="text-4xl font-display font-bold uppercase tracking-tight text-white">
                    Planes y <span class="text-btc-orange">Roadmap</span>
                </h2>
                <p class="text-zinc-400 mt-2 text-sm">Nuestras próximas expansiones y objetivos técnicos.</p>
            </div>
            <Roadmap />
        </section>

    </main>
</Layout>