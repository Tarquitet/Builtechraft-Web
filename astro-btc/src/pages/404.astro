---
// src/pages/404.astro
import Layout from '../layouts/Layout.astro';
import links from '../data/links.json';
import { getDictionary, getLocaleFromPath, localizePath } from '../lib/i18n';

const dict = getDictionary(getLocaleFromPath(Astro.url.pathname));
---

<Layout
    title={`404 – ${dict.common.notFound.title} | Builtechraft`}
    description={dict.common.notFound.description}
>
    <style>
        @keyframes fox-float {
            0%, 100% { transform: translateY(0) rotate(-3deg); }
            50% { transform: translateY(-14px) rotate(3deg); }
        }
        .fox-float { animation: fox-float 3.2s ease-in-out infinite; }
    </style>

    <main class="min-h-screen bg-theme-app flex flex-col items-center justify-center text-center px-6 pt-32 pb-24 relative overflow-hidden">

        {/* BLOQUES PERDIDOS FLOTANDO EN EL VACÍO */}
        <div class="absolute inset-0 pointer-events-none select-none" aria-hidden="true">
            <span class="absolute top-[16%] left-[10%] text-3xl opacity-10 rotate-12">🌳</span>
            <span class="absolute top-[28%] right-[14%] text-4xl opacity-10 -rotate-12">⛏️</span>
            <span class="absolute bottom-[24%] left-[16%] text-4xl opacity-10 rotate-6">💎</span>
            <span class="absolute bottom-[32%] right-[10%] text-3xl opacity-10 -rotate-6">🐷</span>
            <span class="absolute top-[10%] right-[38%] text-2xl opacity-10 rotate-45">🧱</span>
            <span class="absolute top-[45%] left-[6%] text-2xl opacity-10 -rotate-12">🔥</span>
        </div>

        {/* PANTALLA ESTILO F3 DE MINECRAFT */}
        <div class="relative z-10 font-mono text-[11px] md:text-xs text-theme-muted bg-theme-alternate border-theme-1 rounded-lg px-4 py-2 mb-10">
            <span class="text-btc-yellow font-bold">[F3]</span>
            <span class="mx-2">XYZ: 404 / 64 / -1</span>·
            <span class="mx-2">Chunk: NOT_FOUND</span>·
            <span class="mx-2">{dict.common.notFound.biome}</span>
        </div>

        <span class="fox-float relative z-10 text-7xl md:text-8xl mb-6 inline-block select-none">🦊</span>

        <h1 class="relative z-10 font-display font-bold text-7xl md:text-9xl uppercase tracking-tight text-theme-main mb-2">
            4<span class="text-btc-orange">0</span>4
        </h1>

        <h2 class="relative z-10 font-display font-bold text-2xl md:text-3xl uppercase tracking-tight text-theme-main mb-4">
            {dict.common.notFound.title}
        </h2>

        <p class="relative z-10 text-theme-muted max-w-md leading-relaxed mb-10">
            {dict.common.notFound.description}
        </p>

        <div class="relative z-10 flex flex-col sm:flex-row gap-4 w-full sm:w-auto justify-center">
            <a
                href={localizePath(links.pages.inicio, getLocaleFromPath(Astro.url.pathname))}
                class="bg-btc-orange hover:bg-orange-500 text-white font-bold uppercase text-xs tracking-widest px-8 py-4 rounded-lg border-b-4 border-orange-800 active:translate-y-1 transition-all"
            >
                {dict.common.notFound.home}
            </a>
            <a
                href={localizePath(links.pages.wiki, getLocaleFromPath(Astro.url.pathname))}
                class="bg-theme-card border-theme-1 hover:border-btc-orange/40 text-theme-main font-bold uppercase text-xs tracking-widest px-8 py-4 rounded-lg transition-all"
            >
                {dict.common.notFound.exploreWiki}
            </a>
            <a
                href={links.social.discord}
                target="_blank"
                rel="noopener noreferrer"
                class="bg-[#5865F2]/10 hover:bg-[#5865F2] text-[#5865F2] hover:text-white border border-[#5865F2]/30 font-bold uppercase text-xs tracking-widest px-8 py-4 rounded-lg transition-all"
            >
                Discord
            </a>
        </div>

        <p class="relative z-10 mt-10 text-xs text-theme-muted opacity-70">
            {dict.common.notFound.report}
        </p>

    </main>
</Layout>