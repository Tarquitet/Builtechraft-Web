---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Página no encontrada | Builtechraft">
    <section class="min-h-[70vh] flex items-center justify-center bg-[#18181b] relative overflow-hidden px-6">
        <div class="text-center relative z-10">
            <h1 class="text-8xl md:text-9xl font-display font-black text-transparent bg-clip-text bg-linear-to-b from-btc-orange to-red-600 mb-4 drop-shadow-lg">
                404
            </h1>
            <h2 class="text-2xl md:text-3xl font-bold text-white uppercase tracking-widest mb-6">
                Te has caído del mundo
            </h2>
            <p class="text-zinc-400 mb-10 max-w-md mx-auto text-lg">
                La página que estás buscando fue destruida por un Creeper o nunca existió.
            </p>
            <a href="/" class="inline-flex items-center gap-2 bg-btc-orange text-white font-bold py-3 px-8 rounded-xl hover:bg-white hover:text-btc-orange transition-all uppercase tracking-widest shadow-lg shadow-btc-orange/20">
                Volver al Spawn
            </a>
        </div>
    </section>
</Layout>