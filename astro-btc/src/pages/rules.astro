---
// src/rules.astro
import Layout from '../layouts/Layout.astro';
import Rules from '../components/rules/Rules.astro';
import { getDictionary, getLocaleFromPath } from '../lib/i18n';

const dict = getDictionary(getLocaleFromPath(Astro.url.pathname));
---

<Layout title={`${dict.common.rules.title} | Builtechcraft`} description={dict.common.rules.description}>
    <main class="pt-24 min-h-screen bg-theme-panel">
        <Rules />
    </main>
</Layout>