---
import WikiArticlePage from '../../../../../components/wiki/WikiArticlePage.astro';
import { getWikiArticlePaths } from '../../../../../lib/wikiContent';
import type { Locale } from '../../../../../lib/i18n';

export function getStaticPaths() {
  return (['es', 'en'] as Locale[]).flatMap((lang) =>
    getWikiArticlePaths(lang).map(({ category, slug, entry }) => ({
      params: { lang, category, slug },
      props: { entry },
    })),
  );
}
---

<WikiArticlePage entry={Astro.props.entry} />
