---
import WikiArticlePage from '../../../../../components/wiki/WikiArticlePage.astro';
import { getWikiArticlePaths } from '../../../../../lib/wikiContent';

export function getStaticPaths() {
  const esPaths = getWikiArticlePaths('es').map(({ category, slug, entry }) => ({
    params: { lang: 'es', category, slug },
    props: { entry },
  }));
  
  const enPaths = getWikiArticlePaths('en').map(({ category, slug, entry }) => ({
    params: { lang: 'en', category, slug },
    props: { entry },
  }));

  return [...esPaths, ...enPaths];
}

const { lang, category, slug } = Astro.params;
const entry = Astro.props.entry;
---

<WikiArticlePage entry={entry} />