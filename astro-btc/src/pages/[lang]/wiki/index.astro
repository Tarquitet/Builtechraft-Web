---
import Layout from '../../../layouts/Layout.astro';
import WikiPortal from '../../../components/wiki/WikiPortal.astro';
import { getLocaleFromPath, getDictionary } from '../../../lib/i18n';

export function getStaticPaths() {
  return [
    { params: { lang: 'es' } },
    { params: { lang: 'en' } }
  ];
}

const locale = Astro.params.lang as 'es' | 'en';
const dict = getDictionary(locale);
---

<Layout title={`Wiki | Builtechraft`} description={dict.common.wiki.portalDescription} lang={locale}>
  <WikiPortal locale={locale} />
</Layout>