---
import '../styles/global.css';
import Navbar from '../components/navbar/Navbar.astro';
import NavbarMobile from '../components/navbar/NavbarMobile.astro';
import Footer from '../components/Footer.astro';

interface Props {
    title: string;
    description?: string;
    image?: string;
    canonicalURL?: URL | string;
}

const { 
    title, 
    description = "Builtechraft SMP - Mundo survival con el objetivo de construir y explorar el potencial de los datapacks y mods de optimización.",
    image = "/images/logo-text.webp",
} = Astro.props;

// Construimos la URL canónica automáticamente basada en la página actual
const canonicalURL = Astro.props.canonicalURL || new URL(Astro.url.pathname, Astro.site);
// Resolvemos la URL de la imagen para que siempre sea absoluta (necesario para Discord/Twitter)
const socialImageURL = new URL(image, Astro.url);
---

<!doctype html>
<html lang="es" class="scroll-smooth">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>{title}</title>
        
        <meta name="description" content={description} />
        <meta name="keywords" content="Minecraft, Servidor Minecraft, Técnico, Creativo, Builtechraft, Fabric, SMP, Colombia, Español, Modrinth, Modpack" />
        <meta name="author" content="Tarquitet" />
        <link rel="canonical" href={canonicalURL} />
        
        <meta property="og:type" content="website" />
        <meta property="og:url" content={canonicalURL} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={socialImageURL} />
        <meta name="theme-color" content="#f97316" /> <meta property="twitter:card" content="summary_large_image" />
        <meta property="twitter:url" content={canonicalURL} />
        <meta property="twitter:title" content={title} />
        <meta property="twitter:description" content={description} />
        <meta property="twitter:image" content={socialImageURL} />

        <link rel="icon" type="image/png" href="/images/favicon.png" />
        <link rel="apple-touch-icon" href="/images/favicon.png" />
        <link rel="preconnect" href="https://fonts.googleapis.com">
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
        <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
        <meta name="generator" content={Astro.generator} />

        <script type="application/ld+json" set:html={JSON.stringify({
            "@context": "https://schema.org",
            "@type": "VideoGame",
            "name": "Builtechraft SMP",
            "description": description,
            "playMode": "MultiPlayer",
            "applicationCategory": "GameServer",
            "url": Astro.site
        })} />
    </head>

    <body class="bg-btc-dark text-white font-sans antialiased selection:bg-btc-orange selection:text-white flex flex-col min-h-screen">
        

        <Navbar/>
        <NavbarMobile />

        <main class="grow">
            <slot />
        </main>

        <Footer />

    <script>
  document.addEventListener('DOMContentLoaded', () => {
    const heroSection = document.getElementById('inicio');
    const heroNavbar = document.getElementById('hero-navbar-wrapper');
    
    if (!heroSection || !heroNavbar) return;
    
    // Optimización: Usamos requestAnimationFrame para evitar "layout thrashing"
    let ticking = false;
    
    const handleScroll = () => {
      if (!ticking) {
        window.requestAnimationFrame(() => {
          const triggerHeight = heroSection.offsetHeight - 200;
          const currentScroll = window.scrollY;
          
          if (currentScroll > triggerHeight) {
            heroNavbar.style.opacity = '0';
            heroNavbar.style.pointerEvents = 'none';
          } else {
            heroNavbar.style.opacity = '1';
            heroNavbar.style.pointerEvents = 'auto';
          }
          ticking = false; // Liberamos el bloqueo para el siguiente frame
        });
        ticking = true; // Bloqueamos hasta que se complete el frame
      }
    };
    
    window.addEventListener('scroll', handleScroll, { passive: true });
    
    // Ejecutamos una vez al inicio para establecer el estado correcto
    handleScroll();
  });
</script>

<!-- SCRIPT GLOBAL PARA ACTUALIZAR ENLACES DINÁMICOS -->
        <script is:inline>
            document.addEventListener('DOMContentLoaded', () => {
                const updateDynamicLinks = (data) => {
                    if (!data) return;
                    
                    // Función auxiliar para actualizar grupos de enlaces por data-target
                    const setLinksByTarget = (targetName, url) => {
                        if (url && url !== '#') {
                            document.querySelectorAll(`a[data-target="${targetName}"]`).forEach(link => {
                                link.href = url;
                                link.target = "_blank";
                            });
                        }
                    };

                    // 1. Wiki, Mapas y Discord
                    setLinksByTarget('wiki', data.WikiURL);
                    setLinksByTarget('drop-map-sv', data.MapaSurvival);
                    setLinksByTarget('drop-map-cr', data.MapaCreativo);
                    setLinksByTarget('discord', data.DiscordURL);
                    setLinksByTarget('donacion', data.DonacionURL);
                };

                // Leer de caché primero para velocidad instantánea
                const cachedConfig = sessionStorage.getItem('btc_config');
                if (cachedConfig) {
                    try {
                        updateDynamicLinks(JSON.parse(cachedConfig));
                    } catch (e) {}
                }

                // Escuchar el evento oficial del ConfigLoader
                window.addEventListener('btc:config-loaded', (e) => {
                    updateDynamicLinks(e.detail);
                });
            });
        </script>
    </body>
</html>