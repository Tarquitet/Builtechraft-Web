---
// src/components/NavbarMobile.astro
import navData from '../../data/navigation.json';

const leftItems = navData.left;
const rightItems = navData.right;
const novedadItems = navData.novedades;

const isMapPage = Astro.url.pathname.includes('/maps/');
---

<header 
  id="mobile-header" 
  class:list={[
    "lg:hidden fixed top-0 w-full z-50 transition-all duration-500 border-b",
    isMapPage 
      ? "is-scrolled bg-black py-2 border-white/5 shadow-2xl" 
      : "is-at-top bg-transparent py-4 border-transparent"
  ]}
>
  <div class="container mx-auto px-6 h-12 relative flex items-center justify-between">

    {/* BOTÓN HAMBURGUESA (Izquierda) */}
    <button 
        id="mobile-menu-btn" 
        class="text-zinc-400 hover:text-white p-2 rounded-lg transition-colors focus:outline-none z-50"
        aria-label="Abrir menú"
    >
        <svg id="icon-menu" class="h-7 w-7 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" class="h-7 w-7 hidden transition-transform duration-300 scale-50 opacity-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>

    {/* BOTÓN INTERRUPTOR DE TEMA (Derecha) */}
    <div class="z-50">
        <button 
            id="mobile-theme-toggle"
            class="w-10 h-10 rounded-full border transition-all duration-300 flex items-center justify-center"
            aria-label="Cambiar tema"
        >
            <svg id="mobile-icon-moon" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            <svg id="mobile-icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
    </div>
  </div>

  {/* MENÚ DESPLEGABLE MÓVIL */}
  <nav 
    id="mobile-dropdown" 
    class="absolute top-full left-0 w-full bg-black/98 backdrop-blur-xl border-b border-white/10 transition-all duration-300 origin-top transform scale-y-0 opacity-0 pointer-events-none shadow-2xl"
  >
    <div class="flex flex-col items-center py-8 px-6 gap-6 max-h-[80vh] overflow-y-auto">
        
        {/* BLOQUE 1: Inicio y Links Izquierdos */}
        <div class="flex flex-col items-center gap-6 w-full">
            <a href="/#inicio" class="mobile-nav-link text-base font-bold uppercase tracking-widest transition-all relative group py-2" data-target="inicio">
                Inicio
                <span class="absolute bottom-0 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full nav-line"></span>
            </a>
            {leftItems.map(item => (
                <a href={item.href} class="mobile-nav-link text-base font-bold uppercase tracking-widest transition-all relative group py-2" data-target={item.id}>
                    {item.name}
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full nav-line"></span>
                </a>
            ))}
        </div>

        {/* BLOQUE 2: Novedades y Mapas (Destacado) */}
        <div class="w-full border-t border-white/10 pt-6 pb-2 flex flex-col items-center">
            <p class="text-[10px] font-black uppercase tracking-[0.3em] text-zinc-500 mb-4">Novedades y Mapas</p>
            <div class="flex flex-col gap-2 w-full max-w-62.5">
                {novedadItems.map(item => (
                    <a href={item.href} class="mobile-submenu-link text-xs font-bold text-zinc-400 uppercase tracking-widest py-3 px-6 rounded-lg hover:bg-white/5 hover:text-btc-orange transition-all text-center w-full" data-target={item.id}>
                        {item.name}
                    </a>
                ))}
            </div>
        </div>

        {/* BLOQUE 3: Links Derechos */}
        <div class="flex flex-col items-center gap-6 w-full border-t border-white/10 pt-6">
            {rightItems.map(item => (
                <a href={item.href} class="mobile-nav-link text-base font-bold uppercase tracking-widest transition-all relative group py-2" data-target={item.id}>
                    {item.name}
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full nav-line"></span>
                </a>
            ))}
        </div>
    </div>
  </nav>
</header>

<style>
  /* --- ESTILO DEL BOTÓN DE TEMA MÓVIL --- */
  #mobile-header.is-at-top #mobile-theme-toggle { background-color: rgba(0, 0, 0, 0.4); border-color: rgba(255, 255, 255, 0.1); color: #a1a1aa; backdrop-filter: none; -webkit-backdrop-filter: none; }
  #mobile-header.is-at-top #mobile-theme-toggle:hover { background-color: rgba(0, 0, 0, 0.6); color: #f97316; border-color: rgba(249, 115, 22, 0.3); }
  #mobile-header.is-scrolled #mobile-theme-toggle { background-color: rgba(255, 255, 255, 0.05); border-color: rgba(255, 255, 255, 0.1); color: #a1a1aa; }
  #mobile-header.is-scrolled #mobile-theme-toggle:hover { background-color: rgba(255, 255, 255, 0.1); color: #f97316; }

  /* --- COLORES DE LOS LINKS MÓVILES --- */
  .mobile-nav-link { color: rgba(255, 255, 255, 0.8); }
  .mobile-nav-link:hover { color: #f97316; }
  .mobile-nav-link .nav-line { background-color: #f97316 !important; }

  /* Estados activos */
  .mobile-nav-link.active { color: #fbbf24 !important; }
  .mobile-nav-link.active .nav-line { width: 100% !important; background-color: #fbbf24 !important; }
  
  .mobile-submenu-link.active-sub { color: #f97316 !important; background-color: rgba(255,255,255,0.05); }
</style>

<script is:inline define:vars={{ isMapPage }}>
  document.addEventListener('DOMContentLoaded', () => {
      const headerMobile = document.getElementById('mobile-header');
      const mobileBtn = document.getElementById('mobile-menu-btn');
      const mobileDropdown = document.getElementById('mobile-dropdown');
      const iconMenu = document.getElementById('icon-menu');
      const iconClose = document.getElementById('icon-close');
      const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
      const mobileSubLinks = document.querySelectorAll('.mobile-submenu-link');
      const heroSection = document.getElementById('inicio');
      const sections = document.querySelectorAll('section[id], div[id]');
      
      const themeToggleBtnMobile = document.getElementById('mobile-theme-toggle');
      const htmlEl = document.documentElement;

      // --- LOGICA TEMA ---
      const updateThemeIconsMobile = () => {
          const iconMoonMobile = document.getElementById('mobile-icon-moon');
          const iconSunMobile = document.getElementById('mobile-icon-sun');
          if (htmlEl.classList.contains('light')) {
              iconMoonMobile.classList.add('hidden'); iconSunMobile.classList.remove('hidden');
          } else {
              iconMoonMobile.classList.remove('hidden'); iconSunMobile.classList.add('hidden');
          }
      };
      updateThemeIconsMobile();
      themeToggleBtnMobile.addEventListener('click', () => {
          htmlEl.classList.toggle('light');
          updateThemeIconsMobile();
          localStorage.setItem('theme', htmlEl.classList.contains('light') ? 'light' : 'dark');
          window.dispatchEvent(new Event('theme-changed'));
      });
      window.addEventListener('theme-changed', updateThemeIconsMobile);

      // --- LOGICA MENU DESPLEGABLE ---
      const toggleMenu = () => {
          const isClosed = mobileDropdown.classList.contains('scale-y-0');
          if (isClosed) {
              mobileDropdown.classList.remove('scale-y-0', 'opacity-0', 'pointer-events-none');
              mobileDropdown.classList.add('scale-y-100', 'opacity-100', 'pointer-events-auto');
              iconMenu.classList.add('hidden', 'scale-50', 'opacity-0');
              iconMenu.classList.remove('block');
              iconClose.classList.remove('hidden', 'scale-50', 'opacity-0');
              iconClose.classList.add('block');
              headerMobile.classList.add('bg-black/98', 'backdrop-blur-md'); // Fondo solido al abrir
          } else {
              mobileDropdown.classList.add('scale-y-0', 'opacity-0', 'pointer-events-none');
              mobileDropdown.classList.remove('scale-y-100', 'opacity-100', 'pointer-events-auto');
              iconMenu.classList.remove('hidden', 'scale-50', 'opacity-0');
              iconMenu.classList.add('block');
              iconClose.classList.add('hidden', 'scale-50', 'opacity-0');
              iconClose.classList.remove('block');
              handleMobileHeaderAnimation(); // Restaura el color segun el scroll
          }
      };

      mobileBtn.addEventListener('click', toggleMenu);

      // Cierra el menú al hacer click en cualquier enlace
      const allLinks = [...mobileNavLinks, ...mobileSubLinks];
      allLinks.forEach(link => {
          link.addEventListener('click', () => {
              if (!mobileDropdown.classList.contains('scale-y-0')) toggleMenu();
          });
      });

      // --- ILUMINACION EN MAPAS ---
      if (isMapPage) {
          const currentPath = window.location.pathname;
          mobileSubLinks.forEach(link => {
              const href = link.getAttribute('href');
              if (currentPath === href || currentPath === href + '/') {
                  link.classList.add('active-sub');
              }
          });
      }

      // --- ANIMACION HEADER ---
      const handleMobileHeaderAnimation = () => {
          if (isMapPage) return; // En mapa siempre negro solido
          // Si el menu esta abierto, no quitamos el fondo negro
          if (!mobileDropdown.classList.contains('scale-y-0')) return; 

          const currentScroll = window.scrollY;
          const triggerHeight = heroSection ? (heroSection.offsetHeight - 150) : 100;

          if (currentScroll > triggerHeight) {
              headerMobile.classList.replace('is-at-top', 'is-scrolled');
              headerMobile.classList.remove('bg-transparent', 'py-4', 'border-transparent');
              headerMobile.classList.add('bg-black', 'py-2', 'border-white/5', 'shadow-2xl');
          } else {
              headerMobile.classList.replace('is-scrolled', 'is-at-top');
              headerMobile.classList.add('bg-transparent', 'py-4', 'border-transparent');
              headerMobile.classList.remove('bg-black', 'py-2', 'border-white/5', 'shadow-2xl');
          }
      };

      // --- SCROLL SPY CORREGIDO ---
      const handleMobileScrollSpy = () => {
          if (isMapPage) return;
          let maxVisibleSectionId = '';
          let maxVisibleHeight = 0;
          
          if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 50) {
              const lastLink = mobileNavLinks[mobileNavLinks.length - 1];
              if (lastLink) {
                  mobileNavLinks.forEach(link => link.classList.remove('active'));
                  lastLink.classList.add('active');
                  return;
              }
          }
          
          sections.forEach(section => {
              if (section.id === 'novedades') return; // Ignora el contenedor global

              const rect = section.getBoundingClientRect();
              const visibleHeight = Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0);
              if (visibleHeight > 0 && visibleHeight > maxVisibleHeight) {
                  maxVisibleHeight = visibleHeight;
                  maxVisibleSectionId = section.getAttribute('id');
              }
          });
          
          if (maxVisibleSectionId) {
              mobileNavLinks.forEach(link => {
                  link.classList.toggle('active', link.getAttribute('data-target') === maxVisibleSectionId);
              });
              mobileSubLinks.forEach(link => {
                  link.classList.toggle('active-sub', link.getAttribute('data-target') === maxVisibleSectionId);
              });
          }
      };

      if (!isMapPage) {
          window.addEventListener('scroll', () => {
              handleMobileHeaderAnimation();
              handleMobileScrollSpy();
          }, { passive: true });
          handleMobileHeaderAnimation();
          handleMobileScrollSpy();
      }
  });
</script>