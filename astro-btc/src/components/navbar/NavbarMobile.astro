---
import navData from '../../data/navigation.json';
const leftItems = navData.left;
const rightItems = navData.right;
const novedadItems = navData.about_drop;
---
<header 
    id="mobile-header" 
    class="lg:hidden fixed top-0 left-0 w-full z-50 transition-all duration-300 bg-black/95 backdrop-blur-md py-2 border-b border-white/5 shadow-2xl"
>
    <div class="container mx-auto px-6 h-16 relative flex items-center justify-between">
        <button id="mobile-menu-btn" class="text-zinc-400 hover:text-white p-2 rounded-lg transition-colors focus:outline-none z-50">
            <svg id="icon-menu" class="h-7 w-7 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg id="icon-close" class="h-7 w-7 hidden transition-transform duration-300 scale-50 opacity-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
        </button>
        <div class="z-50 flex items-center gap-4"></div>
    </div>

    <nav id="mobile-dropdown" class="absolute top-full left-0 w-full bg-black/98 backdrop-blur-xl border-b border-white/10 transition-all duration-300 origin-top transform scale-y-0 opacity-0 pointer-events-none shadow-2xl">
        <div class="flex flex-col items-center py-8 px-6 gap-6 max-h-[85vh] overflow-y-auto">
            
            <div class="flex flex-col items-center gap-6 w-full">
                {leftItems.map((item: any) => (
                    <a href={item.href} class="mobile-nav-link text-base font-bold uppercase tracking-widest transition-all relative group py-2" data-target={item.id}>
                        {item.name}
                        <span class="absolute bottom-0 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full nav-line"></span>
                    </a>
                ))}
            </div>

            <div class="w-full border-t border-white/10 pt-6 pb-2 flex flex-col items-center">
                <p class="text-[10px] font-black uppercase tracking-[0.3em] text-zinc-500 mb-4">Mapas</p>
                <div class="flex flex-col gap-2 w-full max-w-xs">
                    {novedadItems.map((item: any) => (
                        <a href={item.href} class="mobile-submenu-link text-xs font-bold text-zinc-400 uppercase tracking-widest py-3 px-6 rounded-lg hover:bg-white/5 hover:text-btc-orange transition-all text-center w-full" data-target={item.id}>
                            {item.name}
                        </a>
                    ))}
                </div>
            </div>

            <div class="flex flex-col items-center gap-6 w-full border-t border-white/10 pt-6">
                {rightItems.map((item: any) => (
                    <a href={item.href} class="mobile-nav-link text-base font-bold uppercase tracking-widest transition-all relative group py-2" data-target={item.id}>
                        {item.name}
                        <span class="absolute bottom-0 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full nav-line"></span>
                    </a>
                ))}
            </div>

        </div>
    </nav>
</header>

<style>
    .mobile-nav-link { color: rgba(255, 255, 255, 0.8); }
    .mobile-nav-link:hover { color: #f97316; }
    .mobile-nav-link .nav-line { background-color: #f97316 !important; }
    .mobile-nav-link.active { color: #fbbf24 !important; }
    .mobile-nav-link.active .nav-line { width: 100% !important; background-color: #fbbf24 !important; }
    .mobile-submenu-link.active-sub { color: #f97316 !important; background-color: rgba(255,255,255,0.05); }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const mobileBtn = document.getElementById('mobile-menu-btn');
        const mobileDropdown = document.getElementById('mobile-dropdown');
        const iconMenu = document.getElementById('icon-menu');
        const iconClose = document.getElementById('icon-close');
        const mobileNavLinks = document.querySelectorAll('.mobile-nav-link');
        const mobileSubLinks = document.querySelectorAll('.mobile-submenu-link');

        const toggleMenu = () => {
            const isClosed = mobileDropdown.classList.contains('scale-y-0');
            if (isClosed) {
                mobileDropdown.classList.remove('scale-y-0', 'opacity-0', 'pointer-events-none');
                mobileDropdown.classList.add('scale-y-100', 'opacity-100', 'pointer-events-auto');
                iconMenu.classList.add('hidden', 'scale-50', 'opacity-0');
                iconMenu.classList.remove('block');
                iconClose.classList.remove('hidden', 'scale-50', 'opacity-0');
                iconClose.classList.add('block');
            } else {
                mobileDropdown.classList.add('scale-y-0', 'opacity-0', 'pointer-events-none');
                mobileDropdown.classList.remove('scale-y-100', 'opacity-100', 'pointer-events-auto');
                iconMenu.classList.remove('hidden', 'scale-50', 'opacity-0');
                iconMenu.classList.add('block');
                iconClose.classList.add('hidden', 'scale-50', 'opacity-0');
                iconClose.classList.remove('block');
            }
        };

        if(mobileBtn) mobileBtn.addEventListener('click', toggleMenu);

        const allLinks = [...mobileNavLinks, ...mobileSubLinks];
        allLinks.forEach(link => {
            link.addEventListener('click', () => {
                if (!mobileDropdown.classList.contains('scale-y-0')) toggleMenu();
            });
        });

        const currentPath = window.location.pathname.replace(/\/$/, "");
        const highlightMobileLinks = () => {
            mobileNavLinks.forEach(link => {
                const href = link.getAttribute('href')?.replace(/\/$/, "");
                if (!href) return;
                
                if (href === "/" && currentPath === "") {
                    link.classList.add('active');
                } else if (href !== "/" && currentPath.includes(href)) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });
            mobileSubLinks.forEach(link => {
                const href = link.getAttribute('href')?.replace(/\/$/, "");
                if (currentPath === href) {
                    link.classList.add('active-sub');
                } else {
                    link.classList.remove('active-sub');
                }
            });
        };
        highlightMobileLinks();
    });
</script>