---
// src/components/navbar/NavbarMobile.astro
import navData from '../../data/navigation.json';
import links from '../../data/links.json';

const mainItems = navData.main;
const dropdowns = navData.dropdowns || {};
---

<header class="mobile-header">
    <div class="mobile-container">
        <a href="/#inicio" class="flex items-center gap-2">
            <img src="/images/logo-text.webp" alt="Builtechraft" class="h-8 w-auto object-contain" />
        </a>

        <button id="mobile-menu-toggle" class="mobile-menu-btn" aria-label="Abrir Menú">
            <svg id="hamburger-icon" class="w-6 h-6 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="close-icon" class="w-6 h-6 hidden transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>

    <div id="mobile-dropdown" class="mobile-dropdown-menu">
        <nav class="flex flex-col items-center gap-6 py-8 px-6">
            {mainItems.map((item: any) => {
                const targetUrl = (item.keyLink && (links as any)[item.keyLink]) 
                    ? (links as any)[item.keyLink] 
                    : (item.href || '#');
                const customStyle = item.hexColor ? `--text-muted: ${item.hexColor}; --color-btc-orange: ${item.hexColor}; --color-btc-yellow: ${item.hexColor};` : undefined;
                const subItems = item.dropdownKey ? (dropdowns as any)[item.dropdownKey] : [];

                return item.hasDropdown ? (
                    <div class="w-full flex flex-col items-center">
                        <button 
                            type="button"
                            class="mobile-nav-link flex items-center justify-center gap-2 cursor-pointer w-full text-center mobile-sub-toggle" 
                            data-dropdown-id={`sub-${item.id}`}
                            style={customStyle}
                        >
                            {item.name}
                            <svg class="w-4 h-4 transition-transform duration-300 arrow-icon" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                            </svg>
                            <span class="nav-line"></span>
                        </button>
                        
                        <div id={`sub-${item.id}`} class="mobile-sub-menu hidden flex-col items-center gap-2 mt-4 w-full bg-theme-alternate p-4 rounded-xl border border-theme">
                            {subItems.map((subItem: any) => {
                                const subUrl = (subItem.keyLink && (links as any)[subItem.keyLink]) 
                                    ? (links as any)[subItem.keyLink] 
                                    : (subItem.href || '#');
                                return (
                                    <a 
                                        href={subUrl} 
                                        target={subItem.isExternal ? "_blank" : "_self"}
                                        rel={subItem.isExternal ? "noopener noreferrer" : undefined}
                                        class="mobile-submenu-link"
                                    >
                                        {subItem.name}
                                    </a>
                                );
                            })}
                        </div>
                    </div>
                ) : (
                    <a 
                        href={targetUrl} 
                        class="mobile-nav-link text-center w-full"
                        style={customStyle}
                        target={item.isExternal ? "_blank" : "_self"}
                        rel={item.isExternal ? "noopener noreferrer" : undefined}
                    >
                        {item.name}
                        <span class="nav-line"></span>
                    </a>
                );
            })}
        </nav>
    </div>
</header>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        const toggleBtn = document.getElementById('mobile-menu-toggle');
        const dropdown = document.getElementById('mobile-dropdown');
        const hamburgerIcon = document.getElementById('hamburger-icon');
        const closeIcon = document.getElementById('close-icon');

        if (toggleBtn && dropdown && hamburgerIcon && closeIcon) {
            toggleBtn.addEventListener('click', () => {
                const isOpen = dropdown.classList.contains('scale-y-100');
                
                if (isOpen) {
                    dropdown.classList.remove('scale-y-100', 'opacity-100', 'pointer-events-auto');
                    dropdown.classList.add('scale-y-0', 'opacity-0', 'pointer-events-none');
                    hamburgerIcon.classList.remove('hidden');
                    closeIcon.classList.add('hidden');
                } else {
                    dropdown.classList.remove('scale-y-0', 'opacity-0', 'pointer-events-none');
                    dropdown.classList.add('scale-y-100', 'opacity-100', 'pointer-events-auto');
                    hamburgerIcon.classList.add('hidden');
                    closeIcon.classList.remove('hidden');
                }
            });
        }

        // Clic para abrir/cerrar submenús en móviles
        const subToggles = document.querySelectorAll('.mobile-sub-toggle');
        subToggles.forEach(btn => {
            btn.addEventListener('click', () => {
                const targetId = btn.getAttribute('data-dropdown-id');
                if (!targetId) return;
                
                const targetMenu = document.getElementById(targetId);
                const arrow = btn.querySelector('.arrow-icon');
                
                if (targetMenu) {
                    const isSubOpen = !targetMenu.classList.contains('hidden');
                    if (isSubOpen) {
                        targetMenu.classList.add('hidden');
                        targetMenu.classList.remove('flex');
                        if (arrow) arrow.style.transform = 'rotate(0deg)';
                    } else {
                        targetMenu.classList.remove('hidden');
                        targetMenu.classList.add('flex');
                        if (arrow) arrow.style.transform = 'rotate(180deg)';
                    }
                }
            });
        });
    });
</script>