---
interface Props {
  locale: 'es' | 'en';
  targetLocale: 'es' | 'en';
  switchHref: string;
  isMobile?: boolean;
  dict: any;
}
const { locale, targetLocale, switchHref, isMobile = false, dict } = Astro.props;
---

<a 
  href={switchHref} 
  class={`flex items-center gap-2 transition-all ${isMobile ? 'justify-center px-4 py-3 font-bold text-theme-main mt-4 border-t border-theme-1 pt-4 hover:text-btc-orange' : 'nav-link'}`}
  aria-label={locale === 'es' ? dict.common.navigation.switchToEnglish : dict.common.navigation.switchToSpanish}
>
  {targetLocale === 'en' ? (
    <!-- Bandera Reino Unido - AHORA MÁS GRANDE -->
    <svg class="w-7 h-7 rounded-sm shadow-sm" viewBox="0 0 60 30" xmlns="http://www.w3.org/2000/svg">
      <clipPath id="s-uk"><path d="M0,0 v30 h60 v-30 z"/></clipPath>
      <clipPath id="t-uk"><path d="M0,30 h30 v-30 h-30 z"/></clipPath>
      <g clip-path="url(#s-uk)">
        <path d="M0,0 v30 h60 v-30 z" fill="#012169"/>
        <path d="M0,0 L60,30 M60,0 L0,30" stroke="#fff" stroke-width="6"/>
        <path d="M0,0 L60,30 M60,0 L0,30" clip-path="url(#t-uk)" stroke="#c8102e" stroke-width="4"/>
        <path d="M30,0 v30 M0,15 h60" stroke="#fff" stroke-width="10"/>
        <path d="M30,0 v30 M0,15 h60" stroke="#c8102e" stroke-width="6"/>
      </g>
    </svg>
  ) : (
    <!-- Bandera España - AHORA MÁS GRANDE -->
    <svg class="w-7 h-7 rounded-sm shadow-sm" viewBox="0 0 750 500" xmlns="http://www.w3.org/2000/svg">
      <rect width="750" height="500" fill="#c60b1e"/>
      <rect width="750" height="250" y="125" fill="#ffc400"/>
    </svg>
  )}
  {isMobile && <span>{targetLocale === 'en' ? 'English' : 'Español'}</span>}
  {!isMobile && <span class="nav-line"></span>}
</a>