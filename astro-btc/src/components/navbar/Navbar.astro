---
import navData from '../../data/navigation.json';
import links from '../../data/links.json';
import { getDictionary, getLocaleFromPath, localizePath } from '../../lib/i18n';
import NavLink from './NavLink.astro';
import Dropdown from './Dropdown.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import MobileMenu from './MobileMenu.astro';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
const targetLocale = locale === 'es' ? 'en' : 'es';

// Lógica robusta para el switch de idioma (mantiene la ruta de wiki si existe)
const pathSegments = Astro.url.pathname.split('/').filter(Boolean);
const hasLangPrefix = pathSegments[0] === 'es' || pathSegments[0] === 'en';
// En src/components/navbar/Navbar.astro, busca estas líneas y reemplázalas por:
const unprefixedPath = Astro.url.pathname.replace(/^\/(?:es|en)(?=\/|$)/, '') || '/';

// ✅ NUEVO: Solo cambia el prefijo de idioma, mantiene la ruta del artículo intacta
const languageSwitchHref = localizePath(unprefixedPath, targetLocale);
const articlePath = Astro.url.pathname.match(/\/(es|en)\/wiki\/([^/]+)\/articles\//);

const mainItems = navData.main;
const dropdowns = navData.dropdowns || {};

const getLink = (key: string) => {
  const allLinks: Record<string, string> = {
    ...links.pages,
    ...links.social,
    ...links.maps,
    ...links.wiki,
  };
  return allLinks[key] || '#';
};

const localizeHref = (keyLink: string | undefined, href: string | undefined, localized: boolean) => {
  const path = keyLink ? getLink(keyLink) : (href || '/');
  return localized ? localizePath(path, locale) : path;
};
---

<!-- Header Móvil -->
<header class="lg:hidden fixed top-0 left-0 z-[100] bg-theme-app border-b border-theme-1" style="width: 100%; max-width: 100vw; box-sizing: border-box;">
    <div class="flex items-center justify-between h-16" style="width: 100%; max-width: 100vw; padding: 0 1rem; box-sizing: border-box;">
        <a href={localizeHref('inicio', '/', true)} class="flex items-center gap-2 shrink-0">
            <img src={links.assets.favicon} alt="Builtechraft" class="h-8 w-auto" />
        </a>
        <button id="mobile-menu-toggle" class="p-2 text-theme-main hover:text-btc-orange transition-colors shrink-0" aria-label={dict.common.navigation.menu}>
            <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
            </svg>
            <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
            </svg>
        </button>
    </div>
</header>

<!-- Menú Móvil (Componente separado) -->
<MobileMenu 
  mainItems={mainItems}
  dropdowns={dropdowns}
  locale={locale}
  targetLocale={targetLocale}
  switchHref={languageSwitchHref}
  dict={dict}
  getLink={getLink}
  localizeHref={localizeHref}
/>

<!-- Header Desktop -->
<header class="hidden lg:block w-full z-50 fixed top-0 left-0 backdrop-blur-md py-2 border-b shadow-lg transition-all duration-300 navbar-header">
    <div class="container mx-auto px-6 h-16 relative flex items-center justify-between">
        <!-- Logo a la izquierda -->
        <a href={localizeHref('inicio', '/', true)} class="flex items-center gap-2 shrink-0">
            <img src={links.assets.favicon} alt="Builtechraft" class="h-10 w-auto object-contain drop-shadow-md" />
        </a>
        
        <!-- Enlaces a la derecha -->
        <nav class="flex items-center justify-end gap-8 flex-1">
            {mainItems.map((item: any) => {
                const label = item.name || dict.common.navigation[item.id] || item.id;
                
                // Si 'localized' no está definido, asumimos true (comportamiento por defecto)
                const isLocalized = item.localized !== false; 
                const targetUrl = localizeHref(item.keyLink, item.href, isLocalized);
                
                const isPlayButton = item.id === 'play' || item.keyLink === 'ingreso';
                const subItems = item.dropdownKey ? (dropdowns as any)[item.dropdownKey] : [];
                const isActive = Astro.url.pathname.includes(item.href || item.keyLink || '');

                if (item.hasDropdown && subItems.length > 0) {
                    return (
                        <Dropdown 
                            label={label} 
                            dropdownId={`drop-${item.id}`}
                            items={subItems.map((sub: any) => ({
                                id: sub.id,
                                href: localizeHref(sub.keyLink, sub.href, sub.localized !== false),
                                label: sub.name || dict.common.navigation[sub.id] || sub.id,
                                isExternal: sub.isExternal
                            }))}
                            isActive={isActive}
                        />
                    );
                }

                return (
                    <NavLink 
                        href={targetUrl}
                        label={label}
                        isActive={isActive}
                        isExternal={item.isExternal}
                        isPlayButton={isPlayButton}
                        hexColor={item.hexColor}
                    />
                );
            })}
            
            <!-- Selector de idioma (Componente separado) -->
            <LanguageSwitcher 
                locale={locale} 
                targetLocale={targetLocale} 
                switchHref={languageSwitchHref} 
                dict={dict} 
            />
        </nav>
    </div>
</header>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const toggleBtn = document.getElementById('mobile-menu-toggle') as HTMLElement;
    const closeBtn = document.getElementById('mobile-menu-close') as HTMLElement;
    const sheet = document.getElementById('mobile-sheet') as HTMLElement;
    const backdrop = document.getElementById('sheet-backdrop') as HTMLElement;
    const hamburgerIcon = document.getElementById('hamburger-icon') as HTMLElement;
    const closeIcon = document.getElementById('close-icon') as HTMLElement;

    const openSheet = () => {
      sheet?.classList.remove('translate-x-full');
      sheet?.classList.add('translate-x-0');
      backdrop?.classList.remove('opacity-0', 'invisible');
      backdrop?.classList.add('opacity-100', 'visible');
      hamburgerIcon?.classList.add('hidden');
      closeIcon?.classList.remove('hidden');
      document.body.style.overflow = 'hidden';
    };

    const closeSheet = () => {
      sheet?.classList.add('translate-x-full');
      sheet?.classList.remove('translate-x-0');
      backdrop?.classList.add('opacity-0', 'invisible');
      backdrop?.classList.remove('opacity-100', 'visible');
      hamburgerIcon?.classList.remove('hidden');
      closeIcon?.classList.add('hidden');
      document.body.style.overflow = '';
    };

    toggleBtn?.addEventListener('click', () => sheet?.classList.contains('translate-x-0') ? closeSheet() : openSheet());
    closeBtn?.addEventListener('click', closeSheet);
    backdrop?.addEventListener('click', closeSheet);

    document.querySelectorAll('.mobile-dropdown-btn').forEach(btn => {
      btn.addEventListener('click', () => {
        const targetId = btn.getAttribute('data-dropdown-id');
        const targetMenu = targetId ? document.getElementById(targetId) : null;
        const arrow = btn.querySelector('.arrow-icon') as HTMLElement;
        if (targetMenu) {
          const isHidden = targetMenu.classList.contains('hidden');
          targetMenu.classList.toggle('hidden', !isHidden);
          targetMenu.classList.toggle('flex', isHidden);
          if (arrow) arrow.style.transform = isHidden ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      });
    });

    document.querySelectorAll('#mobile-sheet a').forEach(link => {
      link.addEventListener('click', () => setTimeout(closeSheet, 150));
    });

    document.querySelectorAll('.nav-dropdown-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const targetId = btn.getAttribute('data-dropdown-target');
        const targetMenu = targetId ? document.getElementById(targetId) : null;
        const arrow = btn.querySelector('.arrow-svg') as HTMLElement;

        document.querySelectorAll('.navbar-dropdown').forEach(menu => { if (menu !== targetMenu) menu.classList.remove('is-open'); });
        document.querySelectorAll('.arrow-svg').forEach(a => { if (a !== arrow) (a as HTMLElement).style.transform = 'rotate(0deg)'; });

        if (targetMenu) {
          const isOpen = targetMenu.classList.toggle('is-open');
          if (arrow) arrow.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
        }
      });
    });

    document.addEventListener('click', () => {
      document.querySelectorAll('.navbar-dropdown').forEach(menu => menu.classList.remove('is-open'));
      document.querySelectorAll('.arrow-svg').forEach(a => (a as HTMLElement).style.transform = 'rotate(0deg)');
    });
  });
</script>

<style>
  .btn-play-rect {
    position: relative;
    padding: 0.5rem 1.5rem;
    background-color: color-mix(in srgb, var(--text-accent) 10%, transparent);
    border: 1px solid var(--border-accent);
    color: var(--text-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 0.125rem;
    transition: all 0.3s ease;
  }
  .btn-play-rect:hover {
    background-color: var(--text-accent);
    color: #ffffff;
    border-color: var(--text-accent);
  }
  .btn-play-rect .nav-line {
    background-color: #ffffff !important;
    bottom: 0.25rem;
  }
  .btn-play-rect-mobile {
    display: block;
    width: 100%;
    text-align: center;
    padding: 0.75rem 1rem;
    background-color: color-mix(in srgb, var(--text-accent) 10%, transparent);
    border: 1px solid var(--border-accent);
    color: var(--text-accent);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 0.125rem;
    margin-top: 0.5rem;
    transition: all 0.3s ease;
  }
  .btn-play-rect-mobile:hover {
    background-color: var(--text-accent);
    color: #ffffff;
    border-color: var(--text-accent);
  }
</style>