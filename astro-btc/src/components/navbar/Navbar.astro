---
// src/components/navbar/Navbar.astro
import navData from '../../data/navigation.json';
import links from '../../data/links.json';

const mainItems = navData.main;
const dropdowns = navData.dropdowns || {};
---

<header id="main-header" class="navbar-header">
    <div class="navbar-container">
        
        <a href="/#inicio" class="flex items-center gap-2 transition-transform hover:scale-105 z-20">
            <img src="/images/logo-text.webp" alt="Builtechraft" loading="eager" class="h-10 w-auto object-contain drop-shadow-md" />
        </a>

        <nav class="hidden lg:flex items-center justify-end gap-10 flex-1">
            {mainItems.map((item: any) => {
                // Resolución segura del enlace (garantiza que siempre haya una URL válida)
                const targetUrl = (item.keyLink && (links as any)[item.keyLink]) 
                    ? (links as any)[item.keyLink] 
                    : (item.href || '#');
                const customStyle = item.hexColor ? `--text-muted: ${item.hexColor}; --color-btc-orange: ${item.hexColor};` : undefined;
                const subItems = item.dropdownKey ? (dropdowns as any)[item.dropdownKey] : [];

                return item.hasDropdown ? (
                    <div class="relative py-2">
                        <button 
                            type="button"
                            class="nav-link flex items-center gap-1.5 cursor-pointer outline-none nav-dropdown-btn"
                            data-dropdown-target={`nav-drop-${item.id}`}
                            style={customStyle}
                        >
                            {item.name}
                            <svg class="w-4 h-4 text-theme-muted transition-transform duration-300 arrow-svg" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 9l-7 7-7-7"></path>
                            </svg>
                            <span class="nav-line"></span>
                        </button>
                        
                        <div id={`nav-drop-${item.id}`} class="navbar-dropdown nav-dropdown-menu">
                             <div class="flex flex-col gap-1">
                                {subItems.map((subItem: any) => {
                                    const subUrl = (subItem.keyLink && (links as any)[subItem.keyLink]) 
                                        ? (links as any)[subItem.keyLink] 
                                        : (subItem.href || '#');
                                    return (
                                        <a 
                                            href={subUrl} 
                                            target={subItem.isExternal ? "_blank" : "_self"}
                                            rel={subItem.isExternal ? "noopener noreferrer" : undefined}
                                            class="submenu-link"
                                        >
                                             {subItem.name}
                                        </a>
                                    );
                                })}
                             </div>
                        </div>
                    </div>
                ) : (
                    <a 
                        href={targetUrl} 
                        target={item.isExternal ? "_blank" : "_self"}
                        rel={item.isExternal ? "noopener noreferrer" : undefined}
                        class="nav-link" 
                        style={customStyle}
                    >
                         {item.name}
                        <span class="nav-line"></span>
                    </a>
                );
            })}
        </nav>
    </div>
</header>

<button id="back-to-top" aria-label="Volver arriba" class="fixed bottom-8 right-8 z-50 bg-btc-orange text-white p-3.5 rounded-2xl shadow-lg shadow-btc-orange/30 opacity-0 invisible translate-y-4 transition-all duration-300 hover:-translate-y-1 hover:bg-orange-500 hover:shadow-btc-orange/50">
    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 15l7-7 7 7"></path></svg>
</button>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        // Lógica de CLIC EXCLUSIVO para desplegar submenús
        const dropdownBtns = document.querySelectorAll('.nav-dropdown-btn');
        const dropdownMenus = document.querySelectorAll('.nav-dropdown-menu');

        dropdownBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                e.stopPropagation();
                const targetId = btn.getAttribute('data-dropdown-target');
                const targetMenu = document.getElementById(targetId);
                const arrow = btn.querySelector('.arrow-svg');

                // Cerrar cualquier otro submenú que estuviera abierto
                dropdownMenus.forEach(menu => {
                    if (menu !== targetMenu) menu.classList.remove('is-open');
                });
                document.querySelectorAll('.arrow-svg').forEach(a => {
                    if (a !== arrow) a.style.transform = 'rotate(0deg)';
                });

                // Abrir o cerrar el submenú actual
                if (targetMenu) {
                    const isOpen = targetMenu.classList.toggle('is-open');
                    if (arrow) {
                        arrow.style.transform = isOpen ? 'rotate(180deg)' : 'rotate(0deg)';
                    }
                }
            });
        });

        // Cerrar submenús al hacer clic fuera
        document.addEventListener('click', () => {
            dropdownMenus.forEach(menu => menu.classList.remove('is-open'));
            document.querySelectorAll('.arrow-svg').forEach(a => a.style.transform = 'rotate(0deg)');
        });

        // Botón Volver Arriba
        const bttBtn = document.getElementById('back-to-top');
        if (bttBtn) {
            window.addEventListener('scroll', () => {
                if (window.scrollY > 400) {
                    bttBtn.classList.remove('opacity-0', 'invisible', 'translate-y-4');
                    bttBtn.classList.add('opacity-100', 'visible', 'translate-y-0');
                } else {
                    bttBtn.classList.add('opacity-0', 'invisible', 'translate-y-4');
                    bttBtn.classList.remove('opacity-100', 'visible', 'translate-y-0');
                }
            });

            bttBtn.addEventListener('click', () => {
                window.scrollTo({ top: 0, behavior: 'smooth' });
            });
        }
    });
</script>