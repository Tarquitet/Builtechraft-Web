---
// src/components/technical/ModsAndDatapacks.astro
---

{/* SECCIÓN: DATAPACKS */}
<div id="datapacks-section" class="hidden mb-16">
    <div class="container mx-auto px-6 relative z-20 mb-6">
        <div class="flex items-center gap-3">
            <span class="text-2xl">📦</span>
            <h3 class="text-2xl font-display font-bold text-btc-yellow uppercase tracking-widest border-b-2 border-yellow-500/50 pb-1">
                Datapacks
            </h3>
        </div>
    </div>
    <div class="container mx-auto px-6 relative z-20">
        <div id="datapacks-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
    </div>
</div>

{/* SECCIÓN: MODS Y PLUGINS */}
<div id="mods-section" class="hidden mb-20">
    <div class="container mx-auto px-6 relative z-20 mb-6">
        <div class="flex items-center gap-3">
            <span class="text-2xl">⚡</span>
            <h3 class="text-2xl font-display font-bold text-blue-500 uppercase tracking-widest border-b-2 border-blue-500/30 pb-1">
                Mods
            </h3>
        </div>
    </div>
    <div class="container mx-auto px-6 relative z-20">
        <div id="mods-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4"></div>
    </div>
</div>

<script>
import { getModsAndDatapacks } from '../../utils/sheetsClient.js';
import { fetchModrinthIcons } from '../../utils/modrinthClient.js';

document.addEventListener('DOMContentLoaded', async () => {
    const dpGrid = document.getElementById('datapacks-grid');
    const modsGrid = document.getElementById('mods-grid');
    const dpSection = document.getElementById('datapacks-section');
    const modsSection = document.getElementById('mods-section');
    const loadingEl = document.getElementById('loading-mods');

    const getColorClass = (tipo: string) => {
        const t = tipo?.toLowerCase() || '';
        if(t.includes('mod')) return 'text-blue-500 group-hover:border-blue-500/50';
        if(t.includes('plugin')) return 'text-orange-500 group-hover:border-orange-500/50';
        if(t.includes('proxy')) return 'text-emerald-500 group-hover:border-emerald-500/50';
        if(t.includes('datapack')) return 'text-btc-yellow group-hover:border-btc-yellow/50';
        return 'text-zinc-400 group-hover:border-zinc-400/50';
    };

    const createModCardHTML = (item: any) => `
        <a href="${item.url}" target="_blank" rel="noopener noreferrer" class="mod-card flex items-center gap-4 p-4 bg-zinc-900 border border-white/10 rounded-2xl transition-all group hover:bg-zinc-800 hover:-translate-y-1 shadow-lg ${getColorClass(item.type)}" data-query-id="${item.queryId}">
            <div class="icon-container shrink-0 w-12 h-12 flex items-center justify-center bg-black/40 rounded-xl border border-white/5 group-hover:scale-105 transition-transform overflow-hidden">
                <span class="text-2xl icon-emoji">${item.icon}</span>
            </div>
            <div class="overflow-hidden">
                <h4 class="font-bold text-zinc-100 text-sm transition-colors truncate">${item.name}</h4>
                <p class="text-xs text-zinc-400 truncate">${item.desc}</p>
            </div>
        </a>
    `;

    try {
        const { mods, datapacks, modrinthIdsToFetch } = await getModsAndDatapacks();

        if (datapacks.length > 0 && dpGrid && dpSection) {
            dpGrid.innerHTML = datapacks.map(createModCardHTML).join('');
            dpSection.classList.remove('hidden');
        }
        if (mods.length > 0 && modsGrid && modsSection) {
            modsGrid.innerHTML = mods.map(createModCardHTML).join('');
            modsSection.classList.remove('hidden');
        }
        
        if(loadingEl) loadingEl.style.display = 'none';

        if (modrinthIdsToFetch.length > 0) {
            const mrData = await fetchModrinthIcons(modrinthIdsToFetch);
            mrData.forEach((project: any) => {
                if (project.icon_url) {
                    const cards = document.querySelectorAll(`.mod-card[data-query-id="${project.id}"], .mod-card[data-query-id="${project.slug}"]`);
                    cards.forEach(card => {
                        const container = card.querySelector('.icon-container');
                        if (container) {
                            container.innerHTML = `<img src="${project.icon_url}" alt="${project.title}" class="w-full h-full object-cover p-1 animate-fade-in rounded-lg" />`;
                        }
                    });
                }
            });
        }
    } catch (err) {
        console.error("Error cargando componentes técnicos:", err);
        if(loadingEl) loadingEl.innerHTML = "Error sincronizando base de datos. Recarga la página.";
    }
});
</script>

<style>
    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }
    .animate-fade-in {
        animation: fade-in 0.5s ease-out forwards;
    }
</style>