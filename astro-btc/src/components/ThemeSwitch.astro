---
// src/components/ThemeSwitch.astro
---
<section class="py-16 bg-theme-panel border-t border-theme-border relative overflow-hidden transition-colors duration-500">
    <div class="container mx-auto px-6 flex justify-center relative z-10">
        
        <div class="relative w-full max-w-2xl h-24 bg-theme-main rounded-full shadow-inner border border-theme-border flex items-center px-2 cursor-pointer transition-colors duration-300 group" id="theme-track">
            
            <div class="absolute inset-0 flex justify-between items-center px-10 pointer-events-none select-none opacity-30">
                <svg class="w-8 h-8 text-btc-orange" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
                <svg class="w-8 h-8 text-btc-blue" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
            </div>

            <div id="theme-handle" class="w-20 h-20 rounded-full shadow-2xl transform transition-all duration-500 ease-in-out flex items-center justify-center relative z-10 group-hover:scale-105">
                <svg id="handle-sun" class="w-10 h-10 text-white animate-spin-slow" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z" /></svg>
                <svg id="handle-moon" class="w-10 h-10 text-white hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z" /></svg>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    const track = document.getElementById('theme-track');
    const handle = document.getElementById('theme-handle');
    const iconSun = document.getElementById('handle-sun');
    const iconMoon = document.getElementById('handle-moon');
    const htmlEl = document.documentElement;

    function renderTheme(isLight) {
        if (isLight) {
            // DÍA (Derecha)
            handle.className = "w-20 h-20 rounded-full shadow-2xl transform transition-all duration-500 ease-in-out flex items-center justify-center relative z-10 group-hover:scale-105 ml-auto bg-gradient-to-br from-btc-blue to-cyan-400";
            iconSun.classList.add('hidden');
            iconMoon.classList.remove('hidden');
            htmlEl.classList.add('light');
        } else {
            // NOCHE (Izquierda)
            handle.className = "w-20 h-20 rounded-full shadow-2xl transform transition-all duration-500 ease-in-out flex items-center justify-center relative z-10 group-hover:scale-105 mr-auto bg-gradient-to-br from-btc-orange to-red-500";
            iconSun.classList.remove('hidden');
            iconMoon.classList.add('hidden');
            htmlEl.classList.remove('light');
        }
    }

    // Inicializar
    let isLight = localStorage.getItem('theme') === 'light';
    renderTheme(isLight);

    track.addEventListener('click', () => {
        isLight = !isLight;
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
        renderTheme(isLight);
    });
</script>

<style>
    .animate-spin-slow {
        animation: spin 10s linear infinite;
    }
    @keyframes spin {
        from { transform: rotate(0deg); }
        to { transform: rotate(360deg); }
    }
</style>