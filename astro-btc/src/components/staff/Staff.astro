---
// src/components/Staff.astro
---

<section id="staff" class="py-24 relative overflow-hidden border-y border-white/5 bg-[#111]">
    <div class="absolute inset-0 bg-[url('/images/dirt-pattern.png')] opacity-5 mix-blend-overlay pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10 max-w-6xl">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-center mb-16 uppercase text-white tracking-tight drop-shadow-lg">
            Nuestro <span class="text-btc-orange">Equipo</span>
        </h2>
        
        <div id="loading-staff" class="flex flex-col justify-center items-center py-10 text-zinc-500 gap-3">
            <span class="text-4xl animate-bounce">👥</span>
            <span class="animate-pulse font-bold tracking-widest uppercase text-sm">Cargando equipo...</span>
        </div>

        <div id="staff-grid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8 hidden"></div>
    </div>
</section>

<dialog id="staff-modal" class="bg-transparent m-auto w-full h-full max-w-none max-h-none backdrop:bg-black/90 fixed inset-0 z-50 overflow-hidden opacity-0 pointer-events-none transition-opacity duration-300 open:pointer-events-auto">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="fixed inset-0 cursor-pointer" onclick="closeStaffModal()"></div>
        <div class="relative bg-zinc-900 border border-white/10 rounded-3xl overflow-hidden shadow-2xl transform transition-all sm:max-w-lg w-full scale-95 opacity-0 modal-content duration-300">
            <button onclick="closeStaffModal()" class="absolute top-5 right-5 text-zinc-400 hover:text-white z-20 bg-black/60 p-2 rounded-full border border-white/5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            <div id="modal-header" class="h-32 w-full relative">
                <div class="absolute inset-0 bg-gradient-to-b from-black/80 to-zinc-900 z-10"></div>
            </div>
            <div class="px-6 pb-8 relative z-20 -mt-16 flex flex-col items-center">
                <div class="w-32 h-32 rounded-full p-[3px] bg-zinc-800 shadow-xl mb-4 relative">
                    <div id="modal-img-border" class="absolute inset-0 rounded-full opacity-50"></div>
                    <img id="modal-img" src="" class="relative w-full h-full rounded-full object-cover bg-black" />
                </div>
                <h3 id="modal-name" class="text-3xl font-display font-bold text-white uppercase mb-1 tracking-tight">Nombre</h3>
                <span id="modal-role" class="text-[10px] font-bold uppercase tracking-[0.2em] px-4 py-1.5 bg-black/30 rounded-full border border-white/5 mb-6">Rol</span>
                <p id="modal-bio" class="text-zinc-300 text-sm text-center leading-relaxed mb-8 max-w-sm"></p>
                <div id="modal-socials-container" class="w-full">
                    <div class="w-full h-px bg-white/5 mb-6"></div>
                    <div id="modal-socials" class="flex flex-wrap justify-center gap-3"></div>
                </div>
            </div>
        </div>
    </div>
</dialog>

<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js" is:inline></script>

<script type="module" is:inline>
    import { getStaffData } from '/src/utils/sheetsClient.js';

    document.addEventListener('DOMContentLoaded', async () => {
        const staffGrid = document.getElementById('staff-grid');
        const loadingStaff = document.getElementById('loading-staff');

        const getRoleConfig = (rol) => {
            const r = rol?.toLowerCase().trim() || '';
            if (r.includes('lider') || r.includes('líder')) return { displayName: 'Líder', text: 'text-btc-orange', gradient: 'bg-gradient-to-br from-btc-orange to-btc-yellow', isRetired: false, weight: 1 };
            if (r.includes('admin')) return { displayName: 'Admin', text: 'text-red-500', gradient: 'bg-gradient-to-br from-red-600 to-red-400', isRetired: false, weight: 2 };
            if (r.includes('vigilante')) return { displayName: 'Vigilante', text: 'text-blue-500', gradient: 'bg-gradient-to-br from-blue-600 to-cyan-400', isRetired: false, weight: 3 };
            if (r.includes('retirado')) return { displayName: 'Staff Retirado', text: 'text-zinc-600', gradient: 'bg-zinc-800', isRetired: true, weight: 99 };
            return { displayName: rol || 'Staff', text: 'text-zinc-300', gradient: 'bg-zinc-700', isRetired: false, weight: 10 };
        };

        const defaultAvatar = 'https://ui-avatars.com/api/?name=Staff&background=18181b&color=fff&size=150';
        let globalTeamData = [];

        try {
            let staffMembers = await getStaffData();
            
            if (staffMembers.length > 0) {
                staffMembers.sort((a, b) => {
                    const weightA = getRoleConfig(a.Rol).weight;
                    const weightB = getRoleConfig(b.Rol).weight;
                    if (weightA !== weightB) return weightA - weightB;
                    return a.Nombre.localeCompare(b.Nombre); 
                });

                globalTeamData = staffMembers.map(m => ({ ...m, config: getRoleConfig(m.Rol) }));

                staffGrid.innerHTML = globalTeamData.map(member => {
                    const config = member.config;
                    const avatarUrl = member.Avatar?.trim() ? member.Avatar.trim() : defaultAvatar;
                    
                    const imageFilter = config.isRetired ? 'grayscale opacity-70' : '';
                    
                    const cardStyle = config.isRetired 
                        ? 'opacity-80 hover:opacity-100 hover:-translate-y-1' 
                        : 'hover:-translate-y-2';

                    return `
                        <button onclick="window.openStaffModal('${member.Nombre}')" class="bg-zinc-900/95 border-2 border-white/5 rounded-3xl p-6 flex flex-col items-center text-center transition-all duration-300 shadow-xl group w-full cursor-pointer focus:outline-none ${cardStyle}">
                            
                            <div class="w-32 h-32 rounded-2xl overflow-hidden mb-5 p-1 ${config.gradient} shadow-lg relative ${!config.isRetired ? 'group-hover:scale-105' : ''} transition-transform duration-300">
                                <div class="w-full h-full bg-zinc-900 rounded-xl overflow-hidden relative">
                                    <img 
                                        src="${avatarUrl}" 
                                        alt="Avatar de ${member.Nombre}" 
                                        class="w-full h-full object-cover transition-all duration-500 ${!config.isRetired ? 'group-hover:scale-110' : ''} ${imageFilter}" 
                                        referrerpolicy="no-referrer"
                                        onerror="this.onerror=null; this.src='${defaultAvatar}';" 
                                    />
                                    ${config.isRetired ? '<div class="absolute inset-0 bg-black/20 group-hover:bg-transparent transition-colors duration-300"></div>' : ''}
                                </div>
                            </div>
                            
                            <h3 class="text-xl font-bold uppercase text-white mb-2 truncate w-full ${!config.isRetired ? `group-hover:${config.text}` : ''} transition-colors">${member.Nombre}</h3>
                            
                            <span class="text-[10px] font-bold uppercase tracking-widest px-3 py-1 rounded-lg bg-black/40 border border-white/5 ${config.text}">
                                ${config.displayName}
                            </span>
                        </button>
                    `;
                }).join('');
                
                loadingStaff.style.display = 'none';
                staffGrid.classList.remove('hidden');

                // LÓGICA DEL MODAL
                const staffModal = document.getElementById('staff-modal');
                const modalContent = staffModal.querySelector('.modal-content');

                window.openStaffModal = (name) => {
                    const m = globalTeamData.find(member => member.Nombre === name);
                    if (!m) return;

                    const config = m.config;
                    const avatarUrl = m.Avatar?.trim() ? m.Avatar.trim() : defaultAvatar;

                    document.getElementById('modal-name').textContent = m.Nombre;
                    document.getElementById('modal-role').textContent = config.displayName;
                    document.getElementById('modal-role').className = `text-[10px] font-bold uppercase tracking-[0.2em] px-4 py-1.5 bg-black/30 rounded-full border border-white/5 mb-6 ${config.text}`;
                    
                    const bioKey = Object.keys(m).find(k => k.toLowerCase().includes('bio'));
                    const bioText = (bioKey && m[bioKey]) ? m[bioKey].trim() : "Miembro del equipo de Builtechraft.";
                    document.getElementById('modal-bio').textContent = bioText;
                    
                    const img = document.getElementById('modal-img');
                    img.src = avatarUrl;
                    img.className = `relative w-full h-full rounded-full object-cover bg-black ${config.isRetired ? 'grayscale' : ''}`;
                    
                    document.getElementById('modal-header').className = `h-32 w-full relative ${config.gradient}`;
                    document.getElementById('modal-img-border').className = `absolute inset-0 rounded-full opacity-50 ${config.gradient}`;

                    const container = document.getElementById('modal-socials-container');
                    const socialsDiv = document.getElementById('modal-socials');
                    socialsDiv.innerHTML = '';

                    const columnasIgnoradas = ['nombre', 'rol', 'avatar', 'config'];
                    if (bioKey) columnasIgnoradas.push(bioKey.toLowerCase());

                    const redesSociales = Object.keys(m).filter(key => {
                        const keyLimpiada = key.toLowerCase().trim();
                        return !columnasIgnoradas.includes(keyLimpiada) && m[key] && m[key].toString().trim() !== '';
                    });

                    if (redesSociales.length === 0) {
                        container.classList.add('hidden');
                    } else {
                        container.classList.remove('hidden');
                        redesSociales.forEach(red => {
                            const link = m[red].toString().trim();
                            const a = document.createElement('a');
                            const isDiscord = red.toLowerCase() === 'discord';
                            
                            a.href = isDiscord ? '#' : link;
                            if (!isDiscord) a.target = '_blank';
                            a.className = 'px-5 py-2.5 bg-white/5 hover:bg-btc-orange border border-white/10 hover:border-btc-orange rounded-xl text-[10px] font-bold uppercase tracking-widest text-zinc-300 hover:text-white transition-all duration-300';
                            
                            if (isDiscord) {
                                a.onclick = (e) => {
                                    e.preventDefault();
                                    navigator.clipboard.writeText(link);
                                    const oldText = a.textContent;
                                    a.textContent = '¡Copiado!';
                                    setTimeout(() => a.textContent = oldText, 2000);
                                };
                            }
                            a.textContent = red;
                            socialsDiv.appendChild(a);
                        });
                    }

                    staffModal.showModal();
                    staffModal.classList.remove('opacity-0', 'pointer-events-none');
                    setTimeout(() => {
                        modalContent.classList.remove('scale-95', 'opacity-0');
                        modalContent.classList.add('scale-100', 'opacity-100');
                    }, 10);
                };

                window.closeStaffModal = () => {
                    modalContent.classList.remove('scale-100', 'opacity-100');
                    modalContent.classList.add('scale-95', 'opacity-0');
                    staffModal.classList.add('opacity-0', 'pointer-events-none');
                    setTimeout(() => staffModal.close(), 300);
                };

            } else {
                loadingStaff.innerHTML = "<span class='text-red-400 font-bold'>El Excel de Staff está vacío.</span>";
            }
        } catch (error) {
            console.error("Error cargando staff:", error);
            loadingStaff.innerHTML = "<span class='text-red-400 font-bold'>Error sincronizando datos con Google Sheets.</span>";
        }
    });
</script>