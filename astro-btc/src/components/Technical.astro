const doubleDatapacks = [...rawDatapacks, ...rawDatapacks];
const doubleMods = [...rawMods, ...rawMods]; // ANTES: Estaba en x1 (Tirón)
const doubleRoadmap = [...rawRoadmap, ...rawRoadmap, ...rawRoadmap, ...rawRoadmap]; // ANTES: Estaba en x3 (Tirón). Lo ponemos en x4 para que la mitad exacta sea x2.
---

<section id="tecnico" class="py-24 bg-theme-panel relative overflow-hidden transition-colors duration-300">

    <div class="container mx-auto px-6 relative z-20 mb-16 text-center">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-theme-main uppercase tracking-tight">
            Ingeniería <span class="text-theme-accent">Interna</span>
        </h2>
        <p class="text-theme-main opacity-80 text-lg max-w-2xl mx-auto mt-4">
            Nuestro servidor cuenta con varios mods y datapacks cuidadosamente seleccionados para mejorar el rendimiento, la experiencia de juego y la personalización, sin sacrificar la esencia del Minecraft vanilla.
        </p>
    </div>

    <div class="container mx-auto px-6 relative z-20 mb-4">
        <div class="flex items-center gap-3">
            <span class="text-2xl">📦</span>
            <h3 class="text-2xl font-display font-bold text-btc-yellow uppercase tracking-widest border-b-2 border-yellow-500/50 pb-1">
                Datapacks
            </h3>
        </div>
    </div>

    <div class="flex marquee-container mb-16 relative z-20">
        <div class="flex animate-marquee-left whitespace-nowrap pause-on-hover">
            {doubleDatapacks.map((item) => (
                <div class="inline-block px-3">
                    <a href={item.url} target="_blank" class="mod-card block w-64 p-4 bg-zinc-900 border border-white/10 rounded-xl hover:border-btc-orange transition-colors group relative" data-modrinth-url={item.url}>
                        <div class="flex items-center gap-4">
                            <div class="icon-container shrink-0 w-12 h-12 flex items-center justify-center bg-black/40 rounded-lg group-hover:scale-110 transition-transform overflow-hidden border border-white/5">
