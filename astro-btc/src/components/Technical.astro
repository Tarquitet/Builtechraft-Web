// =============================================================================
// DATOS DE MODS (Motor Fabric, Optimización y Gestión)
// =============================================================================
const rawMods = [
    // Optimización
    { name: "Lithium", desc: "Optimización de físicas, IA y ticks del servidor.", icon: "⚡", url: "https://modrinth.com/mod/lithium" },
    { name: "Alternate Current", desc: "Algoritmo de Redstone optimizado para eliminar lag.", icon: "🔌", url: "https://modrinth.com/mod/alternate-current" },
    { name: "FerriteCore", desc: "Reducción drástica del uso de memoria RAM.", icon: "💾", url: "https://modrinth.com/mod/ferrite-core" },
    { name: "Krypton", desc: "Optimización del stack de red para menor latencia.", icon: "🌐", url: "https://modrinth.com/mod/krypton" },
    { name: "ScalableFlux", desc: "Mejora en la gestión de paquetes de red bajo carga.", icon: "📈", url: "https://modrinth.com/mod/scalableflux" },
    { name: "Hibernate Fabric", desc: "Pausa el servidor cuando no hay jugadores activos.", icon: "💤", url: "https://modrinth.com/mod/hibernate-fabric" },
    
    // Core & Herramientas Técnicas
    { name: "Carpet Mod", desc: "Control técnico y diagnóstico total del servidor.", icon: "🧶", url: "https://modrinth.com/mod/carpet" },
    { name: "Carpet TIS Addition", desc: "Extensiones técnicas avanzadas para Carpet.", icon: "➕", url: "https://modrinth.com/mod/carpet-tis-addition" },
    { name: "Syncmatica", desc: "Sincronización de esquemas de Litematica en el servidor.", icon: "🏗️", url: "https://modrinth.com/mod/syncmatica" },
    { name: "WorldEdit", desc: "Potente herramienta de edición de mundo masiva.", icon: "🎨", url: "https://modrinth.com/mod/worldedit" },
    { name: "Fabric API", desc: "Librería base esencial para el ecosistema Fabric.", icon: "🛠️", url: "https://modrinth.com/mod/fabric-api" },
    { name: "Packet Fixer", desc: "Corrección de errores técnicos en el envío de paquetes.", icon: "📦", url: "https://modrinth.com/mod/packet-fixer" },

    // Conectividad (Geyser / Proxy)
    { name: "Geyser Fabric", desc: "Entrada para jugadores de Bedrock (Móvil/Consola).", icon: "📱", url: "https://modrinth.com/mod/geyser" },
    { name: "Floodgate", desc: "Autenticación para cuentas Bedrock sin cuenta Java.", icon: "🌉", url: "https://modrinth.com/mod/floodgate" },
    { name: "FabricProxy-Lite", desc: "Gestión ligera tras el proxy de red.", icon: "📡", url: "https://modrinth.com/mod/fabricproxy-lite" },
    { name: "VelocityTab", desc: "Sincronización de tabulador mediante el proxy.", icon: "📑", url: "https://modrinth.com/mod/velocitytab" },
    { name: "ViaVersion", desc: "Compatibilidad con versiones de cliente superiores.", icon: "🔄", url: "https://modrinth.com/mod/viaversion" },
    { name: "ViaBackwards", desc: "Compatibilidad con versiones de cliente anteriores.", icon: "◀️", url: "https://modrinth.com/mod/viabackwards" },
    
    // Gestión & Seguridad
    { name: "LuckPerms", desc: "Gestión avanzada de rangos y permisos.", icon: "🔑", url: "https://modrinth.com/mod/luckperms" },
    { name: "Vanilla Permissions", desc: "Sistema de permisos ligero integrado.", icon: "🛡️", url: "https://modrinth.com/mod/vanilla-permissions" },
    { name: "No Chat Reports", desc: "Protección de privacidad que elimina firmas de chat.", icon: "🤐", url: "https://modrinth.com/mod/no-chat-reports" },
    { name: "SimpleWhitelist", desc: "Gestión segura de la lista blanca del servidor.", icon: "📝", url: "https://modrinth.com/plugin/simplewhitelist" },
    { name: "SkinRestorer", desc: "Restauración de skins para usuarios Java y Bedrock.", icon: "👕", url: "https://modrinth.com/mod/skinrestorer" },
    { name: "MiniMotd", desc: "Mensaje dinámico en la lista de servidores.", icon: "📄", url: "https://modrinth.com/mod/minimotd" },
    { name: "Placeholder API", desc: "Manejo de variables dinámicas en menús y textos.", icon: "🏷️", url: "https://modrinth.com/mod/placeholder-api" },
    { name: "Discord: JustSync", desc: "Sincronización de chat y roles con Discord.", icon: "💬", url: "https://modrinth.com/mod/discord-justsync" },
    
    // Utilidades
    { name: "Servux", desc: "Soporte para mods de utilidad (MiniHUD, etc) del cliente.", icon: "🔧", url: "https://modrinth.com/mod/servux" },
    { name: "JourneyMap", desc: "Integración de mapeado del mundo en tiempo real.", icon: "🗺️", url: "https://modrinth.com/mod/journeymap" },
    { name: "Footprint", desc: "Rastreo técnico y registro de actividad de jugadores.", icon: "👣", url: "https://modrinth.com/mod/footprint" },
    { name: "Multilogin", desc: "Gestión de múltiples tipos de acceso al servidor.", icon: "👥", url: "https://www.spigotmc.org/resources/multilogin.115996/" }
];

// Lógica de enriquecimiento con API de Modrinth (Se mantiene igual)
const enrichData = async (items) => {
    return await Promise.all(items.map(async (item) => {
        if (item.url && item.url.includes("modrinth.com")) {
            try {
                const slug = item.url.split('/').pop();
                const response = await fetch(`https://api.modrinth.com/v2/project/${slug}`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.icon_url) return { ...item, icon: data.icon_url, isImage: true };
                }
            } catch (e) { console.error(e); }
        }
        return { ...item, isImage: false };
    }));
};

const datapacks = await enrichData(rawDatapacks);
const mods = await enrichData(rawMods);
---

<section id="tecnico" class="py-24 bg-theme-panel border-y border-white/5 relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        
        <div class="text-center mb-20">
            <h2 class="text-4xl font-display font-bold text-theme-main uppercase tracking-tight">
                Corazón <span class="text-btc-gold">Técnico</span>
            </h2>
            <p class="text-theme-muted text-lg max-w-3xl mx-auto mt-4 leading-relaxed">
                Priorizamos el rendimiento extremo y la esencia <strong>Vanilla</strong>. Todo el poder de Fabric y Datapacks, sin instalaciones obligatorias para el usuario.
            </p>
        </div>

        <div class="mb-24">
            <h3 class="text-2xl font-display font-bold text-btc-orange mb-8 flex items-center gap-3">
                <span class="bg-btc-orange/10 p-2 rounded-lg text-xl">📦</span> 
                Datapacks <span class="text-sm text-gray-500 font-sans font-normal ml-2">Gameplay & QoL</span>
            </h3>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
                {datapacks.map(dp => (
                    <a href={dp.url} target="_blank" class="group bg-theme-main p-6 rounded-2xl border border-white/5 hover:border-btc-orange/50 hover:shadow-xl transition-all flex items-start gap-4">
                        {dp.isImage ? <img src={dp.icon} class="w-12 h-12 rounded-xl bg-black/20 p-1" /> : <span class="text-4xl w-12 h-12 flex items-center justify-center bg-black/20 rounded-xl">{dp.icon}</span>}
                        <div>
                            <h4 class="font-bold text-theme-main group-hover:text-btc-orange transition-colors">{dp.name}</h4>
                            <p class="text-xs text-theme-muted mt-1 leading-relaxed">{dp.desc}</p>
                        </div>
                    </a>
                ))}
            </div>
        </div>

        <div class="mb-24">
            <h3 class="text-2xl font-display font-bold text-blue-400 mb-8 flex items-center gap-3">
                <span class="bg-blue-500/10 p-2 rounded-lg text-xl">⚙️</span> 
                Fabric Mods <span class="text-sm text-gray-500 font-sans font-normal ml-2">Optimización de Servidor</span>
            </h3>
            
            <div id="mods-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 overflow-hidden transition-all duration-500 max-h-[500px]">
                {mods.map(mod => (
                    <a href={mod.url} target="_blank" class="group bg-theme-main p-6 rounded-2xl border border-white/5 hover:border-blue-500/50 hover:shadow-xl transition-all flex items-start gap-4">
                        {mod.isImage ? <img src={mod.icon} class="w-12 h-12 rounded-xl bg-black/20 p-1" /> : <span class="text-4xl w-12 h-12 flex items-center justify-center bg-black/20 rounded-xl">{mod.icon}</span>}
                        <div>
                            <h4 class="font-bold text-theme-main group-hover:text-blue-400 transition-colors">{mod.name}</h4>
                            <p class="text-xs text-theme-muted mt-1 leading-relaxed">{mod.desc}</p>
                        </div>
                    </a>
                ))}
            </div>

            <div class="mt-10 text-center">
                <button id="btn-show-mods" class="px-8 py-3 bg-white/5 hover:bg-white/10 border border-white/10 rounded-full text-sm font-bold tracking-widest transition-all">
                    MOSTRAR TODOS LOS MODS
                </button>
            </div>
        </div>

        <div class="bg-gradient-to-r from-theme-main via-[#1c1c1f] to-theme-main p-10 rounded-3xl border border-btc-gold/20 relative overflow-hidden">
            <div class="absolute top-0 right-10 bg-btc-gold text-black text-[10px] font-bold px-4 py-1 rounded-b-xl uppercase tracking-widest">Roadmap</div>
            
            <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 items-center">
                <div class="lg:col-span-1">
                    <span class="text-6xl mb-4 block">🎨</span>
                    <h3 class="text-3xl font-display font-bold text-white mb-4 uppercase">Futuro <span class="text-btc-gold">Visual</span></h3>
                    <p class="text-theme-muted leading-relaxed italic">
                        "Expandiendo las fronteras de Builtechraft mediante ingeniería creativa."
                    </p>
                </div>
                
                <div class="lg:col-span-2 grid grid-cols-1 md:grid-cols-2 gap-8">
                    <div class="pl-6 border-l-2 border-btc-orange/40">
                        <h4 class="font-bold text-white mb-2">Modelos 3D & Resourcepacks</h4>
                        <p class="text-sm text-theme-muted">Items personalizados con modelos 3D únicos inyectados por el servidor sin requerir mods de cliente.</p>
                    </div>
                    <div class="pl-6 border-l-2 border-btc-orange/40">
                        <h4 class="font-bold text-white mb-2">Audio Inmersivo</h4>
                        <p class="text-sm text-theme-muted">Integración de música personalizada para eventos y zonas específicas mediante discos de música editados.</p>
                    </div>
                </div>
            </div>

            <div class="mt-10 pt-8 border-t border-white/5 text-center">
                <a href="#discord" class="text-xs font-bold text-btc-gold hover:text-white uppercase tracking-[0.2em] transition-all">
                    Sigue el desarrollo en tiempo real en Discord →
                </a>
            </div>
        </div>

    </div>
</section>

<script>
    const btn = document.getElementById('btn-show-mods');
    const grid = document.getElementById('mods-grid');

    btn?.addEventListener('click', () => {
        if (grid?.style.maxHeight === 'none') {
            grid.style.maxHeight = '500px';
            btn.textContent = 'MOSTRAR TODOS LOS MODS';
        } else if (grid) {
            grid.style.maxHeight = 'none';
            btn.textContent = 'MOSTRAR MENOS';
        }
    });
</script>