<script>
    // SCRIPT DEL CLIENTE PARA CARGAR ICONOS
    // Se ejecuta en el navegador del usuario después de cargar la página
    document.addEventListener('DOMContentLoaded', () => {
        const cards = document.querySelectorAll('.mod-card');

        // Función para extraer el slug de la URL
        const getSlug = (url) => {
            if (!url.includes('modrinth.com')) return null;
            // Eliminar parámetros query si existen
            const cleanUrl = url.split('?')[0];
            const parts = cleanUrl.split('/');
            // El slug suele ser el último segmento (ej: .../project/lithium -> lithium)
            return parts[parts.length - 1] || parts[parts.length - 2];
        };

        // Cache simple para no pedir la misma imagen 3 veces (por el marquee infinito)
        const iconCache = {};

        cards.forEach(async (card) => {
            const url = card.getAttribute('data-modrinth-url');
            if (!url) return;

            const slug = getSlug(url);
            if (!slug) return;

            const container = card.querySelector('.icon-container');
            const emojiSpan = card.querySelector('.icon-emoji');

            // 1. Revisar Caché
            if (iconCache[slug]) {
                injectImage(container, emojiSpan, iconCache[slug]);
                return;
            }

            // 2. Si no está en caché, pedir a Modrinth
            try {
                const response = await fetch(`https://api.modrinth.com/v2/project/${slug}`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.icon_url) {
                        iconCache[slug] = data.icon_url; // Guardar en caché
                        injectImage(container, emojiSpan, data.icon_url);
                    }
                }
            } catch (err) {
                // Si falla, dejamos el emoji quieto
                // console.warn('Error cargando icono para', slug);
            }
        });

        function injectImage(container, emojiSpan, iconUrl) {
            if (!container) return;
            
            // Ocultar emoji
            if (emojiSpan) emojiSpan.style.display = 'none';

            // Crear imagen
            const img = document.createElement('img');
            img.src = iconUrl;
            img.className = "w-full h-full object-cover animate-fade-in";
            img.alt = "Icon";
            
            // Añadir al DOM
            container.appendChild(img);
        }
    });
</script>

<style>
    @keyframes marquee-left {
        0% { transform: translateX(0); }
        100% { transform: translateX(-50%); }
    }
    
    @keyframes marquee-right {
        0% { transform: translateX(-50%); }
        100% { transform: translateX(0); }
    }
    
    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .animate-marquee-left {
        display: flex;
        width: max-content;
        animation: marquee-left 60s linear infinite;
        transform: translateZ(0);
    }

    .animate-marquee-right {
        display: flex;
        width: max-content;
        animation: marquee-right 60s linear infinite;
        transform: translateZ(0);
    }
    
    .animate-fade-in {
        animation: fade-in 0.5s ease-out forwards;
    }

    .pause-on-hover:hover {
        animation-play-state: paused;
    }

    .marquee-container {
        mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
        overflow: hidden; 
    }
</style>