<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js" is:inline></script>

<section id="tecnico" class="py-24 bg-theme-panel relative overflow-hidden transition-colors duration-300">

    <div class="container mx-auto px-6 relative z-20 mb-16 text-center">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-theme-main uppercase tracking-tight">
            Ingeniería <span class="text-theme-accent">Interna</span>
        </h2>
        <p class="text-theme-main opacity-80 text-lg max-w-2xl mx-auto mt-4">
            Nuestro servidor cuenta con varios mods y datapacks sincronizados en tiempo real. Están cuidadosamente seleccionados para mejorar el rendimiento, la experiencia de juego y la personalización, sin sacrificar la esencia del Minecraft vanilla.
        </p>
    </div>

    {/* ESTADO DE CARGA MODS */}
    <div id="loading-mods" class="flex flex-col justify-center items-center py-10 mb-20 text-zinc-500 gap-3">
        <span class="text-3xl animate-bounce">📡</span>
        <span class="animate-pulse font-bold tracking-widest uppercase text-sm">Sincronizando base de datos...</span>
    </div>

    {/* SECCIÓN: DATAPACKS */}
    <div id="datapacks-section" class="hidden">
        <div class="container mx-auto px-6 relative z-20 mb-4">
            <div class="flex items-center gap-3">
                <span class="text-2xl">📦</span>
                <h3 class="text-2xl font-display font-bold text-btc-yellow uppercase tracking-widest border-b-2 border-yellow-500/50 pb-1">
                    Datapacks
                </h3>
            </div>
        </div>
        <div class="flex marquee-container mb-16 relative z-20">
            <div id="datapacks-track" class="flex animate-marquee-left whitespace-nowrap pause-on-hover"></div>
        </div>
    </div>

    {/* SECCIÓN: MODS Y PLUGINS */}
    <div id="mods-section" class="hidden">
        <div class="container mx-auto px-6 relative z-20 mb-4">
            <div class="flex items-center gap-3 justify-end md:justify-start"> 
                <span class="text-2xl">⚡</span>
                <h3 class="text-2xl font-display font-bold text-blue-500 uppercase tracking-widest border-b-2 border-blue-500/30 pb-1">
                    Mods & Plugins
                </h3>
            </div>
        </div>
        <div class="flex marquee-container mb-24 relative z-20">
            <div id="mods-track" class="flex animate-marquee-right whitespace-nowrap pause-on-hover"></div>
        </div>
    </div>

    {/* ROADMAP DINÁMICO DESDE SHEETS (CINTA TRANSPORTADORA) */}
    <div class="container mx-auto px-6 relative z-20 mb-12 text-center mt-12">
        <div class="inline-block p-3 rounded-full bg-black/30 backdrop-blur-sm mb-4 border border-white/5">
            <span class="text-3xl">🚀</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-display font-bold text-theme-text uppercase tracking-tight">
            Roadmap <span class="text-btc-yellow">Público</span>
        </h2>
        <p class="text-theme-main opacity-80 text-lg max-w-2xl mx-auto mt-4">
            Planes futuros para expandir la inmersión, el arte y la personalización del servidor sin alterar las mecánicas vanilla ni el rendimiento.
        </p>
    </div>

    <div id="roadmap-section" class="hidden flex marquee-container relative z-20 pb-10">
        <div id="roadmap-track" class="flex animate-marquee-left whitespace-nowrap pause-on-hover" style="animation-duration: 90s;"></div>
    </div>

</section>

<script is:inline>
document.addEventListener('DOMContentLoaded', async () => {
    // ==========================================
    // ENLACES DE GOOGLE SHEETS
    // ==========================================
    const MODS_CSV_URL = "https://docs.google.com/spreadsheets/d/1Iz5vklWMbVcgOCYRVN5NOEBX91VLfOCkHtI5ilxut-c/export?format=csv";
    const ROADMAP_CSV_URL = "https://docs.google.com/spreadsheets/d/e/2PACX-1vSFamJKSgtbjYKglTus-BHOljT6p42eSAq8vT9sE_7BFj5EBlDp2dx1iRgeHjZoyWb0zIoSccN8nUSe/pub?gid=877286509&single=true&output=csv";

    // ==========================================
    // 1. LÓGICA DEL ROADMAP (CINTA TRANSPORTADORA)
    // ==========================================
    
    // Mapeo de estilos según el "Estado" escrito en el Excel
    const getStatusStyle = (estado) => {
        const s = estado?.toLowerCase().trim() || '';
        if (s.includes('progreso')) return { color: 'text-btc-orange', border: 'hover:border-btc-orange/50', icon: '✨' };
        if (s.includes('planeado')) return { color: 'text-blue-400', border: 'hover:border-blue-400/50', icon: '📋' };
        if (s.includes('prueba'))   return { color: 'text-purple-400', border: 'hover:border-purple-400/50', icon: '🧪' };
        if (s.includes('concepto')) return { color: 'text-emerald-400', border: 'hover:border-emerald-400/50', icon: '💡' };
        return { color: 'text-zinc-400', border: 'hover:border-zinc-400/50', icon: '💡' }; // Por defecto
    };

    const createRoadmapCard = (item) => {
        const style = getStatusStyle(item.Estado);
        
        // Formateo de los detalles (por salto de línea Alt+Enter)
        const detallesHtml = item.Detalles ? item.Detalles.split('\n').filter(d => d.trim() !== '').map(d => `
            <li class="flex items-center gap-2 text-xs text-zinc-300 whitespace-normal">
                <span class="w-1 h-1 rounded-full bg-btc-yellow/50 shrink-0"></span>
                ${d.trim()}
            </li>
        `).join('') : '';

        // Mostrar contenedor de icono solo si existe en el Sheets
        const iconHTML = item.Icono 
            ? `<span class="text-3xl bg-black/40 p-2 rounded-lg border border-white/5 shrink-0">${item.Icono}</span>`
            : '';

        return `
            <div class="inline-block px-4">
                <div class="w-80 md:w-96 bg-zinc-900 p-6 rounded-2xl border border-white/10 transition-all group relative overflow-hidden ${style.border} h-full flex flex-col justify-between">
                    <div class="flex flex-col gap-3">
                        <div class="flex items-start gap-3 mb-1">
                            ${iconHTML}
                            <div class="overflow-hidden flex-1">
                                <h4 class="font-bold text-white text-lg tracking-tight group-hover:text-btc-yellow transition-colors truncate">${item.Titulo}</h4>
                                <span class="text-[10px] font-bold uppercase tracking-wider ${style.color} flex items-center gap-1">
                                    ${style.icon} ${item.Estado || 'Pendiente'}
                                </span>
                            </div>
                        </div>
                        <p class="text-zinc-300 text-sm leading-relaxed whitespace-normal h-10 line-clamp-2">
                            ${item.Descripcion}
                        </p>
                    </div>
                    
                    ${detallesHtml ? `
                    <div class="bg-black/20 rounded-xl p-3 border border-white/5 mt-4">
                        <ul class="space-y-1">${detallesHtml}</ul>
                    </div>` : ''}
                </div>
            </div>
        `;
    };

    async function loadRoadmap() {
        const roadmapTrack = document.getElementById('roadmap-track');
        const roadmapSection = document.getElementById('roadmap-section');

        try {
            const response = await fetch(ROADMAP_CSV_URL);
            const csvText = await response.text();

            Papa.parse(csvText, {
                header: true,
                skipEmptyLines: true,
                complete: function(results) {
                    // ⚠️ MAGIA AQUÍ: Filtramos filas vacías, y también las que digan "Completado" o "Descartado"
                    const data = results.data.filter(item => {
                        if (!item.Titulo || item.Titulo.trim() === '') return false;
                        const estado = item.Estado ? item.Estado.toLowerCase().trim() : '';
                        if (estado.includes('completado') || estado.includes('descartado')) return false;
                        return true;
                    });
                    
                    if (data.length > 0) {
                        // Multiplicamos por 4 para asegurar que el loop infinito nunca se corte
                        const doubleRoadmap = [...data, ...data, ...data, ...data];
                        roadmapTrack.innerHTML = doubleRoadmap.map(createRoadmapCard).join('');
                        roadmapSection.classList.remove('hidden');
                        roadmapSection.classList.add('flex');
                    } else {
                        // Si todas las tarjetas están completadas/descartadas, ocultamos la sección
                        roadmapSection.classList.add('hidden');
                        roadmapSection.classList.remove('flex');
                    }
                }
            });
        } catch (error) {
            console.error("Error cargando el Roadmap:", error);
        }
    }

    // ==========================================
    // 2. LÓGICA DE LOS MODS (INTACTA)
    // ==========================================
    const datapacksTrack = document.getElementById('datapacks-track');
    const modsTrack = document.getElementById('mods-track');
    const dpSection = document.getElementById('datapacks-section');
    const modsSection = document.getElementById('mods-section');
    const loadingEl = document.getElementById('loading-mods');

    const getIcon = (tipo) => {
        const t = tipo?.toLowerCase() || '';
        if(t.includes('mod')) return '⚡';
        if(t.includes('plugin')) return '🧩';
        if(t.includes('proxy')) return '📡';
        if(t.includes('datapack')) return '📦';
        return '⚙️';
    };

    const getColor = (tipo) => {
        const t = tipo?.toLowerCase() || '';
        if(t.includes('mod')) return 'text-blue-500 hover:border-blue-500';
        if(t.includes('plugin')) return 'text-orange-500 hover:border-orange-500';
        if(t.includes('proxy')) return 'text-emerald-500 hover:border-emerald-500';
        if(t.includes('datapack')) return 'text-btc-yellow hover:border-btc-yellow';
        return 'text-zinc-400 hover:border-zinc-400';
    };

    const createModCardHTML = (item) => `
        <div class="inline-block px-3">
            <a href="${item.url}" target="_blank" class="mod-card block w-64 p-4 bg-zinc-900 border border-white/10 rounded-xl transition-colors group relative ${getColor(item.type)}" data-query-id="${item.queryId}">
                <div class="flex items-center gap-4">
                    <div class="icon-container shrink-0 w-12 h-12 flex items-center justify-center bg-black/40 rounded-lg group-hover:scale-110 transition-transform overflow-hidden border border-white/5">
                        <span class="text-2xl icon-emoji">${item.icon}</span>
                    </div>
                    <div>
                        <h4 class="font-bold text-zinc-100 text-sm transition-colors truncate w-32">${item.name}</h4>
                        <p class="text-xs text-zinc-400 truncate w-32">${item.desc}</p>
                    </div>
                </div>
            </a>
        </div>
    `;

    async function loadMods() {
        try {
            const response = await fetch(MODS_CSV_URL);
            const csvText = await response.text();
            
            Papa.parse(csvText, {
                header: false,
                skipEmptyLines: true,
                complete: async function(results) {
                    let mods = [];
                    let datapacks = [];
                    let modrinthIdsToFetch = [];

                    results.data.forEach((row, index) => {
                        if (index < 4) return; 

                        const colNombre = row[0];       
                        const colDesc = row[1];         
                        const colURL = row[2];          
                        const colID = row[3];           
                        const colContenido = row[4];    
                        const colEnUso = row[7];        

                        if (colEnUso?.trim().toUpperCase() !== "SI") return;
                        if (!colNombre || colNombre.trim() === "") return;

                        let url = colURL?.trim() || "";
                        let queryId = "";
                        
                        if (colID && colID.trim() !== "") {
                            queryId = colID.trim();
                            url = `https://modrinth.com/project/${queryId}`;
                            modrinthIdsToFetch.push(queryId); 
                        } else if (url === "") {
                            const query = encodeURIComponent(colNombre.trim());
                            url = `https://modrinth.com/mods?q=${query}`;
                        }

                        const item = {
                            name: colNombre.trim(),
                            desc: colDesc ? colDesc.trim() : "Optimización técnica",
                            type: colContenido ? colContenido.trim() : "Misc",
                            icon: getIcon(colContenido),
                            url: url,
                            queryId: queryId
                        };

                        if (item.type.toLowerCase().includes('datapack')) {
                            datapacks.push(item);
                        } else {
                            mods.push(item);
                        }
                    });

                    const doubleDatapacks = [...datapacks, ...datapacks];
                    const doubleMods = [...mods, ...mods];

                    if (doubleDatapacks.length > 0 && dpSection) {
                        datapacksTrack.innerHTML = doubleDatapacks.map(createModCardHTML).join('');
                        dpSection.classList.remove('hidden');
                    }
                    if (doubleMods.length > 0 && modsSection) {
                        modsTrack.innerHTML = doubleMods.map(createModCardHTML).join('');
                        modsSection.classList.remove('hidden');
                    }
                    
                    if(loadingEl) loadingEl.style.display = 'none';

                    if (modrinthIdsToFetch.length > 0) {
                        const uniqueIds = [...new Set(modrinthIdsToFetch)].slice(0, 100);
                        try {
                            const mrRes = await fetch(`https://api.modrinth.com/v2/projects?ids=${JSON.stringify(uniqueIds)}`);
                            if (mrRes.ok) {
                                const mrData = await mrRes.json();
                                mrData.forEach(project => {
                                    if (project.icon_url) {
                                        const cards = document.querySelectorAll(`.mod-card[data-query-id="${project.id}"], .mod-card[data-query-id="${project.slug}"]`);
                                        cards.forEach(card => {
                                            const container = card.querySelector('.icon-container');
                                            if (container) {
                                                container.innerHTML = `<img src="${project.icon_url}" alt="${project.title}" class="w-full h-full object-cover p-1 animate-fade-in" />`;
                                            }
                                        });
                                    }
                                });
                            }
                        } catch (e) { console.warn("Límite de peticiones de iconos alcanzado."); }
                    }
                }
            });
        } catch (err) {
            console.error("Error cargando los mods:", err);
            if(loadingEl) loadingEl.innerHTML = "Error sincronizando base de datos. Recarga la página.";
        }
    }

    // Carga paralela para máxima velocidad
    Promise.all([loadRoadmap(), loadMods()]);
});
</script>

<style>
    /* Estilos de la cinta (marquee) */
    @keyframes marquee-left {
        0% { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(-50%, 0, 0); }
    }
    
    @keyframes marquee-right {
        0% { transform: translate3d(-50%, 0, 0); }
        100% { transform: translate3d(0, 0, 0); }
    }
    
    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .animate-marquee-left {
        display: flex;
        width: max-content;
        animation: marquee-left 60s linear infinite;
        transform: translateZ(0);
        will-change: transform;
    }

    .animate-marquee-right {
        display: flex;
        width: max-content;
        animation: marquee-right 60s linear infinite;
        transform: translateZ(0);
        will-change: transform;
    }
    
    .animate-fade-in {
        animation: fade-in 0.5s ease-out forwards;
    }

    .pause-on-hover:hover {
        animation-play-state: paused;
    }

    .marquee-container {
        width: 100%;
        overflow: hidden;
        min-height: 120px; 
        contain: paint; 
        -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
        mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    }
</style>