---
// src/components/Technical.astro
import ModsAndDatapacks from './technical/ModsAndDatapacks.astro';
import Roadmap from './technical/Roadmap.astro';
---

<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js" is:inline></script>

<section id="tecnico" class="py-24 bg-theme-panel relative overflow-hidden transition-colors duration-300">

    <div class="container mx-auto px-6 relative z-20 mb-16 text-center">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-theme-main uppercase tracking-tight">
            Ingeniería <span class="text-theme-accent">Interna</span>
        </h2>
        <p class="text-theme-main opacity-80 text-lg max-w-2xl mx-auto mt-4">
            Nuestro servidor cuenta con varios mods y datapacks sincronizados en tiempo real. Están cuidadosamente seleccionados para mejorar el rendimiento, la experiencia de juego y la personalización, sin sacrificar la esencia del Minecraft vanilla.
        </p>
    </div>

    <div id="loading-mods" class="flex flex-col justify-center items-center py-10 mb-20 text-zinc-500 gap-3">
        <span class="text-3xl animate-bounce">📡</span>
        <span class="animate-pulse font-bold tracking-widest uppercase text-sm">Sincronizando base de datos...</span>
    </div>

    <div class="container mx-auto px-6 relative z-20 max-w-7xl">
        <ModsAndDatapacks />

        <Roadmap />
    </div>

</section>