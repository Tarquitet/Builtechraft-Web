                            </div>
                            <div>
                                <h4 class="font-bold text-zinc-100 text-sm group-hover:text-btc-orange transition-colors">{item.name}</h4>
                                <p class="text-xs text-zinc-400 truncate w-32">{item.desc}</p>
                            </div>
                        </div>
                    </a>
                </div>
            ))}
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-20 mb-4">
        <div class="flex items-center gap-3 justify-end md:justify-start"> 
            <span class="text-2xl">⚡</span>
            <h3 class="text-2xl font-display font-bold text-blue-500 uppercase tracking-widest border-b-2 border-blue-500/30 pb-1">
                Mods (Fabric)
            </h3>
        </div>
    </div>

    <div class="flex marquee-container mb-24 relative z-20">
        <div class="flex animate-marquee-right whitespace-nowrap pause-on-hover">
            {doubleMods.map((item) => (
                <div class="inline-block px-3">
                    <a href={item.url} target="_blank" class="mod-card block w-64 p-4 bg-zinc-900 border border-white/10 rounded-xl hover:border-blue-500 transition-colors group relative" data-modrinth-url={item.url}>
                        <div class="flex items-center gap-4">
                            <div class="icon-container shrink-0 w-12 h-12 flex items-center justify-center bg-black/40 rounded-lg group-hover:scale-110 transition-transform overflow-hidden border border-white/5">
                                <span class="text-2xl icon-emoji">{item.icon}</span>
                            </div>
                            <div>
                                <h4 class="font-bold text-zinc-100 text-sm group-hover:text-blue-500 transition-colors">{item.name}</h4>
                                <p class="text-xs text-zinc-400 truncate w-32">{item.desc}</p>
                            </div>
                        </div>
                    </a>
                </div>
            ))}
        </div>
    </div>

    <div class="container mx-auto px-6 relative z-20 mb-12 text-center">
        <div class="inline-block p-3 rounded-full bg-black/30 backdrop-blur-sm mb-4 border border-white/5">
            <span class="text-3xl">🚀</span>
        </div>
        <h2 class="text-3xl md:text-4xl font-display font-bold text-theme-text uppercase tracking-tight">
            Roadmap <span class="text-btc-yellow">Visual</span>
        </h2>
        <p class="text-theme-main opacity-80 text-lg max-w-2xl mx-auto mt-4">
            Planes futuros para expandir la inmersión, el arte y la personalización del servidor sin alterar las mecánicas vanilla ni el rendimiento.
        </p>
    </div>

    <div class="flex marquee-container relative z-20 pb-10">
        <div class="flex animate-marquee-left whitespace-nowrap pause-on-hover" style="animation-duration: 90s;">
            {doubleRoadmap.map((feature) => (
                <div class="inline-block px-4">
                    <div class={`w-80 md:w-96 bg-zinc-900 p-6 rounded-2xl border border-white/10 transition-all group relative overflow-hidden ${feature.borderColor}`}>
                        <div class="flex justify-between items-start mb-4">
                            <div class="flex items-center gap-3">
                                <span class="text-3xl bg-black/40 p-2 rounded-lg border border-white/5">{feature.icon}</span>
                                <div>
                                    <h4 class="font-bold text-white text-lg tracking-tight group-hover:text-btc-yellow transition-colors">{feature.title}</h4>
                                    <span class={`text-[10px] font-bold uppercase tracking-wider ${feature.statusColor} flex items-center gap-1`}>
                                        {feature.statusIcon} {feature.status}
                                    </span>
                                </div>
                            </div>
                        </div>
                        <p class="text-zinc-300 text-sm leading-relaxed mb-4 whitespace-normal h-10 line-clamp-2">
                            {feature.desc}
                        </p>
                        <div class="bg-black/20 rounded-xl p-3 border border-white/5">
                            <ul class="space-y-1">
                                {feature.details.map(detail => (
                                    <li class="flex items-center gap-2 text-xs text-zinc-300 whitespace-normal">
                                        <span class="w-1 h-1 rounded-full bg-btc-yellow/50 shrink-0"></span>
                                        {detail}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                </div>
            ))}
        </div>
    </div>

</section>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        const cards = document.querySelectorAll('.mod-card');

        const getSlug = (url) => {
            if (!url.includes('modrinth.com')) return null;
            const cleanUrl = url.split('?')[0];
            const parts = cleanUrl.split('/');
            return parts[parts.length - 1] || parts[parts.length - 2];
        };

        const iconCache = {};

        cards.forEach(async (card) => {
            const url = card.getAttribute('data-modrinth-url');
            if (!url) return;

            const slug = getSlug(url);
            if (!slug) return;

            const container = card.querySelector('.icon-container');
            const emojiSpan = card.querySelector('.icon-emoji');

            if (iconCache[slug]) {
                injectImage(container, emojiSpan, iconCache[slug]);
                return;
            }

            try {
                const response = await fetch(`https://api.modrinth.com/v2/project/${slug}`);
                if (response.ok) {
                    const data = await response.json();
                    if (data.icon_url) {
                        iconCache[slug] = data.icon_url; 
                        injectImage(container, emojiSpan, data.icon_url);
                    }
                }
            } catch (err) {}
        });

        function injectImage(container, emojiSpan, iconUrl) {
            if (!container) return;
            if (emojiSpan) emojiSpan.style.display = 'none';

            const img = document.createElement('img');
            img.src = iconUrl;
            img.className = "w-full h-full object-cover animate-fade-in";
            img.alt = "Icon";
            container.appendChild(img);
        }
    });
</script>

<style>
    /* OPTIMIZACIÓN GPU: translate3d en vez de translateX */
    @keyframes marquee-left {
        0% { transform: translate3d(0, 0, 0); }
        100% { transform: translate3d(-50%, 0, 0); }
    }
    
    @keyframes marquee-right {
        0% { transform: translate3d(-50%, 0, 0); }
        100% { transform: translate3d(0, 0, 0); }
    }
    
    @keyframes fade-in {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    .animate-marquee-left {
        display: flex;
        width: max-content;
        animation: marquee-left 60s linear infinite;
        /* OPTIMIZACIÓN GPU EXTREMA */
        transform: translateZ(0);
        will-change: transform;
        backface-visibility: hidden;
    }

    .animate-marquee-right {
        display: flex;
        width: max-content;
        animation: marquee-right 60s linear infinite;
        /* OPTIMIZACIÓN GPU EXTREMA */
        transform: translateZ(0);
        will-change: transform;
        backface-visibility: hidden;
    }
    
    .animate-fade-in {
        animation: fade-in 0.5s ease-out forwards;
    }

    .pause-on-hover:hover {
        animation-play-state: paused;
    }

    .marquee-container {
        width: 100%;
        overflow: hidden;
        min-height: 120px; 
        
        /* Aisla las cintas para que el navegador no recalcule todo el DOM al moverse */
        contain: paint; 
        
        -webkit-mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
        mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    }
</style>