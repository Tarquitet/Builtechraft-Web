    { name: "Graves", desc: "Tumbas para recuperación de items al morir.", icon: "🪦", url: "https://vanillatweaks.net/picker/datapacks/" },
    { name: "Custom Villager Shops", desc: "Economía custom con tradeos editados.", icon: "⚖️", url: "https://vanillatweaks.net/picker/datapacks/" },
    { name: "Durability Ping", desc: "Aviso visual y sonoro de herramientas rotas.", icon: "🛠️", url: "https://vanillatweaks.net/picker/datapacks/" },
    { name: "More Mob Heads", desc: "Obtención de cabezas decorativas de mobs.", icon: "👤", url: "https://modrinth.com/project/x5rDcrvh" },
