---
import navData from '../data/navigation.json';

const leftItems = navData.left;
const rightItems = navData.right;
const novedadItems = navData.novedades;
const isMapPage = Astro.url.pathname.includes('/maps/');
---

<header 
  id="main-header" 
  class:list={[
    "hidden lg:block w-full z-50",
    isMapPage ? "is-scrolled" : "is-at-top"
  ]}
>
  <div class="container mx-auto px-6 h-16 relative flex items-center justify-center">

    {/* LOGO */}
    <a href="/#inicio" id="logo-link" class:list={["absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 flex items-center gap-2 transition-all duration-500", isMapPage ? "opacity-100 scale-100 pointer-events-auto" : "opacity-0 scale-50 pointer-events-none"]}>
        <img src="/images/logo-text.webp" alt="Builtechraft" loading="eager" class="h-12 w-auto object-contain drop-shadow-md hover:scale-105 transition-transform" />
    </a>

    <nav class="hidden lg:flex items-center justify-center gap-16 transition-all duration-500 relative w-full max-w-5xl" id="desktop-menu">
        <div class="flex items-center gap-8 lg:gap-12 flex-1 justify-end">
            {/* 🟢 Le quitamos text-sm, font-bold y tracking-widest del HTML para que el CSS lo controle */}
            {leftItems.map(item => (
                <a href={item.href} class="nav-link uppercase transition-all duration-300 relative group py-2" data-target={item.id}>
                    {item.name}
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full nav-line"></span>
                </a>
            ))}

            <div class="relative py-2">
                <button id="nov-btn" class="nav-link uppercase transition-all duration-300 relative group flex items-center gap-1 cursor-pointer outline-none" data-novedades-parent>
                    Novedades
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full nav-line"></span>
                </button>
                
                <div id="nov-drop" class="absolute right-0 w-64 bg-black border border-white/10 rounded-md p-4 shadow-[0_20px_50px_rgba(0,0,0,0.8)] opacity-0 invisible scale-95 transition-all duration-300 z-50 pointer-events-none">
                    <div class="flex flex-col gap-1">
                        {novedadItems.map(item => (
                            <a href={item.href} class="submenu-link text-[11px] font-bold text-zinc-400 uppercase tracking-widest px-6 py-3 rounded-md hover:bg-white/5 hover:text-btc-orange transition-colors" data-target={item.id}>
                                {item.name}
                            </a>
                        ))}
                    </div>
                </div>
            </div>
        </div>

        <div id="center-spacer" class:list={["transition-all duration-700 ease-in-out", isMapPage ? "w-32 lg:w-48" : "w-0"]}></div>

        <div class="flex items-center gap-8 lg:gap-12 flex-1 justify-start">
            {rightItems.map(item => (
                <a href={item.href} class="nav-link uppercase transition-all duration-300 relative group py-2" data-target={item.id}>
                    {item.name}
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full nav-line"></span>
                </a>
            ))}
        </div>
    </nav>

    {/* LUNA NARANJA */}
    <div class="absolute right-6 top-1/2 -translate-y-1/2 z-20 hidden lg:block">
        <button id="theme-toggle" class="w-10 h-10 rounded-full border transition-all duration-300 flex items-center justify-center text-btc-orange border-btc-orange/30 hover:bg-btc-orange/10">
            <svg id="icon-moon" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
    </div>
  </div>
</header>

<style>
  @keyframes slideDownMenu {
      from { transform: translateY(-100%); }
      to { transform: translateY(0); }
  }

  /* === ESTADO INICIAL (EN EL HERO) === */
  #main-header.is-at-top {
      position: absolute;
      top: calc(100vh - 180px); 
      left: 0;
      background-color: transparent;
      padding-top: 1rem;
      padding-bottom: 1rem;
  }
  
  #main-header.is-at-top #nov-drop {
      bottom: 100%;
      margin-bottom: 1rem;
      transform-origin: bottom right;
  }

  /* === ESTADO SCROLL (FIJO ARRIBA) === */
  #main-header.is-scrolled {
      position: fixed;
      top: 0;
      left: 0;
      background-color: #050505;
      padding-top: 0.5rem;
      padding-bottom: 0.5rem;
      border-bottom: 1px solid rgba(255, 255, 255, 0.05);
      box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.5);
      animation: slideDownMenu 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
  }
  
  #main-header.is-scrolled #nov-drop {
      top: 100%;
      margin-top: 1rem;
      transform-origin: top right;
  }

  /* =========================================
     TAMAÑOS Y COLORES DINÁMICOS
     ========================================= */
  
  /* 1. Cuando está en el Hero (MÁS GRANDE Y GRUESO) */
  #main-header.is-at-top .nav-link { 
      color: #f97316; 
      font-size: 1.25rem;       /* 20px - Letra mucho más grande */
      font-weight: 700;         /* Máximo grosor */
      letter-spacing: 0.15em;   /* Un poco más separado para verse épico */
  }
  #main-header.is-at-top .nav-link:hover { color: #fbbf24; }
  #main-header.is-at-top .nav-line { background-color: #fbbf24 !important; }
  
  /* 2. Cuando bajas y se pega al techo (TAMAÑO NORMAL text-sm) */
  #main-header.is-scrolled .nav-link { 
      color: rgba(255, 255, 255, 0.9); 
      font-size: 0.875rem;      /* 14px - Tamaño normal */
      font-weight: 700;         /* Grosor normal */
      letter-spacing: 0.1em;
  }
  #main-header.is-scrolled .nav-link:hover { color: #f97316; }
  #main-header.is-scrolled .nav-line { background-color: #f97316 !important; }
  
  /* Otros estilos */
  .nav-link.active, .nav-link.active-parent { color: #fbbf24 !important; }
  .nav-link.active .nav-line, .nav-link.active-parent .nav-line { width: 100% !important; background-color: #fbbf24 !important; }
  .submenu-link.active-sub { color: #f97316 !important; background-color: rgba(255,255,255,0.05); }
  #nov-drop.is-open { opacity: 1; visibility: visible; scale: 1; pointer-events: auto; }
</style>

<script is:inline define:vars={{ isMapPage }}>
  document.addEventListener('DOMContentLoaded', () => {
      const header = document.getElementById('main-header');
      const logoLink = document.getElementById('logo-link');
      const centerSpacer = document.getElementById('center-spacer');
      const navLinks = document.querySelectorAll('.nav-link');
      const sections = document.querySelectorAll('section[id], div[id]');
      const htmlEl = document.documentElement;
      const themeToggleBtn = document.getElementById('theme-toggle');
      const novedadIds = ['survival', 'creativo', 'tecnico', 'modpack'];

      // Novedades
      const novBtn = document.getElementById('nov-btn');
      const novDrop = document.getElementById('nov-drop');
      novBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          novDrop.classList.toggle('is-open');
      });
      document.addEventListener('click', () => novDrop.classList.remove('is-open'));

      // Tema
      const updateThemeIcons = () => {
          const iconMoon = document.getElementById('icon-moon');
          const iconSun = document.getElementById('icon-sun');
          if (htmlEl.classList.contains('light')) {
              iconMoon.classList.add('hidden'); iconSun.classList.remove('hidden');
          } else {
              iconMoon.classList.remove('hidden'); iconSun.classList.add('hidden');
          }
      };
      updateThemeIcons();
      themeToggleBtn.addEventListener('click', () => {
          htmlEl.classList.toggle('light');
          updateThemeIcons();
          localStorage.setItem('theme', htmlEl.classList.contains('light') ? 'light' : 'dark');
      });

      if (isMapPage) {
          const currentPath = window.location.pathname;
          document.querySelectorAll('.submenu-link').forEach(link => {
              if (currentPath === link.getAttribute('href') || currentPath === link.getAttribute('href') + '/') {
                  link.classList.add('active-sub');
                  novBtn.classList.add('active-parent');
              }
          });
      }

      const handleHeaderAnimation = () => {
          if (isMapPage) return;
          const currentScroll = window.scrollY;
          const triggerHeight = window.innerHeight - 180; 

          if (currentScroll > triggerHeight) {
              header.classList.replace('is-at-top', 'is-scrolled');
              logoLink.classList.remove('opacity-0', 'scale-50', 'pointer-events-none');
              logoLink.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
              centerSpacer.classList.add('w-32', 'lg:w-48');
          } else {
              header.classList.replace('is-scrolled', 'is-at-top');
              logoLink.classList.add('opacity-0', 'scale-50', 'pointer-events-none');
              logoLink.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
              centerSpacer.classList.remove('w-32', 'lg:w-48');
          }
      };

      const handleScrollSpy = () => {
          if (isMapPage) return;
          let activeId = '';
          let maxVisibleHeight = 0;

          sections.forEach(section => {
              if (section.id === 'novedades') return;
              const rect = section.getBoundingClientRect();
              const visibleHeight = Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0);
              if (visibleHeight > 0 && visibleHeight > maxVisibleHeight) {
                  maxVisibleHeight = visibleHeight;
                  activeId = section.getAttribute('id');
              }
          });

          if (activeId) {
              navLinks.forEach(link => {
                  const target = link.getAttribute('data-target');
                  if (link.hasAttribute('data-novedades-parent')) {
                      link.classList.toggle('active-parent', novedadIds.includes(activeId));
                  } else {
                      link.classList.toggle('active', target === activeId);
                  }
              });
              document.querySelectorAll('.submenu-link').forEach(link => {
                  link.classList.toggle('active-sub', link.getAttribute('data-target') === activeId);
              });
          }
      };

      if (!isMapPage) {
          window.addEventListener('scroll', () => {
              handleHeaderAnimation();
              handleScrollSpy();
          }, { passive: true });
          handleHeaderAnimation();
          handleScrollSpy();
      }
  });
</script>