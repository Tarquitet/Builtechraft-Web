---
const leftItems = [
  { name: 'Jugar', href: '#ips' },
  { name: 'Historia', href: '#historia' },
  { name: 'Novedades', href: '#novedades' },
];

const rightItems = [
  { name: 'Normas', href: '#reglas' },
  { name: 'Staff', href: '#staff' },
  { name: 'Comunidad', href: '#discord' },
];
---

<header id="main-header" class="fixed top-0 w-full z-50 transition-transform duration-300 py-4 bg-black/40 backdrop-blur-sm border-b border-transparent">
  
  <div class="container mx-auto px-6 h-16 relative flex items-center justify-between">

    <a href="#inicio" id="logo-link" class="absolute left-0 top-1/2 -translate-y-1/2 z-20 flex items-center gap-2 group transition-all duration-500 origin-left">
        <img src="/images/logo-text.webp" alt="Builtechraft" class="h-10 md:h-12 w-auto object-contain drop-shadow-md group-hover:scale-105 transition-transform" />
    </a>

    <nav class="hidden md:flex w-full items-center transition-all duration-500 relative" id="desktop-menu">
        
        <div class="flex-1 flex justify-end items-center gap-8 lg:gap-12 transition-all duration-500 pr-8" id="menu-left">
            {leftItems.map(item => (
                <a href={item.href} class="nav-link text-sm font-bold uppercase tracking-widest text-white/90 hover:text-btc-orange transition-colors relative group py-2">
                    {item.name}
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-btc-orange transition-all group-hover:w-full"></span>
                </a>
            ))}
        </div>

        <div id="center-spacer" class="w-0 transition-all duration-500"></div>

        <div class="flex-1 flex justify-start items-center gap-8 lg:gap-12 transition-all duration-500 pl-8" id="menu-right">
            {rightItems.map(item => (
                <a href={item.href} class="nav-link text-sm font-bold uppercase tracking-widest text-white/90 hover:text-btc-orange transition-colors relative group py-2">
                    {item.name}
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 bg-btc-orange transition-all group-hover:w-full"></span>
                </a>
            ))}
        </div>
    </nav>
  </div>
</header>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
      const header = document.getElementById('main-header');
      const logoLink = document.getElementById('logo-link');
      const desktopMenu = document.getElementById('desktop-menu');
      const centerSpacer = document.getElementById('center-spacer');
      const navLinks = document.querySelectorAll('.nav-link');
      const heroSection = document.getElementById('inicio');

      if (!header) return;

      let lastScroll = 0;
      let ticking = false;

      function updateNav() {
          const currentScroll = window.scrollY;
          // Si no encuentra la sección de inicio, asume 800px
          const heroHeight = heroSection ? heroSection.offsetHeight : 800;
          const triggerPoint = heroHeight - 150; 

          // Lógica original restaurada
          if (currentScroll < 100) {
              // ESTADO 1: Arriba del todo (Hero)
              header.style.transform = 'translateY(0)';
              resetMenuToHero();
          } 
          else if (currentScroll > 100 && currentScroll < triggerPoint) {
              // ESTADO 2: Bajando por el Hero (Oculto)
              header.style.transform = 'translateY(-100%)';
          }
          else if (currentScroll >= triggerPoint) {
              // ESTADO 3: Scrolled (Sticky visible)
              header.style.transform = 'translateY(0)';
              transformMenuToScrolled();
          }

          lastScroll = currentScroll;
          ticking = false;
      }

      window.addEventListener('scroll', () => {
          if (!ticking) {
              window.requestAnimationFrame(updateNav);
              ticking = true;
          }
      });

      function resetMenuToHero() {
          header.classList.remove('bg-theme-card/95', 'backdrop-blur-xl', 'border-white/10', 'shadow-2xl', 'py-2');
          header.classList.add('py-4', 'bg-black/40', 'backdrop-blur-sm', 'border-transparent');

          if(logoLink) {
            logoLink.classList.add('left-0', 'origin-left');
            logoLink.classList.remove('left-1/2', '-translate-x-1/2', 'scale-125', 'origin-center');
          }

          if(desktopMenu) {
            desktopMenu.classList.remove('justify-center');
            desktopMenu.classList.add('justify-end'); 
          }
          
          if(centerSpacer) {
            centerSpacer.classList.remove('w-48', 'lg:w-64');
            centerSpacer.classList.add('w-0');
          }

          navLinks.forEach(link => {
              link.classList.add('text-white/90');
              link.classList.remove('text-theme-main');
          });
      }

      function transformMenuToScrolled() {
          header.classList.remove('py-4', 'bg-black/40', 'backdrop-blur-sm', 'border-transparent');
          header.classList.add('bg-theme-card/95', 'backdrop-blur-xl', 'border-white/10', 'shadow-2xl', 'py-2');
          
          if(logoLink) {
            logoLink.classList.remove('left-0', 'origin-left');
            logoLink.classList.add('left-1/2', '-translate-x-1/2', 'scale-125', 'origin-center');
          }
          
          if(desktopMenu) {
            desktopMenu.classList.remove('justify-end');
            desktopMenu.classList.add('justify-center');
          }
          
          if(centerSpacer) {
            centerSpacer.classList.remove('w-0');
            centerSpacer.classList.add('w-48', 'lg:w-64');
          }

          navLinks.forEach(link => {
              link.classList.remove('text-white/90');
              link.classList.add('text-theme-main'); 
          });
      }
  });
</script>