---
// src/components/Navbar.astro
const leftItems = [
  { name: 'Jugar', href: '#ips' },
  { name: 'Historia', href: '#historia' },
  { name: 'Novedades', href: '#novedades' },
];

const rightItems = [
  { name: 'Normas', href: '#reglas' },
  { name: 'Staff', href: '#staff' },
  { name: 'Comunidad', href: '#discord' },
];
---

<header 
  id="main-header" 
  class="hidden lg:block fixed top-0 w-full z-50 transition-all duration-500 py-6 bg-transparent border-b border-transparent is-at-top"
>
  <div class="container mx-auto px-6 h-16 relative flex items-center justify-center">

    {/* LOGO */}
    <a 
      href="#inicio" 
      id="logo-link" 
      class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 z-20 flex items-center gap-2 transition-all duration-500 opacity-0 scale-50 pointer-events-none"
    >
        <img src="/images/logo-text.webp" alt="Builtechraft" class="h-12 w-auto object-contain drop-shadow-md hover:scale-105 transition-transform" />
    </a>

    <nav class="hidden lg:flex items-center justify-center gap-16 transition-all duration-500 relative w-full max-w-5xl" id="desktop-menu">
        <div class="flex items-center gap-8 lg:gap-12 flex-1 justify-end">
            {leftItems.map(item => (
                <a 
                  href={item.href} 
                  class="nav-link text-sm font-bold uppercase tracking-widest transition-all relative group py-2"
                  data-target={item.href.replace('#', '')}
                >
                    {item.name}
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full nav-line"></span>
                </a>
            ))}
        </div>

        <div id="center-spacer" class="w-0 transition-all duration-700 ease-in-out"></div>

        <div class="flex items-center gap-8 lg:gap-12 flex-1 justify-start">
            {rightItems.map(item => (
                <a 
                  href={item.href} 
                  class="nav-link text-sm font-bold uppercase tracking-widest transition-all relative group py-2"
                  data-target={item.href.replace('#', '')}
                >
                    {item.name}
                    <span class="absolute bottom-0 left-0 w-0 h-0.5 transition-all duration-300 group-hover:w-full nav-line"></span>
                </a>
            ))}
        </div>
    </nav>

    {/* BOTÓN INTERRUPTOR DE TEMA */}
    <div class="absolute right-6 top-1/2 -translate-y-1/2 z-20 hidden lg:block">
        <button 
            id="theme-toggle"
            class="w-10 h-10 rounded-full border transition-all duration-300 flex items-center justify-center"
            aria-label="Cambiar tema"
        >
            <svg id="icon-moon" class="w-5 h-5 block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"></path></svg>
            <svg id="icon-sun" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"></path></svg>
        </button>
    </div>
  </div>
</header>

<style>
  /* --- ESTILO DEL BOTÓN DE TEMA --- */
  #main-header.is-at-top #theme-toggle {
    background-color: rgba(0, 0, 0, 0.4); 
    border-color: rgba(255, 255, 255, 0.1);
    color: #a1a1aa; 
    backdrop-filter: none; 
    -webkit-backdrop-filter: none;
  }
  #main-header.is-at-top #theme-toggle:hover {
    background-color: rgba(0, 0, 0, 0.6);
    color: #f97316; 
    border-color: rgba(249, 115, 22, 0.3);
  }

  #main-header.is-scrolled #theme-toggle {
    background-color: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.1);
    color: #a1a1aa;
  }
  #main-header.is-scrolled #theme-toggle:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #f97316;
  }

  /* --- COLORES DE LOS LINKS --- */
  #main-header.is-at-top .nav-link { color: #f97316; }
  #main-header.is-at-top .nav-link:hover { color: #fbbf24; }
  #main-header.is-at-top .nav-line { background-color: #fbbf24 !important; }

  #main-header.is-scrolled .nav-link { color: rgba(255, 255, 255, 0.9); }
  #main-header.is-scrolled .nav-link:hover { color: #f97316; }
  #main-header.is-scrolled .nav-line { background-color: #f97316 !important; }

  .nav-link.active {
    color: #fbbf24 !important;
  }
  .nav-link.active .nav-line {
    width: 100% !important;
    background-color: #fbbf24 !important;
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
      const header = document.getElementById('main-header');
      const logoLink = document.getElementById('logo-link');
      const centerSpacer = document.getElementById('center-spacer');
      const navLinks = document.querySelectorAll('.nav-link');
      const sections = document.querySelectorAll('section[id]');
      const heroSection = document.getElementById('inicio');
      const themeToggleBtn = document.getElementById('theme-toggle');
      const iconMoon = document.getElementById('icon-moon');
      const iconSun = document.getElementById('icon-sun');
      const htmlEl = document.documentElement;

      const updateThemeIcons = () => {
          if (htmlEl.classList.contains('light')) {
              iconMoon.classList.add('hidden');
              iconMoon.classList.remove('block');
              iconSun.classList.remove('hidden');
              iconSun.classList.add('block');
          } else {
              iconMoon.classList.remove('hidden');
              iconMoon.classList.add('block');
              iconSun.classList.add('hidden');
              iconSun.classList.remove('block');
          }
      };

      updateThemeIcons();

      themeToggleBtn.addEventListener('click', () => {
          htmlEl.classList.toggle('light');
          updateThemeIcons();
          localStorage.setItem('theme', htmlEl.classList.contains('light') ? 'light' : 'dark');
          window.dispatchEvent(new Event('theme-changed'));
      });
      
      window.addEventListener('theme-changed', updateThemeIcons);

      const handleHeaderAnimation = () => {
          const currentScroll = window.scrollY;
          const triggerHeight = heroSection ? (heroSection.offsetHeight - 150) : 600;

          if (currentScroll > triggerHeight) {
              header.classList.replace('is-at-top', 'is-scrolled');
              header.classList.remove('bg-transparent', 'py-6', 'border-transparent');
              header.classList.add('bg-black/90', 'backdrop-blur-md', 'py-2', 'border-white/5', 'shadow-2xl');
              logoLink.classList.remove('opacity-0', 'scale-50', 'pointer-events-none');
              logoLink.classList.add('opacity-100', 'scale-100', 'pointer-events-auto');
              centerSpacer.classList.add('w-32', 'lg:w-48');
          } else {
              header.classList.replace('is-scrolled', 'is-at-top');
              header.classList.add('bg-transparent', 'py-6', 'border-transparent');
              header.classList.remove('bg-black/90', 'backdrop-blur-md', 'py-2', 'border-white/5', 'shadow-2xl');
              logoLink.classList.add('opacity-0', 'scale-50', 'pointer-events-none');
              logoLink.classList.remove('opacity-100', 'scale-100', 'pointer-events-auto');
              centerSpacer.classList.remove('w-32', 'lg:w-48');
          }
      };

      const handleScrollSpy = () => {
          let maxVisibleSectionId = '';
          let maxVisibleHeight = 0;
          if ((window.innerHeight + window.scrollY) >= document.body.offsetHeight - 50) {
              const lastLink = navLinks[navLinks.length - 1];
              if (lastLink) {
                  navLinks.forEach(link => link.classList.remove('active'));
                  lastLink.classList.add('active');
                  return;
              }
          }
          sections.forEach(section => {
              const rect = section.getBoundingClientRect();
              const visibleHeight = Math.min(rect.bottom, window.innerHeight) - Math.max(rect.top, 0);
              if (visibleHeight > 0 && visibleHeight > maxVisibleHeight) {
                  maxVisibleHeight = visibleHeight;
                  maxVisibleSectionId = section.getAttribute('id');
              }
          });
          if (maxVisibleSectionId) {
              navLinks.forEach(link => {
                  link.classList.toggle('active', link.getAttribute('data-target') === maxVisibleSectionId);
              });
          }
      };

      window.addEventListener('scroll', () => {
          handleHeaderAnimation();
          handleScrollSpy();
      }, { passive: true });

      handleHeaderAnimation();
      handleScrollSpy();
  });
</script>