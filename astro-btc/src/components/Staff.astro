---
// src/components/Staff.astro
import fs from 'node:fs';
import path from 'node:path';

// --- CONFIGURACIÓN DE ROLES ---
const ROLE_CONFIG = {
    'Líder': { 
        text: 'text-btc-orange', 
        gradient: 'bg-gradient-to-br from-btc-orange to-btc-yellow' 
    },
    'Admin': { 
        text: 'text-red-500', 
        gradient: 'bg-gradient-to-br from-red-600 to-red-400' 
    },
    'Vigilante': { 
        text: 'text-blue-500', 
        gradient: 'bg-gradient-to-br from-blue-600 to-cyan-400' 
    },
    'default': { 
        text: 'text-zinc-400', 
        gradient: 'bg-gradient-to-br from-zinc-400 to-zinc-200' 
    },
    'retired': { 
        text: 'text-zinc-600', 
        gradient: 'bg-zinc-800' 
    }
};

// --- LÓGICA DE IMÁGENES ---
const staffFolder = 'images/staff';
const directoryPath = path.join(process.cwd(), 'public', staffFolder);

const findMemberImage = (memberName) => {
    try {
        const files = fs.readdirSync(directoryPath);
        const normalizedName = memberName.toLowerCase().replace(/\s+/g, '');
        const matchingFile = files.find(file => file.split('.')[0].toLowerCase() === normalizedName);
        if (matchingFile) return `/${staffFolder}/${matchingFile}`;
    } catch (e) { }
    return `https://ui-avatars.com/api/?name=${memberName}&background=18181b&color=fff&size=200&font-size=0.33`;
};

const rawTeam = [
    { name: "Tarquitet", role: "Líder" },
    { name: "Aguila003", role: "Admin" },
    { name: "Soshy", role: "Admin" },
    { name: "KittyCupcake", role: "Vigilante" },
    { name: "SweetHeart", role: "retired" },
    { name: "Dip", role: "retired" },
    { name: "snowing", role: "retired" },
    { name: "UnPocoDeRuch", role: "retired" },
];

const team = rawTeam.map(member => {
    const isRetired = member.role.toLowerCase() === 'retired' || member.retired;
    const roleKey = isRetired 
        ? 'retired' 
        : Object.keys(ROLE_CONFIG).find(key => member.role.includes(key)) || 'default';
        
    const style = ROLE_CONFIG[roleKey];
    const displayRole = isRetired ? 'Staff Retirado' : member.role;

    return {
        ...member,
        img: findMemberImage(member.name),
        textColor: style.text,
        gradientClass: style.gradient, 
        isRetired: isRetired,
        displayRole: displayRole
    };
});
---

<section id="staff" class="py-24 bg-[#272727] relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-20">
            <h2 class="text-4xl md:text-5xl font-display font-bold uppercase tracking-tight text-btc-yellow">
                Nuestro <span class="text-white">Staff</span>
            </h2>
            <p class="text-zinc-300 text-lg max-w-3xl mx-auto mt-6 leading-relaxed">
                Conoce a nuestro equipo que incentiva las mentes creativas de quienes deseen entrar
            </p>
        </div>

        <div class="flex flex-wrap justify-center gap-10 md:gap-x-16 md:gap-y-20 max-w-6xl mx-auto">
            {team.map((member) => (
                <div class="flex flex-col items-center gap-5 group w-[140px] md:w-auto">
                    
                    {/* 1. ESTRUCTURA PLANA: Un solo contenedor con padding en lugar de 3 absolutos */}
                    <div class="relative w-36 h-36 md:w-44 md:h-44 rounded-full p-[3px] bg-zinc-700 shadow-md group-hover:shadow-lg transition-shadow duration-300">
                        
                        {/* 2. GRADIENTE: Solo anima la opacidad, la propiedad más barata para el navegador */}
                        {!member.isRetired && (
                            <div class={`absolute inset-0 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${member.gradientClass}`}></div>
                        )}

                        {/* 3. IMAGEN: relative en lugar de absolute, se ajusta al padding del padre */}
                        <div class="relative w-full h-full rounded-full overflow-hidden bg-[#18181b] z-10">
                            <img 
                                src={member.img} 
                                alt={member.name} 
                                {/* CAMBIO CLAVE: Quitamos transition-all y usamos solo lo que cambia (filter y opacity) */}
                                class={`w-full h-full object-cover transition-[filter,opacity] duration-300 
                                    ${member.isRetired 
                                        ? 'grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100' 
                                        : ''
                                    }`} 
                                loading="lazy"
                            />
                        </div>

                    </div>

                    <div class="text-center z-10">
                        <h4 class={`font-display font-bold text-xl tracking-wider transition-colors duration-200 uppercase
                            ${member.isRetired 
                                ? 'text-zinc-600 line-through decoration-zinc-700 group-hover:text-zinc-400 group-hover:no-underline' 
                                : 'text-white'
                            }`}>
                            {member.name}
                        </h4>
                        
                        <div class={`text-[10px] md:text-xs uppercase font-bold tracking-[0.2em] mt-2 opacity-80 transition-opacity duration-200 group-hover:opacity-100
                            ${member.textColor} 
                            ${member.isRetired ? 'italic' : ''} 
                        `}>
                            {member.displayRole}
                        </div>
                    </div>

                </div>
            ))}
        </div>
    </div>
</section>