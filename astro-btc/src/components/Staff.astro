---
import fs from 'node:fs';
import path from 'node:path';
// Importamos los datos desde el nuevo JSON
import staffData from '../data/staff.json';

const FOLDER_MAP = {
    'lideres': { 
        displayName: 'Líder', 
        text: 'text-btc-orange', 
        gradient: 'bg-gradient-to-br from-btc-orange to-btc-yellow',
        colorHex: 'f59e0b',
        isRetired: false 
    },
    'admins': { 
        displayName: 'Admin', 
        text: 'text-red-500', 
        gradient: 'bg-gradient-to-br from-red-600 to-red-400',
        colorHex: 'ef4444',
        isRetired: false 
    },
    'vigilantes': { 
        displayName: 'Vigilante', 
        text: 'text-blue-500', 
        gradient: 'bg-gradient-to-br from-blue-600 to-cyan-400',
        colorHex: '3b82f6',
        isRetired: false 
    },
    'retirados': { 
        displayName: 'Staff Retirado', 
        text: 'text-zinc-600', 
        gradient: 'bg-zinc-800',
        colorHex: '52525b',
        isRetired: true 
    }
};

const baseStaffPath = 'images/staff';
const absolutePath = path.join(process.cwd(), 'public', baseStaffPath);

let team = [];
let processedIds = new Set();

// 1. Escaneamos carpetas físicas (La carpeta manda sobre el rango)
try {
    Object.keys(FOLDER_MAP).forEach(folder => {
        const folderPath = path.join(absolutePath, folder);
        if (fs.existsSync(folderPath)) {
            const files = fs.readdirSync(folderPath);
            files.forEach(file => {
                const id = path.parse(file).name.toLowerCase();
                const config = FOLDER_MAP[folder];
                const info = staffData[id] || { name: path.parse(file).name };

                processedIds.add(id);
                team.push({
                    name: info.name,
                    displayRole: config.displayName,
                    img: `/${baseStaffPath}/${folder}/${file}`,
                    textColor: config.text,
                    gradientClass: config.gradient,
                    isRetired: config.isRetired,
                    bio: info.bio || "Miembro del equipo de Builtechraft.",
                    socials: info.socials || {}
                });
            });
        }
    });
} catch (e) { console.error("Error Staff:", e); }

// 2. Añadimos a los del JSON que no tienen foto (Fallback automático a Retirados)
Object.keys(staffData).forEach(id => {
    if (!processedIds.has(id)) {
        const info = staffData[id];
        const config = FOLDER_MAP['retirados'];

        team.push({
            name: info.name,
            displayRole: config.displayName,
            img: `https://ui-avatars.com/api/?name=${encodeURIComponent(info.name)}&background=18181b&color=${config.colorHex}&size=250&font-size=0.35&bold=true`,
            textColor: config.text,
            gradientClass: config.gradient,
            isRetired: true,
            bio: info.bio || "Miembro retirado del staff.",
            socials: {} 
        });
    }
});
---

<section id="staff" class="py-24 bg-[#272727] relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        <div class="text-center mb-20">
            <h2 class="text-4xl md:text-5xl font-display font-bold uppercase tracking-tight text-btc-yellow">
                Nuestro <span class="text-white">Staff</span>
            </h2>
            <p class="text-zinc-300 text-lg max-w-3xl mx-auto mt-6 leading-relaxed">
                Conoce a nuestro equipo que incentiva las mentes creativas
            </p>
        </div>

        <div class="flex flex-wrap justify-center gap-10 md:gap-x-16 md:gap-y-20 max-w-6xl mx-auto">
            {team.map((member) => (
                <button 
                    class="flex flex-col items-center gap-5 group w-[140px] md:w-auto cursor-pointer focus:outline-none rounded-3xl p-2 transition-transform hover:scale-105"
                    onclick={`openStaffModal('${member.name}')`}
                >
                    <div class="relative w-36 h-36 md:w-44 md:h-44 rounded-full p-[3px] bg-zinc-700 shadow-md group-hover:shadow-[0_0_20px_rgba(255,255,255,0.1)] transition-all duration-300">
                        {!member.isRetired && (
                            <div class={`absolute inset-0 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-300 ${member.gradientClass}`}></div>
                        )}
                        <div class="relative w-full h-full rounded-full overflow-hidden bg-[#18181b] z-10">
                            <img src={member.img} alt={member.name} class={`w-full h-full object-cover transition-all duration-300 ${member.isRetired ? 'grayscale opacity-50 group-hover:grayscale-0 group-hover:opacity-100' : ''}`} loading="lazy" />
                        </div>
                    </div>
                    <div class="text-center z-10">
                        <h4 class={`font-display font-bold text-xl tracking-wider uppercase ${member.isRetired ? 'text-zinc-600 line-through decoration-zinc-700 group-hover:no-underline' : 'text-white'}`}>
                            {member.name}
                        </h4>
                        <div class={`text-[10px] md:text-xs uppercase font-bold tracking-[0.2em] mt-2 opacity-80 ${member.textColor}`}>
                            {member.displayRole}
                        </div>
                    </div>
                </button>
            ))}
        </div>
    </div>
</section>

<script id="staff-data" type="application/json" set:html={JSON.stringify(team)}></script>

<dialog id="staff-modal" class="bg-transparent m-auto w-full h-full max-w-none max-h-none backdrop:bg-black/80 backdrop:backdrop-blur-sm fixed inset-0 z-50 overflow-hidden opacity-0 pointer-events-none transition-opacity duration-300 open:pointer-events-auto">
    <div class="flex items-center justify-center min-h-screen px-4">
        <div class="fixed inset-0 cursor-pointer" onclick="closeStaffModal()"></div>
        <div class="relative bg-zinc-900 border border-white/10 rounded-3xl overflow-hidden shadow-2xl transform transition-all sm:max-w-lg w-full scale-95 opacity-0 modal-content duration-300">
            <button onclick="closeStaffModal()" class="absolute top-5 right-5 text-zinc-400 hover:text-white z-20 bg-black/40 p-2 rounded-full border border-white/5">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
            </button>
            <div id="modal-header" class="h-32 w-full relative">
                <div class="absolute inset-0 bg-gradient-to-b from-black/60 to-zinc-900 z-10"></div>
            </div>
            <div class="px-6 pb-8 relative z-20 -mt-16 flex flex-col items-center">
                <div class="w-32 h-32 rounded-full p-[3px] bg-zinc-800 shadow-xl mb-4 relative">
                    <div id="modal-img-border" class="absolute inset-0 rounded-full opacity-50"></div>
                    <img id="modal-img" src="" class="relative w-full h-full rounded-full object-cover bg-black" />
                </div>
                <h3 id="modal-name" class="text-3xl font-display font-bold text-white uppercase mb-1 tracking-tight">Nombre</h3>
                <span id="modal-role" class="text-[10px] font-bold uppercase tracking-[0.2em] px-4 py-1.5 bg-black/30 rounded-full border border-white/5 mb-6">Rol</span>
                <p id="modal-bio" class="text-zinc-300 text-sm text-center leading-relaxed mb-8 max-w-sm"></p>
                <div id="modal-socials-container" class="w-full">
                    <div class="w-full h-px bg-white/5 mb-6"></div>
                    <div id="modal-socials" class="flex flex-wrap justify-center gap-3"></div>
                </div>
            </div>
        </div>
    </div>
</dialog>

<script is:inline>
    const staffModal = document.getElementById('staff-modal');
    const modalContent = staffModal.querySelector('.modal-content');
    const teamData = JSON.parse(document.getElementById('staff-data').textContent);

    window.openStaffModal = (name) => {
        const m = teamData.find(member => member.name === name);
        if (!m) return;

        document.getElementById('modal-name').textContent = m.name;
        document.getElementById('modal-role').textContent = m.displayRole;
        document.getElementById('modal-role').className = `text-[10px] font-bold uppercase tracking-[0.2em] px-4 py-1.5 bg-black/30 rounded-full border border-white/5 mb-6 ${m.textColor}`;
        document.getElementById('modal-bio').textContent = m.bio;
        
        const img = document.getElementById('modal-img');
        img.src = m.img;
        img.className = `relative w-full h-full rounded-full object-cover bg-black ${m.isRetired ? 'grayscale opacity-50' : ''}`;

        const header = document.getElementById('modal-header');
        const border = document.getElementById('modal-img-border');
        header.className = `h-32 w-full relative ${m.gradientClass}`;
        border.className = `absolute inset-0 rounded-full opacity-50 ${m.gradientClass}`;

        const container = document.getElementById('modal-socials-container');
        const socialsDiv = document.getElementById('modal-socials');
        socialsDiv.innerHTML = '';

        if (m.isRetired || !m.socials || Object.keys(m.socials).length === 0) {
            container.classList.add('hidden');
        } else {
            container.classList.remove('hidden');
            Object.entries(m.socials).forEach(([platform, link]) => {
                const a = document.createElement('a');
                const isDiscord = platform.toLowerCase() === 'discord';
                a.href = isDiscord ? '#' : link;
                if (!isDiscord) a.target = '_blank';
                a.className = 'px-5 py-2.5 bg-white/5 hover:bg-btc-orange border border-white/10 hover:border-btc-orange rounded-xl text-[10px] font-bold uppercase tracking-widest text-zinc-300 hover:text-white transition-all duration-300';
                
                if (isDiscord) {
                    a.onclick = (e) => {
                        e.preventDefault();
                        navigator.clipboard.writeText(link);
                        const oldText = a.textContent;
                        a.textContent = '¡Copiado!';
                        setTimeout(() => a.textContent = oldText, 2000);
                    };
                }
                a.textContent = platform.charAt(0).toUpperCase() + platform.slice(1);
                socialsDiv.appendChild(a);
            });
        }

        staffModal.showModal();
        staffModal.classList.remove('opacity-0', 'pointer-events-none');
        setTimeout(() => {
            modalContent.classList.remove('scale-95', 'opacity-0');
            modalContent.classList.add('scale-100', 'opacity-100');
        }, 10);
    };

    window.closeStaffModal = () => {
        modalContent.classList.remove('scale-100', 'opacity-100');
        modalContent.classList.add('scale-95', 'opacity-0');
        staffModal.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => staffModal.close(), 300);
    };
</script>