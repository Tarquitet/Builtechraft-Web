---
// src/components/ip/Steps.astro
import links from '../../data/links.json';
import stepsData from '../../data/steps.json';

// Helper mejorado: soporta rutas con puntos y búsqueda recursiva en categorías
const getLink = (key: string | undefined | null): string => {
    if (!key) return '';
    const l = links as any;
    
    // 1) Si tiene puntos, es una ruta explícita: "launchers.prism.url"
    if (key.includes('.')) {
        const val = key.split('.').reduce((acc, part) => (acc == null ? acc : acc[part]), l);
        return typeof val === 'string' ? val : '';
    }
    
    // 2) Búsqueda recursiva por nombre de llave (para keys simples)
    const find = (obj: any): string | null => {
        for (const [k, v] of Object.entries(obj)) {
            if (k === key && typeof v === 'string') return v;
            if (typeof v === 'object' && v !== null) {
                const r = find(v);
                if (r) return r;
            }
        }
        return null;
    };
    
    return find(l) || '';
};
---

<section class="steps-section">
    <div class="container mx-auto px-6 max-w-4xl">
        <div class="text-center mb-12">
            <h2 class="steps-title">
                Conexión <span class="text-btc-orange">Paso a Paso</span>
            </h2>
        </div>

        {/* TABS DE PLATAFORMA */}
        <div class="flex justify-center gap-4 mb-8" id="platform-tabs">
            <button class="step-tab-btn steps-tab-active" data-target="java">
                Java Edition
            </button>
            <button id="bedrock-tab-btn" class="step-tab-btn hidden steps-tab-inactive" data-target="bedrock">
                 Bedrock (Móvil / PC)
            </button>
        </div>

        <div class="card-retro mb-12">
            <div id="steps-container-java" class="flex flex-col gap-6">
                {stepsData.java.map((step, index) => {
                    const linkUrl = step.linkKey ? getLink(step.linkKey) : '';
                    return (
                        <div class="step-list-item flex flex-col md:flex-row gap-4">
                            <div class="step-number shrink-0">{index + 1}</div>
                            <div class="flex flex-col w-full pt-1">
                                <p class="text-theme-muted text-sm md:text-base font-medium leading-relaxed">
                                    {step.text}
                                    {linkUrl && (
                                        <a 
                                            href={linkUrl} 
                                            target="_self" 
                                            rel="noopener noreferrer"
                                            class="text-btc-orange hover:text-theme-main font-bold text-xs uppercase tracking-widest ml-1 transition-colors underline underline-offset-2"
                                        >
                                            {step.linkLabel || 'Saber más'}
                                        </a>
                                    )}
                                </p>
                                {step.image && (
                                    <div class="mt-4 overflow-hidden border-theme-4 max-w-lg bg-theme-alternate shadow-xl">
                                        <img src={step.image} alt={`Paso Java ${index + 1}`} class="w-full h-auto object-cover" loading="lazy" />
                                    </div>
                                )}
                            </div>
                        </div>
                    );
                })}
            </div>

            <div id="steps-container-bedrock" class="hidden flex-col gap-6">
                {stepsData.bedrock.map((step, index) => {
                    const linkUrl = step.linkKey ? getLink(step.linkKey) : '';
                    return (
                        <div class="step-list-item flex flex-col md:flex-row gap-4">
                            <div class="step-number shrink-0">{index + 1}</div>
                            <div class="flex flex-col w-full pt-1">
                                <p class="text-theme-muted text-sm md:text-base font-medium leading-relaxed">
                                    {step.text}
                                    {linkUrl && (
                                        <a 
                                            href={linkUrl} 
                                            target="_self" 
                                            rel="noopener noreferrer"
                                            class="text-blue-500 hover:text-theme-main font-bold text-xs uppercase tracking-widest ml-1 transition-colors underline underline-offset-2"
                                        >
                                            {step.linkLabel || 'Saber más'}
                                        </a>
                                    )}
                                </p>
                                {step.image && (
                                    <div class="mt-4 overflow-hidden border-theme-1 max-w-lg bg-theme-alternate">
                                        <img src={step.image} alt={`Paso Bedrock ${index + 1}`} class="w-full h-auto object-cover" loading="lazy" />
                                    </div>
                                )}
                            </div>
                        </div>
                    );
                })}
            </div>
        </div>

        {/* PREGUNTA Y TOGGLE DE MUNDO */}
        <div class="text-center mb-6">
            <h3 class="text-lg md:text-xl font-display font-bold text-theme-main mb-4">
                ¿A qué servidor quieres entrar?
            </h3>
            <div class="flex items-center justify-center gap-4">
                <span id="label-survival" class="toggle-label toggle-label-active">
                    Survival
                </span>
                <button
                    id="world-toggle"
                    type="button"
                    role="switch"
                    aria-checked="false"
                    aria-label="Cambiar entre Survival y Creativo"
                    class="toggle-switch"
                >
                    <span class="toggle-thumb"></span>
                </button>
                <span id="label-creative" class="toggle-label toggle-label-inactive">
                    Creativo
                </span>
            </div>
        </div>

        <div class="steps-ip-box">
            <div id="java-display-container" class="flex flex-col md:flex-row items-center justify-between gap-6">
                <div class="flex flex-col w-full text-center md:text-left">
                    <span class="steps-ip-label">Dirección IP (Java) - <span id="world-label-java">Survival</span></span>
                    <code id="step-java-ip" class="text-2xl md:text-3xl text-theme-main font-mono font-bold select-all">Cargando...</code>
                </div>
                <button onclick="window.copyGeneric('step-java-ip', this)" class="btn-copy-ip">
                    Copiar IP
                </button>
            </div>

            <div id="bedrock-display-container" class="hidden flex-col gap-5">
                <div class="flex flex-col md:flex-row items-center justify-between gap-4 p-4 bg-theme-alternate border-theme-4 shadow-xl">
                    <div class="flex flex-col w-full text-center md:text-left">
                        <span class="steps-ip-label">Dirección IP (Bedrock) - <span id="world-label-bedrock">Survival</span></span>
                        <code id="step-bedrock-ip" class="text-xl md:text-2xl text-theme-main font-mono font-bold select-all">Cargando...</code>
                    </div>
                    <button onclick="window.copyGeneric('step-bedrock-ip', this)" class="btn-copy-ip-bedrock">
                        Copiar IP
                    </button>
                </div>
                <div class="flex flex-col md:flex-row items-center justify-between gap-4 p-4 bg-theme-alternate border-theme-4 shadow-xl">
                    <div class="flex flex-col w-full text-center md:text-left">
                        <span class="steps-ip-label">Puerto (Bedrock)</span>
                        <code id="step-bedrock-port" class="text-xl md:text-2xl text-blue-500 font-mono font-bold select-all">19132</code>
                    </div>
                    <button onclick="window.copyGeneric('step-bedrock-port', this)" class="btn-copy-ip-bedrock">
                        Copiar Puerto
                    </button>
                </div>
            </div>
        </div>

    </div>
</section>

<script is:inline>
    let serverConfig = { 
        survival: {
            javaIp: 'Cargando...', 
            bedrockIp: 'Cargando...'
        },
        creative: {
            javaIp: 'Cargando...', 
            bedrockIp: 'Cargando...'
        },
        port: '19132',
        currentPlatform: 'java',
        currentWorld: 'survival'
    };

    function updateDisplay() {
        const { currentPlatform, currentWorld } = serverConfig;
        const javaIpBox = document.getElementById('java-display-container');
        const bedrockIpBox = document.getElementById('bedrock-display-container');
        const javaSteps = document.getElementById('steps-container-java');
        const bedrockSteps = document.getElementById('steps-container-bedrock');
        const worldLabelJava = document.getElementById('world-label-java');
        const worldLabelBedrock = document.getElementById('world-label-bedrock');

        // Actualizar labels de mundo
        const worldName = currentWorld === 'survival' ? 'Survival' : 'Creativo';
        if (worldLabelJava) worldLabelJava.textContent = worldName;
        if (worldLabelBedrock) worldLabelBedrock.textContent = worldName;

        if (currentPlatform === 'java') {
            javaIpBox.style.display = 'flex';
            bedrockIpBox.style.display = 'none';
            
            javaSteps.classList.remove('hidden');
            javaSteps.classList.add('flex');
            bedrockSteps.classList.remove('flex');
            bedrockSteps.classList.add('hidden');
            
            document.getElementById('step-java-ip').innerText = serverConfig[currentWorld].javaIp;
        } else {
            javaIpBox.style.display = 'none';
            bedrockIpBox.style.display = 'flex';
            
            javaSteps.classList.remove('flex');
            javaSteps.classList.add('hidden');
            bedrockSteps.classList.remove('hidden');
            bedrockSteps.classList.add('flex');

            document.getElementById('step-bedrock-ip').innerText = serverConfig[currentWorld].bedrockIp;
            document.getElementById('step-bedrock-port').innerText = serverConfig.port;
        }
    }

    // Listener para configuración del servidor
    window.addEventListener('btc:config-loaded', (e) => {
        const data = e.detail;
        
        // SURVIVAL
        serverConfig.survival.javaIp = data.JavaSmp || serverConfig.survival.javaIp;
        serverConfig.survival.bedrockIp = data.BedrockSmp || serverConfig.survival.bedrockIp;
        
        // CREATIVO
        serverConfig.creative.javaIp = data.JavaCreative || serverConfig.creative.javaIp;
        serverConfig.creative.bedrockIp = data.BedrockCreative || serverConfig.creative.bedrockIp;
        
        // Puerto
        serverConfig.port = data.BedrockPort || serverConfig.port;

        // Mostrar tab de Bedrock si hay puerto
        if (data.isBedrock === true) {
            document.getElementById('bedrock-tab-btn')?.classList.remove('hidden');
        }

        updateDisplay();
    });

    // Tabs de plataforma (Java/Bedrock)
    document.querySelectorAll('#platform-tabs .step-tab-btn').forEach(tab => {
        tab.addEventListener('click', (e) => {
            document.querySelectorAll('#platform-tabs .step-tab-btn').forEach(t => {
                t.classList.remove('steps-tab-active');
                t.classList.add('steps-tab-inactive');
            });
            const target = e.currentTarget;
            target.classList.remove('steps-tab-inactive');
            target.classList.add('steps-tab-active');
            
            serverConfig.currentPlatform = target.getAttribute('data-target') || 'java';
            updateDisplay();
        });
    });

    // Toggle de mundo (Survival ↔ Creativo)
    const worldToggle = document.getElementById('world-toggle');
    const labelSurvival = document.getElementById('label-survival');
    const labelCreative = document.getElementById('label-creative');

    if (worldToggle) {
        worldToggle.addEventListener('click', () => {
            const isSurvival = serverConfig.currentWorld === 'survival';
            const newWorld = isSurvival ? 'creative' : 'survival';
            
            // Actualizar estado
            serverConfig.currentWorld = newWorld;
            
            // Actualizar visual del toggle
            worldToggle.setAttribute('aria-checked', isSurvival ? 'true' : 'false');
            
            // Actualizar labels
            if (newWorld === 'survival') {
                labelSurvival.classList.replace('toggle-label-inactive', 'toggle-label-active');
                labelCreative.classList.replace('toggle-label-active', 'toggle-label-inactive');
            } else {
                labelSurvival.classList.replace('toggle-label-active', 'toggle-label-inactive');
                labelCreative.classList.replace('toggle-label-inactive', 'toggle-label-active');
            }
            
            updateDisplay();
        });
    }

    // Función para copiar al portapapeles
    window.copyGeneric = async function(elementId, btnElement) {
        const textEl = document.getElementById(elementId);
        if (!textEl || !btnElement) return;

        await navigator.clipboard.writeText(textEl.innerText);
        const originalText = btnElement.innerText;
        
        btnElement.innerText = '¡COPIADO!';
        btnElement.classList.add('bg-green-500', 'text-white', 'border-green-500');
        btnElement.classList.remove('bg-white/10', 'hover:bg-btc-orange', 'hover:bg-blue-500');

        setTimeout(() => {
            btnElement.innerText = originalText;
            btnElement.classList.remove('bg-green-500', 'text-white', 'border-green-500');
            btnElement.classList.add('bg-white/10');
            if (elementId.includes('bedrock')) {
                btnElement.classList.add('hover:bg-blue-500');
            } else {
                btnElement.classList.add('hover:bg-btc-orange');
            }
        }, 2000);
    }
</script>