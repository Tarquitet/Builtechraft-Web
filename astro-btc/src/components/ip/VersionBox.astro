---
// src/components/ip/VersionBox.astro
---
<div id="version-box-container" class="hidden mt-2 p-3 bg-emerald-500/10 border-2 border-emerald-500/30 items-center justify-center gap-3 rounded-xl">
    <span class="text-emerald-400 text-lg">✨</span>
    <div class="flex flex-col text-left">
        <p id="version-box-title" class="text-emerald-400 text-[10px] font-bold uppercase tracking-widest m-0">Versiones soportadas</p>
        <p id="version-box-text" class="text-white text-xs font-mono font-bold mt-0.5">Cargando...</p>
    </div>
</div>

<script>
    let javaMin = '';
    let javaMax = '';
    let bedrockVer = '';
    let configReady = false;

    // Guardamos las versiones cuando llegan del TSV
    window.addEventListener('btc:config-loaded', (e: any) => {
        javaMin = e.detail["JavaMin"];
        javaMax = e.detail["JavaMax"];
        bedrockVer = e.detail["BedrockVer"];
        configReady = true;
    });

    // Armamos la caja dependiendo de las características
    window.addEventListener('btc:features-loaded', (e: any) => {
        if (!configReady) return;

        const { isBedrock, isMultiVersion } = e.detail;
        const container = document.getElementById('version-box-container');
        const titleEl = document.getElementById('version-box-title');
        const textEl = document.getElementById('version-box-text');

        if (!container || !titleEl || !textEl) return;

        if (isMultiVersion && isBedrock) {
            titleEl.innerText = 'Multi-Versión + Bedrock';
            const jTxt = (javaMax && javaMax !== javaMin) ? `${javaMin} ➔ ${javaMax}` : `${javaMin}+`;
            textEl.innerText = `Java: ${jTxt} + ${bedrockVer}`;
            container.classList.remove('hidden');
            container.classList.add('flex');
            
        } else if (isMultiVersion) {
            titleEl.innerText = 'Soporte Multi-Versión';
            textEl.innerText = (javaMax && javaMax !== javaMin) ? `Java: ${javaMin} ➔ ${javaMax}` : `Java: ${javaMin}+`;
            container.classList.remove('hidden');
            container.classList.add('flex');

        } else if (isBedrock) {
            titleEl.innerText = 'Soporte Bedrock Activo';
            textEl.innerText = `${bedrockVer}`;
            container.classList.remove('hidden');
            container.classList.add('flex');

        } else {
            // Si es un server puramente Vanilla sin ViaVersion ni Geyser, se oculta
            container.classList.add('hidden');
            container.classList.remove('flex');
        }
    });
</script>