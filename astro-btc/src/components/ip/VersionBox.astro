---
// src/components/ip/VersionBox.astro
---
<div id="version-box-container" class="hidden mt-2 p-3 bg-emerald-500/10 border-2 border-emerald-500/30 items-center justify-center gap-3">
    <span class="text-emerald-400 text-lg animate-pulse">✨</span>
    <div class="flex flex-col text-left">
        <p class="text-emerald-400 text-[10px] font-bold uppercase tracking-widest m-0">Soporte Multiversión Activo</p>
        <p id="version-box-text" class="text-white text-xs font-mono font-bold mt-0.5">Cargando versiones...</p>
    </div>
</div>

<script is:inline>
    // Escuchamos el evento inteligente que envía ServerStatus.jsx
    window.addEventListener('btc:server-versions', (e) => {
        const { javaMin, javaMax } = e.detail;
        const versionTextEl = document.getElementById('version-box-text');
        
        if (versionTextEl && javaMin) {
            // Si hay un rango, mostramos (Ej: 1.20.5 - 1.21.11). Si no, solo mostramos la base.
            if(javaMax && javaMax !== javaMin) {
                versionTextEl.innerText = `${javaMin} ➔ ${javaMax}`;
            } else {
                versionTextEl.innerText = `Versión ${javaMin}+`;
            }
        }
    });
</script>