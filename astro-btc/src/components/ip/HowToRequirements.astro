---
// src/components/ip/HowToRequirements.astro

import links from '../../data/links.json';
import requirements from '../../data/requirements.json';

const getLink = (key: string | undefined | null): string => {
    if (!key) return '';
    const l = links as any;
    if (key.includes('.')) {
        const val = key.split('.').reduce((acc, part) => (acc == null ? acc : acc[part]), l);
        return typeof val === 'string' ? val : '';
    }
    const find = (obj: any): string | null => {
        for (const [k, v] of Object.entries(obj)) {
            if (k === key && typeof v === 'string') return v;
            if (typeof v === 'object' && v !== null) {
                const r = find(v);
                if (r) return r;
            }
        }
        return null;
    };
    return find(l) || '';
};

const colorClasses: Record<string, string> = {
    green: 'req-icon-green',
    blue: 'req-icon-blue',
    yellow: 'req-icon-yellow',
    orange: 'req-icon-orange',
    purple: 'req-icon-purple'
};
---

<section class="howto-req-section py-16">
    <div class="container mx-auto px-6 max-w-5xl">
        <h2 class="text-3xl font-display font-bold text-theme-main text-center mb-12 uppercase tracking-tight">
            Lo que necesitas para jugar
        </h2>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-12 text-center md:text-left">
            {requirements.map((req) => {
                const linkUrl = req.keyLink ? getLink(req.keyLink) : '';
                const iconClass = colorClasses[req.iconColor] || 'req-icon-green';
                
                return (
                    <div class="flex flex-col md:flex-row items-center md:items-start gap-6">
                        <div class={`req-icon-box ${iconClass}`}>
                            <Fragment set:html={req.iconSvg} />
                        </div>
                        <div>
                            <h3 class="req-title text-xl font-bold text-theme-main mb-2">{req.title}</h3>
                            <p class="text-theme-muted text-sm leading-relaxed">
                                {req.isDynamic ? (
                                    <>
                                        Asegúrate de entrar con la <strong id="req-version-text" class="text-theme-main">Minecraft 1.21.x</strong>. Recomendamos la última versión disponible.
                                        <span id="req-version-subtext" class="block mt-1 opacity-70 text-xs"></span>
                                    </>
                                ) : (
                                    <>
                                        <Fragment set:html={req.description} />
                                        {linkUrl && (
                                            <a 
                                                href={linkUrl} 
                                                target={req.isExternal ? '_blank' : '_self'}
                                                rel={req.isExternal ? 'noopener noreferrer' : undefined}
                                                class="text-btc-orange font-bold hover:text-theme-main underline underline-offset-2 transition-colors"
                                            >
                                                {req.linkLabel}
                                            </a>
                                        )}
                                        {req.id === 'account' && '.'}
                                    </>
                                )}
                            </p>
                        </div>
                    </div>
                );
            })}

            <div id="bedrock-req-container" class="flex flex-col md:flex-row items-center md:items-start gap-6 md:col-span-2 border-t border-theme mt-8 md:mt-0 md:border-t-0 pt-8 md:pt-0" style="display: none;">
                <div class="req-icon-box req-icon-purple">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                </div>
                <div>
                    <h3 class="req-title text-xl font-bold text-theme-main mb-2">Versión Bedrock</h3>
                    <p class="text-theme-muted text-sm leading-relaxed">
                        Compatible con la versión <strong id="req-bedrock-version" class="text-theme-main">1.21.x</strong>. 
                        <span class="block mt-1">Puedes usar una cuenta premium o no premium.</span>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<script is:inline>
    window.addEventListener('btc:config-loaded', (e) => {
        const data = e.detail;
        const versionText = document.getElementById('req-version-text');
        const versionSubtext = document.getElementById('req-version-subtext');
        
        if (data.isMultiVersion) {
            versionText.innerText = `Minecraft ${data.JavaMin} - ${data.JavaMax}`;
            versionSubtext.innerText = `(Recomendado: ${data.JavaMax})`;
        } else {
            versionText.innerText = `Minecraft ${data.JavaMax || 'Actual'}`;
            versionSubtext.innerText = '';
        }

        if (data.isBedrock) {
            const bedrockContainer = document.getElementById('bedrock-req-container');
            const bedrockVersion = document.getElementById('req-bedrock-version');
            if (bedrockContainer) bedrockContainer.style.display = 'flex';
            if (bedrockVersion) bedrockVersion.innerText = data.BedrockVer || 'Última versión';
        }
    });
</script>