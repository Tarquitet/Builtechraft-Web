---
// src/components/ip/JavaCard.astro
---
<div class="flex flex-col sm:flex-row items-start sm:items-center justify-between bg-zinc-900/80 backdrop-blur-sm border border-white/10 rounded-xl p-4 gap-4 transition-all hover:border-btc-orange/50 shadow-md w-full">
    <div class="flex flex-col">
        <span class="text-white font-bold uppercase tracking-widest text-sm">Java Edition</span>
        <span class="text-[10px] text-zinc-500 uppercase">PC / Mods</span>
    </div>
    <div class="flex items-center gap-3 w-full sm:w-auto">
        <code id="java-ip-code" class="text-zinc-300 font-mono text-sm select-all bg-black/40 px-3 py-1.5 rounded-lg border border-white/5 truncate max-w-50 sm:max-w-none">Cargando...</code>
        <button onclick="window.copyText(this, 'java-ip-code')" class="ml-auto bg-white/5 hover:bg-btc-orange text-zinc-300 hover:text-white px-5 py-2 rounded-lg text-[10px] font-bold uppercase tracking-widest transition-colors border border-white/5 hover:border-btc-orange shrink-0">Copiar</button>
    </div>
</div>

<script>
    window.addEventListener('btc:config-loaded', (e: any) => {
        const el = document.getElementById('java-ip-code');
        if(el) el.innerText = e.detail["JavaIP"] || 'play.builtechraft.com';
    });
</script>