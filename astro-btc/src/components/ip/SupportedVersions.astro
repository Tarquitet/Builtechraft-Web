---
// src/components/ip/SupportedVersions.astro
---
<div class="max-w-4xl mx-auto bg-amber-500/5 border border-amber-500/20 rounded-2xl p-6 transition-all">
    <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
        <div class="space-y-2 flex-1">
            <h4 class="text-amber-500 font-bold uppercase tracking-widest text-xs flex items-center justify-center md:justify-start gap-2 m-0">⚠️ VERSIONES SOPORTADAS</h4>
            <p id="yellow-version-text" class="text-zinc-300 text-sm leading-relaxed m-0 animate-pulse">Cargando...</p>
        </div>
        <a id="discord-small-link" href="#" target="_blank" class="whitespace-nowrap bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-[10px] font-bold py-2.5 px-5 rounded-xl border border-zinc-700 transition-all uppercase tracking-widest shadow-lg hover:text-white">
            Más info en Discord
        </a>
    </div>
</div>

<script>
    window.addEventListener('btc:config-loaded', (e: any) => {
        const textEl = document.getElementById('yellow-version-text');
        const linkEl = document.getElementById('discord-small-link');
        
        if (textEl) {
            textEl.classList.remove('animate-pulse');
            textEl.innerHTML = `
                <span class="block mb-2">☕ Soportamos para <strong>Java</strong> desde la versión <span class="text-white font-mono font-bold">${e.detail["JavaMin"] || ''}</span> hasta la <span class="text-white font-mono font-bold">${e.detail["JavaMax"] || ''}</span> (recomendada).</span>
                <span class="block mb-1">📱 Compatible con <strong>Bedrock</strong> en la versión <span class="text-white font-mono font-bold">${e.detail["BedrockVer"] || ''}</span>.</span>
            `;
        }
        if (linkEl) linkEl.setAttribute('href', e.detail["DiscordURL"] || '#');
    });
</script>