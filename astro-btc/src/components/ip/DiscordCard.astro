---
// src/components/ip/DiscordCard.astro
---
<a id="discord-card-link" href="#" target="_blank" rel="noopener noreferrer" class="w-full bg-[#5865F2]/10 hover:bg-[#5865F2]/20 border border-[#5865F2]/30 hover:border-[#5865F2] rounded-2xl p-6 md:p-8 flex flex-col md:flex-row items-center justify-between text-center md:text-left transition-all duration-300 group shadow-lg gap-6 md:gap-8">
    
    <!-- LADO IZQUIERDO: Icono + Texto -->
    <div class="flex flex-col md:flex-row items-center gap-4 md:gap-6 w-full md:w-auto">
        <!-- Icono -->
        <div class="w-16 h-16 bg-[#5865F2] rounded-2xl flex items-center justify-center shrink-0 shadow-[0_0_30px_rgba(88,101,242,0.4)] group-hover:scale-110 group-hover:-translate-y-1 transition-all duration-300">
            <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
            </svg>
        </div>
        
        <!-- Textos -->
        <div class="flex flex-col items-center md:items-start">
            <h3 class="text-xl md:text-2xl font-display font-black text-white uppercase tracking-tight mb-1">
                Únete a Discord
            </h3>
            <p class="text-zinc-400 text-xs md:text-sm leading-relaxed max-w-lg">
                Accede a la whitelist para entrar.
            </p>
        </div>
    </div>

    <!-- LADO DERECHO: Botón / CTA -->
    <div class="shrink-0 w-full md:w-auto bg-[#5865F2] text-white text-[10px] md:text-xs font-bold py-3.5 px-8 rounded-xl transition-transform group-hover:scale-105 uppercase tracking-widest shadow-[0_0_15px_rgba(88,101,242,0.3)] text-center mt-2 md:mt-0">
        Abrir Discord
    </div>

</a>

<script>
    window.addEventListener('btc:config-loaded', (e: any) => {
        const el = document.getElementById('discord-card-link');
        if(el) el.setAttribute('href', e.detail["DiscordURL"] || '#');
    });
</script>