---
// src/components/Gallery.astro
import fs from 'node:fs';
import path from 'node:path';

const galleryFolder = 'images/gallery'; 
const directoryPath = path.join(process.cwd(), 'public', galleryFolder);

// Le decimos explícitamente a TS que es un array de strings (textos)
let galleryImages: string[] = [];

try {
    const files = fs.readdirSync(directoryPath);
    galleryImages = files
        .filter(file => /\.(jpg|jpeg|png|webp|gif|avif)$/i.test(file))
        .map(file => `/${galleryFolder}/${file}`);
} catch (error: any) { // Declaramos que el error es any
    console.error(`⚠️ Error leyendo galería: ${error.message}`);
}

if (galleryImages.length === 0) {
    galleryImages = ['https://via.placeholder.com/800x450?text=Sin+Imagenes']; 
}

const track1Images = galleryImages.filter((_, i) => i % 2 === 0);
const track2Images = galleryImages.filter((_, i) => i % 2 !== 0);

// Declaramos que imgs es un array de strings
const fillTrack = (imgs: string[]) => {
    if (imgs.length === 0) return [];
    let result = [...imgs];
    while (result.length < 6) result = [...result, ...imgs];
    return result;
};

const finalTrack1 = fillTrack(track1Images);
const finalTrack2 = fillTrack(track2Images);

const doubleTrack1 = [...finalTrack1, ...finalTrack1];
const doubleTrack2 = [...finalTrack2, ...finalTrack2];

const tracks = [
    { imgs: doubleTrack1, dir: 1 },
    { imgs: doubleTrack2, dir: -1 }
];
---

<section id="galeria" class="py-24 bg-theme-panel relative overflow-hidden transition-colors duration-300">

    <div class="container mx-auto px-6 relative z-10 mb-16">
        <div class="text-center">
            <h2 class="text-4xl md:text-5xl font-display font-bold text-theme-main uppercase tracking-tight">
                Galería <span class="text-btc-orange">Visual</span>
            </h2>
        </div>
    </div>

    <div class="flex flex-col gap-8">
        {tracks.map((track) => (
            <div class="gallery-row relative group w-full" data-direction={track.dir}>
                
                <button class="btn-prev absolute left-4 md:left-8 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-black/60 hover:bg-btc-orange text-white rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 backdrop-blur-md border border-white/10 shadow-xl transform hover:scale-110">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"></path></svg>
                </button>

                <button class="btn-next absolute right-4 md:right-8 top-1/2 -translate-y-1/2 z-20 w-12 h-12 bg-black/60 hover:bg-btc-orange text-white rounded-full flex items-center justify-center opacity-0 group-hover:opacity-100 transition-all duration-300 backdrop-blur-md border border-white/10 shadow-xl transform hover:scale-110">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"></path></svg>
                </button>

                <div class="w-full overflow-hidden mask-edges isolate">
                    <div class="gallery-track flex gap-6 w-max will-change-transform transform-gpu">
                        {track.imgs.map((imgSrc, index) => (
                            <a 
                                href={imgSrc} 
                                target="_blank" 
                                rel="noopener noreferrer"
                                class="relative block w-70 md:w-100 aspect-video rounded-2xl overflow-hidden border border-white/10 bg-[#18181b] shrink-0 group/card"
                                aria-label={`Ver imagen ${index + 1}`}
                            >
                                <img 
                                    src={imgSrc} 
                                    alt={`Captura Builtechraft`} 
                                    class="w-full h-full object-cover opacity-0 data-[loaded=true]:opacity-100 transition-all duration-700 ease-out group-hover/card:scale-110 will-change-transform transform-gpu"
                                    onload="this.setAttribute('data-loaded', 'true')"
                                    loading="lazy"
                                    decoding="async"
                                />
                                <div class="absolute inset-0 bg-black/50 opacity-0 group-hover/card:opacity-100 transition-opacity duration-300 flex items-center justify-center pointer-events-none">
                                    <span class="text-white font-bold text-sm tracking-widest uppercase border border-white/20 px-4 py-2 rounded-full bg-black/40 backdrop-blur-sm flex items-center gap-2">
                                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
                                        Ampliar
                                    </span>
                                </div>
                            </a>
                        ))}
                    </div>
                </div>

            </div>
        ))}
    </div>
</section>

<style>
    .mask-edges {
        -webkit-mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
        mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
    }
</style>

<script>
    class GalleryMarquee {
        // === LA CLAVE PARA QUE TS NO GRITE ===
        // Aquí declaramos TODAS las variables que va a usar la clase
        row: HTMLElement;
        track: HTMLElement | null;
        btnPrev: HTMLButtonElement | null;
        btnNext: HTMLButtonElement | null;
        direction: number;
        position: number;
        speed: number;
        isHovered: boolean;
        manualOffset: number;
        targetOffset: number;
        pauseTimeout: any;
        lastTime: number;
        halfWidth: number;
        itemWidth: number;

        constructor(el: HTMLElement) {
            this.row = el;
            this.track = el.querySelector('.gallery-track');
            this.btnPrev = el.querySelector('.btn-prev');
            this.btnNext = el.querySelector('.btn-next');
            
            this.direction = parseInt(this.row.dataset.direction || '1');

            this.position = 0;
            this.speed = 0.6;
            this.isHovered = false;
            
            this.manualOffset = 0;
            this.targetOffset = 0;
            this.pauseTimeout = null;
            this.lastTime = 0;
            this.halfWidth = 0;
            this.itemWidth = 0;

            this.updateDimensions();
            window.addEventListener('resize', () => this.updateDimensions());
            
            if (this.btnPrev) this.btnPrev.addEventListener('click', () => this.move(-1));
            if (this.btnNext) this.btnNext.addEventListener('click', () => this.move(1));
            
            this.row.addEventListener('mouseenter', () => this.isHovered = true);
            this.row.addEventListener('mouseleave', () => this.isHovered = false);

            this.tick = this.tick.bind(this);
            requestAnimationFrame(this.tick);
        }

        updateDimensions() {
            if (!this.track) return;
            this.halfWidth = this.track.scrollWidth / 2;
            const firstItem = this.track.children[0] as HTMLElement | undefined;
            if (!firstItem) return;
            const gap = parseFloat(getComputedStyle(this.track).gap) || 24;
            this.itemWidth = firstItem.offsetWidth + gap;
        }

        move(direction: number) {
            this.targetOffset += direction * this.itemWidth;
            this.isHovered = true;
            if (this.pauseTimeout) clearTimeout(this.pauseTimeout);
            
            this.pauseTimeout = setTimeout(() => {
                if (!this.row.matches(':hover')) {
                    this.isHovered = false;
                }
            }, 3000); 
        }

        tick(time: number) {
            if (!this.lastTime) this.lastTime = time;
            const deltaTime = time - this.lastTime;
            this.lastTime = time;
            const timeScale = deltaTime / 16.66; 

            if (Math.abs(this.targetOffset - this.manualOffset) > 0.5) {
                this.manualOffset += (this.targetOffset - this.manualOffset) * 0.1 * timeScale;
            } else {
                this.manualOffset = this.targetOffset;
            }

            if (!this.isHovered && this.manualOffset === this.targetOffset) {
                this.position += this.speed * this.direction * timeScale;
            }

            let currentTranslate = this.position + this.manualOffset;

            if (currentTranslate >= this.halfWidth) {
                this.position -= this.halfWidth;
                currentTranslate -= this.halfWidth;
            } else if (currentTranslate < 0) {
                this.position += this.halfWidth;
                currentTranslate += this.halfWidth;
            }

            if (this.track) {
                this.track.style.transform = `translate3d(${-currentTranslate}px, 0, 0)`;
            }
            requestAnimationFrame(this.tick);
        }
    }

    document.addEventListener('DOMContentLoaded', () => {
        document.querySelectorAll('.gallery-row').forEach(row => new GalleryMarquee(row as HTMLElement));
    });
</script>