---
// DEFINICIÓN DE LOS GRUPOS (Para las Tarjetas)
const groups = [
    {
        id: "core",
        title: "Bases de la Comunidad",
        desc: "Valores, seguridad y nuestro equipo técnico (Secciones I - III)",
        icon: "🏠",
        startIndex: 0,
        endIndex: 3 // Toma las secciones 0, 1 y 2 (I, II, III)
    },
    {
        id: "ops",
        title: "Día a Día",
        desc: "Actualizaciones y normas de arte (Secciones IV - V)",
        icon: "⚙️",
        startIndex: 3,
        endIndex: 5 // Toma las secciones 3 y 4 (IV, V)
    },
    {
        id: "civil",
        title: "Convivencia y Propiedad",
        desc: "Construcciones, AFK y el equipo Staff (Secciones VII - XI)",
        icon: "🤝",
        startIndex: 5,
        endIndex: 10 // Toma el resto de las secciones (VII en adelante)
    }
];
// TUS DATOS ORIGINALES (No tocamos nada del contenido)
const allSections = [
    {
        id: "I",
        title: "Convivencia y Respeto",
        icon: "✨",
        rules: [
            {
                num: "1.1",
                text: "Respeto a las Creencias y Valores",
                sub: "Builtechraft es un espacio para todos. El respeto es nuestra base principal.",
                details: [
                    "1.1.a: Respeta la religión y las creencias de cada usuario. No todos los que entran al servidor comparten la misma fe, por lo que pedimos ser muy respetuosos con estos temas.",
                    "1.1.b: Se pide amablemente que no digan groserías ni usen lenguaje soez. El respeto entre usuarios es clave para que todos estemos a gusto.",
                    "1.1.c: El acoso, las peleas constantes o revelar información personal de otros está estrictamente prohibido[cite: 6]."
                ]
            },
            {
                num: "1.2",
                text: "Espacio para Crear (Sin Ideologías)",
                sub: "Venimos a diseñar catedrales, optimizar granjas y crear arte, no a discutir de política.",
                details: [
                    "1.2.a: Aunque respetamos la diversidad, pedimos amablemente que no se construyan banderas de movimientos políticos, ideologías de género o símbolos polémicos.",
                    "1.2.b: Las construcciones famosas o históricas (como el Cristo Redentor o el Taj Mahal) sí están permitidas y son bienvenidas por su valor artístico.",
                    "1.2.c: No se permite imponer ideologías a los demás. El comportamiento agresivo o intentar obligar a otros a aceptar ciertos pensamientos no será tolerado."
                ]
            },
            {
                num: "1.3",
                text: "Madurez y Comunicación",
                sub: "Buscamos un nivel mínimo de tranquilidad para que la comunidad funcione bien[cite: 10].",
                details: [
                    "1.3.a: No toleramos dramas públicos ni quejas excesivas porque no se te permita romper las reglas (como poner banderas no permitidas). Si algo te molesta, actúa con calma.",
                    "1.3.b: Si tienes un problema, repórtalo de forma privada mediante un ticket con argumentos claros. Las discusiones personales deben quedarse en privado para no molestar a los demás en el chat global[cite: 11, 13]."
                ]
            }
        ]
    },
    {
        id: "II",
        title: "Sobre nuestra Computadora",
        icon: "💻",
        rules: [
            {
                num: "2.1",
                text: "Estado del Equipo",
                sub: "El servidor no está en una empresa; funciona en una laptop personal de 2020[cite: 15].",
                details: [
                    "2.1.a: Paciencia con el rendimiento: La computadora lleva años encendida y a veces puede tener lag. Si el juego se traba un poco, te pedimos paciencia con la máquina[cite: 16].",
                    "2.1.b: Fallos externos: Al ser un servidor casero, dependemos de la luz y el internet de la casa. Si hay un corte de energía o internet en la zona, el servidor se apagará[cite: 17].",
                    "2.1.c: Regreso automático: El servidor volverá a estar en línea en cuanto los servicios públicos se normalicen. No es necesario preguntar qué pasó si es un corte de luz evidente[cite: 52]."
                ]
            },
            {
                num: "2.2",
                text: "Horarios de Descanso",
                sub: "Apagamos el equipo unas horas para evitar que se dañe por el calor[cite: 18].",
                details: [
                    "2.2.a: Descanso nocturno: El servidor se apaga automáticamente a la 01:00 AM (Hora Colombia) para que la laptop pueda enfriarse[cite: 19].",
                    "2.2.b: Hora de encendido: El sistema vuelve a estar disponible antes de las 10:00 AM (Hora Colombia)[cite: 20].",
                    "2.2.c: Ajustes del Staff: El equipo de administración puede entrar de forma remota para encender el servidor fuera de horario si hay una emergencia o mantenimiento necesario[cite: 20]."
                ]
            }
        ]
    },
    {
        id: "III",
        title: "Seguridad y Entrada",
        icon: "🔐",
        rules: [
            {
                num: "3.1",
                text: "Por qué nos cuidamos tanto",
                sub: "Nuestras reglas actuales existen para evitar problemas que tuvimos en el pasado.",
                details: [
                    "3.1.a: Lecciones aprendidas: Hace tiempo, alguien se hizo pasar por el dueño del servidor y puso en riesgo todo el mundo. Por eso, ahora la seguridad es obligatoria[cite: 22].",
                    "3.1.b: Mejoras constantes: Hemos pasado de usar contraseñas simples a sistemas mucho más seguros para proteger tus construcciones y tu progreso[cite: 23]."
                ]
            },
            {
                num: "3.2",
                text: "Cómo entrar a jugar (Ely.by)",
                sub: "Queremos que entrar sea fácil para todos, sin importar si tienes cuenta comprada o no.",
                details: [
                    "3.2.a: Uso de Skins: Usamos servicios como Ely.by para que puedas ver tu skin y entrar de forma segura sin tener que escribir comandos de registro dentro del juego.",
                    "3.2.b: Pruebas de mejora: Siempre estamos buscando nuevas formas de que la entrada al servidor sea más rápida y segura.",
                    "3.2.c: Paciencia en los cambios: Si el Staff está probando un nuevo método para entrar, te pedimos paciencia. Todo cambio es para que nadie pueda robar tu cuenta[cite: 26]."
                ]
            }
        ]
    },
    {
        id: "IV",
        title: "Actualizaciones y Equipo",
        icon: "🛠️",
        rules: [
            {
                num: "4.1",
                text: "Sobre las nuevas versiones",
                sub: "Preferimos que el servidor sea estable antes que tener lo último con errores.",
                details: [
                    "4.1.a: Tiempo de espera: Cuando sale una nueva versión de Minecraft, solemos esperar de 2 a 3 semanas antes de actualizar el servidor[cite: 27].",
                    "4.1.b: Seguridad del mapa: Este tiempo es necesario para que los complementos del servidor se actualicen y para evitar errores que puedan dañar tus construcciones o el mundo."
                ]
            },
            {
                num: "4.2",
                text: "Somos humanos",
                sub: "Detrás del servidor hay una persona real (Tarquitet), no una máquina.",
                details: [
                    "4.2.a: Errores comunes: A veces el servidor puede no encenderse a la hora exacta por olvido o falta de tiempo del dueño; por favor, evita presionar al Staff[cite: 30].",
                    "4.2.b: Comunidad pequeña: No somos una empresa grande, somos una comunidad gestionada con pasión. Agradecemos mucho tu comprensión y paciencia[cite: 31]."
                ]
            }
        ]
    },
    {
        id: "V",
        title: "Reglas de Arte",
        icon: "🎨",
        rules: [
            {
                num: "5.1",
                text: "Arte Sugerente",
                sub: "Permitimos libertad creativa, pero con límites para mantener un ambiente cómodo.",
                details: [
                    "5.1.a: Límite de obras: Cada usuario puede tener un máximo de dos (2) obras de arte de carácter sugerente. No queremos que el servidor se convierta en una galería de este tipo[cite: 33].",
                    "5.1.b: Solo en zonas privadas: Estas obras deben estar en lugares cerrados o privados (como sótanos o habitaciones). Mostrarlas en zonas públicas o el Spawn se considera una falta de respeto[cite: 34].",
                    "5.1.c: Tu responsabilidad: Si alguien ve tu contenido porque no protegiste bien tu zona, la responsabilidad es totalmente tuya[cite: 34]."
                ]
            },
            {
                num: "5.2",
                text: "Nivel de Contenido",
                sub: "El Staff supervisa que el tono del servidor no se vuelva inapropiado.",
                details: [
                    "5.2.a: Respetar los límites: Ninguna obra nueva puede ser más explícita que las que ya han sido permitidas anteriormente[cite: 36].",
                    "5.2.b: Ajustes necesarios: Si el ambiente se vuelve muy pesado, el Staff podrá pedir que se retiren o censuren algunas obras para mantener el orden[cite: 37].",
                    "5.2.c: Decisión final: El Staff tiene la última palabra sobre qué es arte y qué es contenido prohibido. No se aceptarán discusiones sobre esto[cite: 38]."
                ]
            },
            {
                num: "5.3",
                text: "Ambiente de la Comunidad",
                sub: "Cuidamos que el servidor sea un lugar sano para todos.",
                details: [
                    "5.3.a: Revisión de contenido: El Staff revisa lo que se construye para asegurar que el ambiente siga siendo respetuoso y acorde a nuestros valores.",
                    "5.3.b: Comportamiento: Si el contenido que creas es demasiado perturbador o extraño, evaluaremos si tu perfil es adecuado para permanecer en esta comunidad.",
                    "5.3.c: Prueba de madurez: Te pedimos manejar tu libertad con respeto hacia los demás jugadores[cite: 40]."
                ]
            }
        ]
    },
    //El 6 - VI eliminado por rebundancia innecesaria que ya esta en otros textos
    {
        id: "VI",
        title: "Tu Espacio y el de los Demás",
        icon: "🛡️",
        rules: [
            {
                num: "7.1",
                text: "Respeto a las Construcciones",
                sub: "Lo que no es tuyo no se toca. Tenemos herramientas para saber quién puso o quitó cada bloque.",
                details: [
                    "7.1.a: No al vandalismo: Destruir o alterar construcciones ajenas sin permiso resultará en una expulsión permanente. No hay advertencias.",
                    "7.1.b: No robar: Tomar objetos de cofres o almacenes ajenos (aunque no tengan protección) se considera una falta grave de honestidad[cite: 54]."
                ]
            },
            {
                num: "7.2",
                text: "Reglas para las Bromas",
                sub: "La diversión termina cuando molestas el trabajo de los demás[cite: 56].",
                details: [
                    "7.2.a: Solo con amigos: Haz bromas únicamente a jugadores con los que tengas mucha confianza. Si no sabes cómo reaccionarán, mejor no lo hagas[cite: 56].",
                    "7.2.b: Limpieza obligatoria: Si haces una broma, estás obligado a limpiar y dejar todo como estaba si la otra persona te lo pide[cite: 56].",
                    "7.2.c: Nada de destrucción: Están prohibidas las bromas que usen fuego, TNT, lava o cualquier cosa que pueda destruir objetos de forma permanente[cite: 57]."
                ]
            },
            {
                num: "7.3",
                text: "Caminos y Portales",
                sub: "El transporte en el servidor debe ser ordenado y respetuoso.",
                details: [
                    "7.3.a: Portales ordenados: Si tu portal estorba en la base de otra persona y no tiene un cartel con tu nombre, el dueño de la zona puede quitarlo.",
                    "7.3.b: Identificación: Todo portal debe tener un cartel con coordenadas o el nombre del dueño para evitar confusiones[cite: 60]."
                ]
            }
        ]
    },
    {
        id: "VII",
        title: "Jugadores Inactivos (AFK)",
        icon: "💤",
        rules: [
            {
                num: "8.1",
                text: "Uso Responsable del Espacio",
                sub: "Si no estás jugando activamente, intenta no ocupar un lugar innecesario en el servidor.",
                details: [
                    "8.1.a: Solo se permite quedarse quieto (AFK) si estás operando una granja automática o esperando un proceso técnico del juego. Quedarse quieto en el punto de aparición (Spawn) solo para 'sumar horas' no está permitido[cite: 61, 62].",
                    "8.1.b: Para que otros puedan entrar a jugar, el sistema te sacará automáticamente después de 20 minutos de inactividad si detecta que el servidor está muy lleno."
                ]
            },
            {
                num: "8.2",
                text: "Cuida tu Personaje",
                sub: "Desconectarte cuando no juegas ayuda al servidor y te protege a ti.",
                details: [
                    "8.2.a: Si vas a salir a comer o a dormir, por favor desconéctate. Esto ayuda a que la computadora del servidor no trabaje de más procesando zonas donde no hay nadie[cite: 64].",
                    "8.2.b: Si dejas a tu personaje solo y muere de hambre o por un monstruo, el Staff no podrá devolverte tus objetos. Mantener a tu personaje a salvo es tu responsabilidad activa."
                ]
            }
        ]
    },
    {
        id: "VIII",
        title: "El Trato con el Equipo (Staff)",
        icon: "🛡️",
        rules: [
            {
                num: "9.1",
                text: "Somos Voluntarios",
                sub: "El equipo del servidor ayuda porque quiere, no porque sea su trabajo[cite: 66].",
                details: [
                    "9.1.a: Ten paciencia con las respuestas: Por favor, no exijas atención inmediata. Un ticket puede tardar en responderse si el equipo está trabajando, estudiando o descansando[cite: 67].",
                    "9.1.b: No usar menciones innecesarias: Etiquetar muchas veces a los administradores o al dueño en Discord sin una emergencia real es motivo de sanción[cite: 68]."
                ]
            },
            {
                num: "9.2",
                text: "Respeto y Soluciones",
                sub: "Todos somos humanos y podemos equivocarnos. Lo importante es hablarlo con respeto.",
                details: [
                    "9.2.a: Si hay un error, avísanos: Si un administrador se equivoca con una sanción o borra algo sin querer, repórtalo con calma y respeto. Lo investigaremos para arreglarlo.",
                    "9.2.b: Trato amable: Insultar o menospreciar a un miembro del equipo por sus decisiones hará que se te retire el acceso al servidor."
                ]
            }
        ]
    },
    {
        id: "IX",
        title: "Tu Cuenta y Seguridad",
        icon: "👤",
        rules: [
            {
                num: "10.1",
                text: "Cuidando tu identidad",
                sub: "Tu personaje es tu identidad en el servidor y tú eres el único responsable de lo que pase con él[cite: 71].",
                details: [
                    "10.1.a: La excusa de terceros: Si un amigo, un familiar o cualquier otra persona entra con tu cuenta y rompe las reglas, la sanción se aplicará a la CUENTA, sin importar quién estaba jugando en ese momento.",
                    "10.1.b: Seguridad personal: Es tu deber mantener segura tu contraseña y tu cuenta de Minecraft o Discord. El equipo no retirará sanciones que ocurran por descuidos de seguridad de tu parte."
                ]
            }
        ]
    },
    {
        id: "X",
        title: "Sentido Común",
        icon: "🧠",
        rules: [
            {
                num: "11.1",
                text: "Uso del Buen Juicio",
                sub: "No todo tiene que estar escrito paso a paso para saber qué está bien y qué está mal.",
                details: [
                    "11.1.a: Lo que no está en la lista: El hecho de que algo no aparezca específicamente en estas reglas no significa que esté permitido. Si una acción parece injusta o daña el servidor, se tratará como una falta.",
                    "11.1.b: Decisiones del equipo: En situaciones que no hayamos previsto en este texto, el Staff aplicará el sentido común y su decisión será definitiva.",
                    "11.1.c: Evita buscar fallos: Intentar buscar 'agujeros' o trucos en estas normas para molestar a otros o al servidor también será motivo de sanción."
                ]
            }
        ]
    }
];
---

<section id="reglas" class="py-24 bg-theme-panel relative min-h-screen">

    <div class="container mx-auto px-6 relative z-10">
        
        <div class="text-center mb-16">
            <h2 class="text-4xl md:text-5xl font-display font-bold text-theme-text uppercase tracking-tight">
                Normas de <span class="text-theme-accent">Builtechraft</span>
            </h2>
            <p class="text-theme-main opacity-80 text-lg max-w-2xl mx-auto mt-4 italic">
                Hemos sufrido, llorado y pasado por mucho. Por ello, se ha creado una serie de reglas que reflejan nuestra filosofía, valores y experiencia operando este servidor desde 2020. No lo tomen a la ligera, es lo que mantiene la inspiración a flote (y fue tardado en escribir).
            </p>
        </div>

        <div class="relative min-h-125">
            
            <div id="rules-cards-view" class="grid grid-cols-1 md:grid-cols-3 gap-6 transition-all duration-500 ease-in-out">
                {groups.map((group) => (
                    <button 
                        class="group-card group text-left p-8 bg-zinc-900/50 hover:bg-zinc-900 border border-white/5 hover:border-btc-orange/50 rounded-2xl transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl hover:shadow-btc-orange/10 flex flex-col gap-6 relative overflow-hidden"
                        data-group-id={group.id}
                    >
                        <div class="absolute inset-0 bg-linear-to-br from-btc-orange/0 to-btc-orange/5 opacity-0 group-hover:opacity-100 transition-opacity"></div>
                        
                        <div class="relative z-10">
                            <span class="text-5xl mb-4 block group-hover:scale-110 transition-transform duration-300 origin-left">
                                {group.icon}
                            </span>
                            <h3 class="text-2xl font-bold text-white group-hover:text-btc-orange transition-colors mb-2 uppercase tracking-wide">
                                {group.title}
                            </h3>
                            <p class="text-zinc-200 text-sm leading-relaxed mb-6">
                                {group.desc}
                            </p>
                            
                            <div class="inline-flex items-center gap-2 text-xs font-bold uppercase tracking-widest text-btc-orange border border-btc-orange/30 px-3 py-1.5 rounded bg-btc-orange/10">
                                <span>Ver Secciones</span>
                                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                            </div>
                        </div>
                    </button>
                ))}
            </div>

            <div id="rules-list-view" class="hidden opacity-0 translate-y-8 transition-all duration-500">
                
                <button id="back-to-cards" class="mb-8 flex items-center gap-3 px-6 py-3 bg-zinc-900 border border-white/10 rounded-xl text-zinc-400 hover:text-white hover:border-btc-orange hover:bg-zinc-800 transition-all group shadow-lg">
                    <svg class="w-5 h-5 group-hover:-translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    <span class="font-bold uppercase tracking-wider text-sm">Regresar al Menú</span>
                </button>

                {groups.map((group) => (
                    // Creamos un contenedor oculto para cada grupo
                    <div id={`group-${group.id}`} class="group-content hidden space-y-4">
                        
                        {/* Renderizamos SOLO las secciones que pertenecen a este grupo usando slice */}
                        {allSections.slice(group.startIndex, group.endIndex).map((section) => (
                            
                            // ESTE ES EL ACORDEÓN ORIGINAL QUE FUNCIONABA BIEN
                            <div class="main-accordion group bg-[#0f0f11] border border-white/10 rounded-2xl overflow-hidden transition-colors duration-300 hover:border-btc-orange/30 shadow-lg">
                                
                                <button class="main-trigger w-full p-6 flex items-center justify-between text-left hover:bg-white/5 transition-colors">
                                    <div class="flex items-center gap-5">
                                        <span class="text-3xl bg-[#18181b] p-3 rounded-xl border border-white/5 group-hover:text-btc-orange transition-colors">
                                            {section.icon}
                                        </span>
                                        <div>
                                            <span class="text-zinc-500 font-display font-bold text-[10px] tracking-[0.2em] uppercase block mb-1">Sección {section.id}</span>
                                            <h3 class="text-xl md:text-2xl font-display font-bold text-zinc-100 uppercase">{section.title}</h3>
                                        </div>
                                    </div>
                                    
                                    <div class="accordion-icon text-zinc-500 transition-transform duration-300">
                                        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                                    </div>
                                </button>

                                <div class="main-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-out">
                                    <div class="overflow-hidden">
                                        <div class="p-6 pt-0 flex flex-col gap-3 border-t border-white/5 bg-[#0a0a0a]">
                                            {section.rules.map((rule) => (
                                                <div class="sub-accordion bg-[#131315] rounded-xl border border-white/5">
                                                    <button class="sub-trigger w-full p-4 flex items-start md:items-center gap-4 text-left hover:bg-white/5 transition-colors">
                                                        <span class="text-btc-yellow font-mono text-xs font-bold shrink-0 mt-1 md:mt-0 bg-yellow-500/10 px-2 py-1 rounded border border-yellow-500/20">
                                                            {rule.num}
                                                        </span>
                                                        <span class="text-zinc-200 text-sm font-bold flex-1 leading-snug">{rule.text}</span>
                                                        <svg class="w-4 h-4 text-zinc-600 arrow-sub transition-transform shrink-0 mt-1 md:mt-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M19 9l-7 7-7-7" stroke-width="2"></path></svg>
                                                    </button>

                                                    <div class="sub-content grid grid-rows-[0fr] transition-[grid-template-rows] duration-300">
                                                        <div class="overflow-hidden">
                                                            <div class="p-4 pt-0 text-sm leading-relaxed">
                                                                <p class="mb-4 text-zinc-300 pl-2 border-l-2 border-zinc-700">{rule.sub}</p>
                                                                {rule.details && (
                                                                    <div class="flex flex-col gap-2 mt-2 bg-black/20 p-4 rounded-lg border border-white/5 font-mono text-xs">
                                                                        {rule.details.map((detail) => (
                                                                            <div class="flex gap-3 text-zinc-500">
                                                                                <span class="text-btc-yellow font-bold shrink-0 select-none">»</span>
                                                                                <span class="text-zinc-200">{detail}</span>
                                                                            </div>
                                                                        ))}
                                                                    </div>
                                                                )}
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>

                        ))}
                    </div>
                ))}

            </div>
        </div>
    </div>
</section>

<script is:inline>
    // 1. LÓGICA DE NAVEGACIÓN (TARJETAS <-> LISTA)
    const cardsView = document.getElementById('rules-cards-view');
    const listView = document.getElementById('rules-list-view');
    const backBtn = document.getElementById('back-to-cards');
    const groupContents = document.querySelectorAll('.group-content');
    const groupCards = document.querySelectorAll('.group-card');

    // ABRIR GRUPO
    groupCards.forEach(card => {
        card.addEventListener('click', () => {
            const groupId = card.getAttribute('data-group-id');
            
            // Ocultar Tarjetas
            cardsView.classList.add('opacity-0', '-translate-x-10');
            
            setTimeout(() => {
                cardsView.classList.add('hidden');
                
                // Mostrar Solo el Grupo Seleccionado
                groupContents.forEach(content => content.classList.add('hidden'));
                document.getElementById(`group-${groupId}`).classList.remove('hidden');
                
                // Mostrar Contenedor de Lista
                listView.classList.remove('hidden');
                
                // Pequeño delay para la animación de entrada
                requestAnimationFrame(() => {
                    listView.classList.remove('opacity-0', 'translate-y-8');
                });

                // Scroll suave al inicio
                document.getElementById('reglas').scrollIntoView({ behavior: 'smooth' });

            }, 300);
        });
    });

    // VOLVER AL MENÚ
    backBtn.addEventListener('click', () => {
        listView.classList.add('opacity-0', 'translate-y-8');
        
        setTimeout(() => {
            listView.classList.add('hidden');
            
            // Cerrar todos los acordeones para que al volver esté limpio (Opcional)
            document.querySelectorAll('.main-content, .sub-content').forEach(el => el.style.gridTemplateRows = '0fr');
            document.querySelectorAll('.accordion-icon, .arrow-sub').forEach(el => el.style.transform = 'rotate(0deg)');

            cardsView.classList.remove('hidden');
            requestAnimationFrame(() => {
                cardsView.classList.remove('opacity-0', '-translate-x-10');
            });
        }, 300);
    });


    // 2. LÓGICA DE ACORDEONES (EXACTAMENTE LA ORIGINAL)
    document.querySelectorAll('.main-trigger').forEach(trigger => {
        trigger.addEventListener('click', () => {
            const parent = trigger.parentElement;
            const content = parent.querySelector('.main-content');
            const icon = trigger.querySelector('.accordion-icon');
            const isOpen = content.style.gridTemplateRows === '1fr';

            // Auto-collapse (Opcional: Cierra otros al abrir uno nuevo)
            if (!isOpen) {
                // Si quieres que se cierren los demás del mismo grupo:
                const groupParent = parent.parentElement; // El div .group-content
                groupParent.querySelectorAll('.main-content').forEach(c => c.style.gridTemplateRows = '0fr');
                groupParent.querySelectorAll('.accordion-icon').forEach(i => i.style.transform = 'rotate(0deg)');
            }

            content.style.gridTemplateRows = isOpen ? '0fr' : '1fr';
            icon.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
        });
    });

    document.querySelectorAll('.sub-trigger').forEach(trigger => {
        trigger.addEventListener('click', (e) => {
            e.stopPropagation();
            const parent = trigger.parentElement;
            const content = parent.querySelector('.sub-content');
            const arrow = trigger.querySelector('.arrow-sub');
            const isOpen = content.style.gridTemplateRows === '1fr';

            content.style.gridTemplateRows = isOpen ? '0fr' : '1fr';
            arrow.style.transform = isOpen ? 'rotate(0deg)' : 'rotate(180deg)';
        });
    });
</script>