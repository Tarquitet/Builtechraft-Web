---
import RuleBlock from './RuleBlock.astro';
import { getDictionary, getLocaleFromPath } from '../../lib/i18n';

interface Props {
  id: string;
  title: string;
  icon: string;
  rules: Array<any>;
}
const { id, title, icon, rules } = Astro.props;

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
---

<div id={`section-${id}`} class="scroll-mt-24 mb-12">
  <div class="flex items-center gap-3 mb-6 flex-wrap border-b border-theme-1 pb-4">
    <div class="w-12 h-12 border border-btc-orange/30 bg-btc-orange/10 flex items-center justify-center shrink-0">
      <span class="text-2xl">{icon}</span>
    </div>
    <div class="flex-1 min-w-0">
      <span class="text-xs font-bold uppercase tracking-widest text-btc-orange">
        {dict.common.rules.section} {id}
      </span>
      <h3 class="text-xl font-display font-bold text-theme-main mt-1">{title}</h3>
    </div>
  </div>
  <div class="pl-2">
    {rules.map((rule) => (
      <RuleBlock num={rule.num} items={rule.items} />
    ))}
  </div>
</div>