---
import { getRulesData } from '../../utils/sheetsClient.js';
import { getDictionary, getLocaleFromPath } from '../../lib/i18n';
import RuleSection from './RuleSection.astro';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
const data = await getRulesData(locale);
---

<section id="reglas" class="py-24 bg-theme-panel relative min-h-screen">
  <div class="container mx-auto px-6 max-w-4xl relative z-10">
    
    <div class="text-center mb-12">
      <h2 class="text-4xl md:text-5xl font-display font-bold text-theme-main uppercase tracking-tight">
        {dict.common.rules.title}
      </h2>
      <p class="text-theme-muted text-base mt-4 max-w-2xl mx-auto">
        {dict.common.rules.description}
      </p>
    </div>

    {data && data.sections && data.sections.length > 0 ? (
      <div class="space-y-10">
        {data.sections.map((section: any) => (
          <RuleSection 
            id={section.id}
            title={section.title}
            icon={section.icon}
            rules={section.rules}
          />
        ))}
      </div>
    ) : (
      <div class="text-center py-20 text-theme-muted border border-dashed border-theme-1 rounded-lg">
        <p>{dict.common.rules.loading}</p>
      </div>
    )}

  </div>
</section>