---
// src/components/access/AccessWizard.astro
import links from '../../data/links.json';
import { getDictionary, getLocaleFromPath, localizePath } from '../../lib/i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const accessDictionary = getDictionary(locale).access;
const stepTranslations = accessDictionary.steps as unknown as Record<string, any>;
const rulesUrl = localizePath(links.pages?.rules || '/rules', locale);

interface WizardStep {
  step: number;
  type: 'rules' | 'grid' | 'guide';
  translationKey: string;
  label?: string;
  title?: string;
  items?: any[];
  content?: string;
  buttonText?: string;
}

const defaultModules = import.meta.glob('../../data/access/*.json', { eager: true, import: 'default' }) as Record<string, WizardStep>;
const wizardSteps: WizardStep[] = Object.values(defaultModules)
  .filter((data) => data && typeof data.step === 'number')
  .map((step: WizardStep) => {
    const translation: any = stepTranslations[step.translationKey];
    const items = step.items?.map((item: any) => {
      const itemTranslation: any = translation.items?.[item.translationKey || item.id] || {};
      const translatedGuideSteps = item.steps?.map((guideStep: any, index: number) => ({
        ...guideStep,
        ...itemTranslation.steps?.[index],
      }));

      return {
        ...item,
        ...itemTranslation,
        steps: translatedGuideSteps || item.steps,
      };
    });

    return { ...step, ...translation, items };
  })
  .sort((a, b) => a.step - b.step);
---

<style is:global>
  .hide-scrollbar {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }
  .hide-scrollbar::-webkit-scrollbar {
    display: none;
  }
</style>

<section id="access-wizard-section" class="py-12 md:py-24 bg-theme-section relative">
  <div class="container mx-auto px-6 max-w-6xl relative z-10">
    
    <div class="mb-8 md:mb-16" id="progress-bar-container"></div>

    <div class="bg-theme-card p-6 md:p-12" style="box-shadow: 8px 8px 0px rgba(0,0,0,0.5);">
      <div id="wizard-content"></div>
    </div>
  </div>
</section>

<script define:vars={{ wizardSteps, links, ui: accessDictionary.ui, locale, rulesUrl }}>
  // @ts-nocheck
  document.addEventListener('DOMContentLoaded', async () => {
    let state = { currentStep: 1, selected: {}, rulesAccepted: false };
    const wizard = document.getElementById('access-wizard-section');
    const progressBar = document.getElementById('progress-bar-container');
    const content = document.getElementById('wizard-content');

    // 1. Configuración por defecto (fallback de seguridad)
    let serverConfig = { 
      JavaSmp: "btcsmp.tarquitet.com", 
      JavaCreative: "btccreative.tarquitet.com", 
      BedrockSmp: "btcsmp.tarquitet.com", 
      BedrockCreative: "btccreative.tarquitet.com", 
      BedrockPort: "19232", 
      JavaMin: "1.20.x", 
      JavaMax: "1.21.x", 
      BedrockVer: "1.20.x - 1.21.x" 
    };

    // 2. LEER LA CACHÉ GLOBAL que ya crea tu ConfigLoader.astro
    const cachedConfig = sessionStorage.getItem('btc_config');
    if (cachedConfig) {
      try {
        serverConfig = { ...serverConfig, ...JSON.parse(cachedConfig) };
      } catch (e) {}
    }

    // 3. Escuchar el evento por si el ConfigLoader apenas está terminando de cargar
    window.addEventListener('btc:config-loaded', (e) => {
      serverConfig = { ...serverConfig, ...e.detail };
      if (state.currentStep > 5) {
        renderGuide();
      }
    });

    function updateProgress() {
      progressBar.innerHTML = `
        <div class="flex items-center justify-center gap-0 overflow-x-auto hide-scrollbar py-2 px-2 md:px-0">
          ${wizardSteps.map((step, i) => {
            const isActive = step.step <= state.currentStep;
            const isCurrent = step.step === state.currentStep;
            const isLast = i === wizardSteps.length - 1;
            return `
              <div class="flex items-center shrink-0">
                <div class="flex flex-col items-center px-1 md:px-3">
                  <div class="w-8 h-8 md:w-12 md:h-12 rounded-full flex items-center justify-center font-display font-bold text-sm md:text-xl transition-all duration-300 ${
                    isActive 
                      ? 'bg-btc-orange text-white border-2 border-btc-orange' 
                      : 'bg-transparent text-slate-500 dark:text-white/40 border-2 border-slate-300 dark:border-white/30'
                  } ${isCurrent ? 'scale-110 ring-4 ring-btc-orange/30' : ''}">
                    ${step.step}
                  </div>
                  <span class="text-[10px] md:text-sm uppercase font-display font-bold whitespace-nowrap mt-1 md:mt-2 ${
                    isCurrent ? 'text-btc-orange' : isActive ? 'text-slate-700 dark:text-white/70' : 'text-slate-500 dark:text-white/40'
                  } transition-colors duration-300 hidden md:block">${step.label}</span>
                </div>
                ${!isLast ? `<div class="w-3 md:w-10 h-0.5 md:h-1 ${
                  isActive && wizardSteps[i + 1]?.step <= state.currentStep 
                    ? 'bg-btc-orange' 
                    : 'bg-slate-300 dark:bg-white/20'
                } transition-colors duration-300 rounded"></div>` : ''}
              </div>
            `;
          }).join('')}
        </div>
      `;
    }

    function renderRules() {
      const step = wizardSteps.find(s => s.step === 1);
      content.innerHTML = `
        <div class="text-center max-w-2xl mx-auto">
          <div class="mb-8">
            <h3 class="text-3xl md:text-4xl font-display font-bold text-theme-main uppercase tracking-tight mb-6">${step?.title || ui.rulesTitle}</h3>
            <p class="text-theme-muted text-lg leading-relaxed mb-8">${step?.content || ui.rulesDescription}</p>
            <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-8">
              <a href="${rulesUrl}" target="_blank" rel="noopener noreferrer" class="px-8 py-4 bg-btc-orange text-white font-bold uppercase tracking-wider text-sm hover:bg-btc-orange/90 transition-all" style="box-shadow: 4px 4px 0px rgba(0,0,0,0.5);">
                ${ui.readRules}
              </a>
            </div>
          </div>
          <label class="flex items-center justify-center gap-3 cursor-pointer select-none group mb-6">
            <input type="checkbox" id="accept-rules-checkbox" class="w-5 h-5 accent-btc-orange cursor-pointer rounded" />
            <span class="text-sm text-theme-muted group-hover:text-theme-main transition-colors">${ui.acceptRules}</span>
          </label>
          <button id="btn-continue-rules" disabled class="px-10 py-5 bg-btc-orange text-white font-bold uppercase tracking-wider text-lg transition-all disabled:opacity-30 disabled:cursor-not-allowed disabled:grayscale" style="box-shadow: 6px 6px 0px rgba(0,0,0,0.5);">
            ${step?.buttonText || ui.acceptContinue}
          </button>
        </div>
      `;

      const checkbox = document.getElementById('accept-rules-checkbox');
      const btn = document.getElementById('btn-continue-rules');
      checkbox?.addEventListener('change', () => { if (btn) btn.disabled = !checkbox.checked; });
      btn?.addEventListener('click', () => {
        if (checkbox?.checked) {
          state.rulesAccepted = true;
          goToStep(2);
        }
      });
    }

    // ===== AQUÍ ESTÁ LA FUNCIÓN CORREGIDA CON EL DISEÑO HORIZONTAL EN MÓVIL =====
    function renderGrid(stepNum) {
      const currentStepData = wizardSteps.find(s => s.step === stepNum);
      if (!currentStepData) return;

      const filtered = currentStepData.items.filter((item) => {
        if (item.platforms && state.selected.platform && !item.platforms.includes(state.selected.platform)) return false;
        if (item.editions && state.selected.edition && !item.editions.includes(state.selected.edition)) return false;
        if (item.accountTypes && state.selected.accountType && !item.accountTypes.includes(state.selected.accountType)) return false;
        return true;
      });

      content.innerHTML = `
        <div class="mb-8">
          ${stepNum > 1 ? `<div class="mb-6"><button class="px-6 py-3 border-2 border-theme-1 text-theme-muted hover:text-btc-orange hover:border-btc-orange transition-all font-bold uppercase tracking-wider text-sm" id="btn-back-mobile">← ${ui.back}</button></div>` : ''}
          <h3 class="text-2xl md:text-4xl font-display font-bold text-theme-main uppercase tracking-tight text-center">${currentStepData.title}</h3>
        </div>
        
        <!-- Layout responsive: horizontal en móvil, vertical en desktop -->
        <div class="flex flex-col md:grid md:grid-cols-2 lg:grid-cols-3 gap-4 md:gap-6">
          ${filtered.map((item) => `
            <button class="group grid-item-btn flex md:flex-col items-center md:items-stretch gap-4 md:gap-0 p-4 md:p-0 bg-theme-card border-2 border-theme-1 hover:border-btc-orange transition-all text-left md:text-center" data-id="${item.id}" style="box-shadow: 4px 4px 0px rgba(0,0,0,0.3);">
              
              <!-- Imagen: pequeña a la izquierda en móvil, grande arriba en desktop -->
              <div class="w-16 h-16 md:w-full md:h-32 flex items-center justify-center bg-theme-alternate border border-theme-1 shrink-0 md:mb-0 overflow-hidden" style="box-shadow: 3px 3px 0px rgba(0,0,0,0.3);">
                ${item.image ? `<img src="${item.image}" alt="${item.name}" class="w-full h-full object-contain group-hover:scale-105 transition-transform" />` : `<div class="text-2xl md:text-4xl">${item.icon || '📦'}</div>`}
              </div>
              
              <!-- Texto: a la derecha en móvil, abajo en desktop -->
              <div class="flex-1 min-w-0 flex flex-col justify-center md:pt-4 md:pb-2">
                <h4 class="text-sm md:text-base font-display font-bold uppercase tracking-wide text-theme-main leading-tight line-clamp-2">${item.name}</h4>
              </div>
              
            </button>
          `).join('')}
        </div>
      `;

      document.getElementById('btn-back-mobile')?.addEventListener('click', goBack);

      content.querySelectorAll('.grid-item-btn').forEach((btn) => {
        btn.addEventListener('mouseenter', () => { 
          btn.style.borderColor = 'var(--btc-orange, #ea580c)';
        });
        btn.addEventListener('mouseleave', () => { 
          btn.style.borderColor = '';
        });
        btn.addEventListener('click', () => {
          const key = currentStepData.step === 3 ? 'edition' : currentStepData.step === 5 ? 'launcher' : currentStepData.step === 4 ? 'accountType' : 'platform';
          state.selected[key] = btn.getAttribute('data-id');
          goNext();
        });
      });
    }

    function renderGuide() {
      const guideStep = wizardSteps.find(s => s.type === 'guide');
      
      let guide;
      if (state.selected.accountType) {
        guide = guideStep.items.find((g) => g.account === state.selected.accountType);
      }
      if (!guide) {
        guide = guideStep.items.find((g) => g.edition === state.selected.edition) || guideStep.items[0];
      }
      
      if (!guide) {
        content.innerHTML = `<p class="text-center text-theme-muted">${ui.guideMissing}</p>`;
        return;
      }
  
      const displayVersion = state.selected.edition === 'bedrock' ? serverConfig.BedrockVer : serverConfig.JavaMax;

      content.innerHTML = `
        <div class="mb-12">
          <div class="mb-8"><button class="px-6 py-3 border-2 border-theme-1 text-theme-muted hover:text-btc-orange hover:border-btc-orange transition-all font-bold uppercase tracking-wider text-sm" id="btn-back-mobile">← ${ui.back}</button></div>
          <h3 class="text-2xl md:text-4xl font-display font-bold text-theme-main uppercase tracking-tight text-center">${guideStep.title}</h3>
        </div>
        
        <div class="max-w-3xl mx-auto mb-12">
          ${guide.steps.map((s, i) => {
            let desc = (s.description || "")
              .replace(/{javaSmp}/g, serverConfig.JavaSmp)
              .replace(/{javaCreative}/g, serverConfig.JavaCreative)
              .replace(/{bedrockSmp}/g, serverConfig.BedrockSmp)
              .replace(/{bedrockCreative}/g, serverConfig.BedrockCreative)
              .replace(/{bedrockPort}/g, serverConfig.BedrockPort)
              .replace(/{ip}/g, state.selected.edition === 'bedrock' ? serverConfig.BedrockSmp : serverConfig.JavaSmp)
              .replace(/{port}/g, state.selected.edition === 'bedrock' ? serverConfig.BedrockPort : "")
              .replace(/{version}/g, displayVersion);
            
            return `
              <div class="mb-12 last:mb-0">
                ${s.image ? `
                  <div class="mb-6">
                    <img src="${s.image}" alt="${s.title}" class="w-full max-w-[90%] mx-auto border border-theme-1" style="box-shadow: 6px 6px 0px rgba(0,0,0,0.4);" />
                  </div>
                ` : ''}
                <span class="text-sm font-bold uppercase tracking-widest text-btc-orange block mb-2">${ui.step} ${i + 1}</span>
                <h4 class="text-xl md:text-2xl font-display font-bold text-theme-main mb-3">${s.title}</h4>
                <p class="text-base text-theme-muted leading-relaxed whitespace-pre-line">${desc}</p>
              </div>
            `;
          }).join('')}
        </div>
        
        <div class="text-center pt-8">
          <button id="btn-reset" class="px-8 py-4 border-2 border-theme-1 text-theme-muted hover:text-btc-orange hover:border-btc-orange transition-all font-bold uppercase tracking-wider text-sm">${ui.backToTop}</button>
        </div>
      `;

      document.getElementById('btn-back-mobile')?.addEventListener('click', goBack);
      document.getElementById('btn-reset')?.addEventListener('click', () => { wizard.scrollIntoView({ behavior: 'smooth', block: 'start' }); });
    }

    function goNext() {
      const currentStepData = wizardSteps.find(s => s.step === state.currentStep);
      if (currentStepData?.items) {
        const selectedItem = currentStepData.items.find(item => {
            const key = currentStepData.step === 3 ? 'edition'
              : currentStepData.step === 5 ? 'launcher'
              : currentStepData.step === 4 ? 'accountType'
              : 'platform';
          return item.id === state.selected[key];
        });
        
        if (selectedItem?.skipTo) {
          goToStep(selectedItem.skipTo);
          return;
        }
      }

      let nextNum = state.currentStep + 1;
      while (nextNum <= 5) {
        const nextStepData = wizardSteps.find(s => s.step === nextNum);
        if (nextStepData?.type === 'grid' && nextStepData.items) {
          const filtered = nextStepData.items.filter((item) => {
            if (item.platforms && state.selected.platform && !item.platforms.includes(state.selected.platform)) return false;
            if (item.editions && state.selected.edition && !item.editions.includes(state.selected.edition)) return false;
            if (item.accountTypes && state.selected.accountType && !item.accountTypes.includes(state.selected.accountType)) return false;
            return true;
          });
          if (filtered.length > 0) break;
        } else {
          break;
        }
        nextNum++;
      }
      goToStep(nextNum);
    }

    function goBack() {
      let prevNum = state.currentStep - 1;
      while (prevNum >= 2) {
        const prevStepData = wizardSteps.find(s => s.step === prevNum);
        if (prevStepData?.type === 'grid' && prevStepData.items) {
          const filtered = prevStepData.items.filter((item) => {
            if (item.platforms && state.selected.platform && !item.platforms.includes(state.selected.platform)) return false;
            if (item.editions && state.selected.edition && !item.editions.includes(state.selected.edition)) return false;
            if (item.accountTypes && state.selected.accountType && !item.accountTypes.includes(state.selected.accountType)) return false;
            return true;
          });
          if (filtered.length > 0) break;
        } else {
          break;
        }
        prevNum--;
      }
      goToStep(prevNum);
    }

    function goToStep(stepNum) {
      state.currentStep = stepNum;
      updateProgress();
      
      if (stepNum === 1) renderRules();
      else if (stepNum <= 5) renderGrid(stepNum);
      else renderGuide();
    }

    updateProgress();
    goToStep(1);
  });
</script>