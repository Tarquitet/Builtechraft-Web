---
// src/components/donation/DonationMini.astro
import links from '../../data/links.json';
---

<section id="donacion-section" class="py-8 bg-theme-alternate border-t border-theme relative z-10">
    <div class="container mx-auto px-6 max-w-5xl">
        
        {/* BANNER COMPACTO TIPO ANUNCIO */}
        <div class="flex flex-col sm:flex-row items-center justify-between gap-4 bg-theme-card border-theme-1  p-5 md:p-6 hover:border-pink-500/40 transition-colors">
            
            <div class="flex items-center gap-4 text-center sm:text-left">
                <span class="text-4xl shrink-0 select-none">☕</span>
                <div>
                    <h2 class="text-lg md:text-xl font-display font-bold text-theme-main uppercase tracking-tight">
                        ¿Disfrutas Builtechraft? <span class="text-pink-500">Invítanos un café</span>
                    </h2>
                    <p class="text-theme-muted text-xs md:text-sm leading-relaxed mt-1">
                        Desde 2020 el servidor vive de pura constancia y amor. Puedes invitarnos un café para apoyarnos.
                    </p>
                </div>
            </div>
            
            <a
                href={links.social.donate}
                data-target="donacion"
                target="_blank"
                rel="noopener noreferrer"
                class="shrink-0 inline-flex items-center gap-2 bg-pink-500/10 hover:bg-pink-600 text-pink-500 hover:text-white border border-pink-500/30 px-6 py-3  font-bold uppercase text-xs tracking-widest transition-all"
            >
                <span>Donar</span>
            </a>
            
        </div>
        
    </div>
</section>