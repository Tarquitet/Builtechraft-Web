---
import LanguagePicker from './navbar/LanguagePicker.astro';
const currentYear = new Date().getFullYear();
---
<footer class="bg-black border-t border-white/5 pt-16 pb-6 relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        
        <div class="hidden md:grid grid-cols-12 gap-12 border-b border-white/10 pb-12 mb-8">
            
            <!-- Columna Izquierda: Agradecimiento -->
            <div class="col-span-12 md:col-span-5 lg:col-span-4">
                <img src="/images/logo-text.webp" alt="Builtechraft" class="h-8 w-auto mb-6" loading="lazy" />
                <h4 class="text-white font-bold tracking-widest text-xs uppercase mb-3">Gracias por vernos</h4>
                <p class="text-zinc-400 text-sm leading-relaxed">
                    Builtechraft es un proyecto hecho con pasión. Agradecemos a cada jugador que entra a dejar su huella, a construir y a formar parte de nuestra historia.
                </p>
            </div>

            <!-- Columna Central: Soporte -->
            <div class="col-span-12 md:col-span-3 lg:col-span-4">
                <div class="flex flex-col gap-4">
                    <h4 class="text-white font-bold tracking-widest text-xs uppercase mb-1">Guías y Soporte</h4>
                    <a href="/rules" class="text-zinc-400 hover:text-btc-orange transition-colors text-sm font-medium">Normativas Oficiales</a>
                    <a href="https://tarquitet.gitbook.io/builtechaft-wiki" target="_blank" class="text-zinc-400 hover:text-btc-orange transition-colors text-sm font-medium">Wiki y Tutoriales</a>
                    <a href="https://discord.gg/4KzRH5DPzx" target="_blank" rel="noopener noreferrer" class="text-zinc-400 hover:text-btc-orange transition-colors text-sm font-medium">Soporte en Discord</a>
                </div>
            </div>

            <!-- Columna Derecha: Enlaces de Referencia -->
            <div class="col-span-12 md:col-span-4 lg:col-span-4 flex flex-col gap-4 md:items-end">
                <div class="flex flex-col gap-4 md:items-end">
                    <h4 class="text-white font-bold tracking-widest text-xs uppercase mb-1">Inspiraciones</h4>
                    <a href="https://hermitcraft.com/" target="_blank" class="text-zinc-500 hover:text-zinc-300 transition-colors text-xs font-medium">Hermitcraft</a>
                    <a href="https://fanlore.org/wiki/Karmaland" target="_blank" class="text-zinc-500 hover:text-zinc-300 transition-colors text-xs font-medium">Karmaland</a>
                    <a href="https://qsmp.live/" target="_blank" class="text-zinc-500 hover:text-zinc-300 transition-colors text-xs font-medium">QSMP</a>
                    <a href="https://fanlore.org/wiki/Mindcrack" target="_blank" class="text-zinc-500 hover:text-zinc-300 transition-colors text-xs font-medium">Mindcrack</a>
                </div>
            </div>

        </div>

        <div class="flex flex-col md:flex-row items-center justify-between text-center md:text-left gap-6 pt-2">
            
            <div class="text-zinc-500 text-xs font-mono">
                <p>&copy; {currentYear} <span class="text-btc-orange font-bold">Builtechraft</span> - Todos los derechos reservados.</p>
                <p class="text-[10px] mt-1 opacity-70">No afiliado con Mojang AB ni Microsoft.</p>
            </div>

            <!-- Selector de Idioma reubicado aquí -->
            <div class="flex items-center gap-4">
                <LanguagePicker />
            </div>

            <div class="flex flex-col md:flex-row items-center gap-2 text-xs font-mono text-zinc-500">
                <span class="opacity-70">Developed by</span>
                <a 
                    href="https://web.tarquitet.com" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 bg-white/5 px-3 py-1.5 rounded-full border border-white/10 hover:border-btc-orange/50 hover:bg-white/10 transition-all duration-300"
                >
                    <span class="text-zinc-300 font-bold group-hover:text-btc-yellow transition-colors text-xs">
                        Tarquitet
                    </span>
                </a>
            </div>

        </div>

    </div>
</footer>