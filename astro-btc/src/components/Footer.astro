---
// src/components/Footer.astro
const currentYear = new Date().getFullYear();
---

<footer class="bg-[#272727] py-8 mt-auto relative">
    <div class="absolute top-0 right-0 w-1/3 h-full bg-btc-orange/5 blur-[80px] pointer-events-none"></div>

    <div class="container mx-auto px-6 flex flex-col md:flex-row justify-between items-center gap-6 relative z-10">
        
        <div class="text-xs font-medium text-zinc-400 uppercase tracking-widest text-center md:text-left">
            <span class="text-btc-orange font-bold">Builtechraft</span> © {currentYear}
            <span class="hidden md:inline mx-2 opacity-80">|</span>
            <span class="block md:inline mt-1 md:mt-0 opacity-90">No afiliado con Mojang AB.</span>
        </div>

        <a href="https://web.tarquitet.com" target="_blank" class="group flex items-center gap-2">
            <span class="hidden md:block text-[10px] text-gray-200 uppercase tracking-[0.2em] group-hover:text-amber-400 transition-colors">
                Code by
            </span>
            
            <span class="text-sm font-display font-bold text-white group-hover:text-btc-orange transition-colors duration-300 uppercase">
                TARQUITET
            </span>
        </a>
    </div>
</footer>