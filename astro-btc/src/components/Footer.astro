---
const currentYear = new Date().getFullYear();
---

<footer class="bg-black border-t border-white/5 py-12 relative overflow-hidden">

    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
            
            <div class="text-zinc-300 text-sm font-mono">
                <p>&copy; {currentYear} <span class="text-btc-orange font-bold">Builtechraft</span> - Todos los derechos reservados.</p>
                <p class="text-xs mt-1 opacity-90">No afiliado con Mojang AB.</p>
            </div>

            <div class="flex flex-col md:flex-row items-center gap-2 text-sm font-mono text-zinc-300">
                
                <span class="opacity-90">Develop by</span>
                
                <a 
                    href="https://web.tarquitet.com" 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="group flex items-center gap-2 bg-white/5 px-3 py-1 rounded-full border border-white/10 hover:border-btc-orange/50 hover:bg-white/10 transition-all duration-300"
                >
                    <span class="text-white font-bold group-hover:text-btc-yellow transition-colors">
                        Tarquitet
                    </span>
                    <svg class="w-3 h-3 text-zinc-500 group-hover:text-btc-yellow transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                    </svg>
                </a>
            </div>

        </div>
    </div>
</footer>