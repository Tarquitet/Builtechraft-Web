---
// src/components/About.astro

let historias: any[] = [];
let fundador: any = null;
let FundadorContent: any = null;

try {
  // 1. Usamos import.meta.glob para obtener una lista de funciones de carga.
  // La ruta es relativa al archivo actual.
  const histFiles = import.meta.glob('../data/historia/*.md');
  const fundFiles = import.meta.glob('../data/fundador.md');

  // 2. Ejecutamos las funciones para cargar los archivos
  const histPromises = Object.values(histFiles).map((load) => load());
  const fundPromises = Object.values(fundFiles).map((load) => load());

  const histResults = await Promise.all(histPromises);
  const fundResults = await Promise.all(fundPromises);

  // 3. Ordenamos las historias (Astro no garantiza orden con glob)
  historias = histResults.sort((a: any, b: any) => a.file.localeCompare(b.file));
  
  if (fundResults.length > 0) {
    fundador = fundResults[0];
    FundadorContent = fundador.Content;
  }
} catch (error) {
  console.error("⚠️ Error cargando archivos Markdown:", error);
}
---

<section class="bg-theme-panel transition-colors duration-300 relative overflow-hidden">
  <div class="py-24 relative">
    <div class="container mx-auto px-6 relative z-10">
      
      {/* TÍTULO PRINCIPAL CENTRADO */}
      <div class="w-full flex justify-center mb-24">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-theme-main uppercase tracking-tight text-center">
          Nuestra <span class="text-theme-accent">Historia</span>
        </h2>
      </div>

      {/* RENDERIZADO DESDE MARKDOWN RESPETANDO TU CÓDIGO ORIGINAL */}
      {historias.length === 0 ? (
        <div class="text-center text-theme-muted py-12">No hay historias publicadas aún.</div>
      ) : (
        historias.map((bloque, index) => {
          const StoryContent = bloque.Content; 
          const isReverse = index % 2 !== 0; // Alterna la posición de la imagen
          
          return (
            <div class={`flex flex-col items-center gap-16 mb-32 ${isReverse ? 'md:flex-row-reverse' : 'md:flex-row'}`}>
              
              <div class="w-full md:w-1/2">
                <div class={`relative group rounded-3xl overflow-hidden shadow-theme border border-theme transition-all duration-500 ${bloque.frontmatter.border_clase || 'hover:border-btc-orange/50'}`}>
                  <div class="absolute inset-0 bg-btc-orange/5 group-hover:bg-transparent transition-colors z-10"></div>
                  <img
                    src={bloque.frontmatter.imagen}
                    class="w-full h-full object-cover aspect-video transform group-hover:scale-105 transition-transform duration-700"
                    alt={bloque.frontmatter.titulo_color}
                    loading="lazy" decoding="async"
                  />
                </div>
              </div>

              <div class="w-full md:w-1/2">
                <h2 class="text-3xl md:text-4xl font-display font-bold text-theme-main mb-6 uppercase tracking-tighter">
                  {bloque.frontmatter.titulo_blanco} <span class={bloque.frontmatter.color_clase || 'text-btc-yellow'}>{bloque.frontmatter.titulo_color}</span>
                </h2>

                <div class="text-theme-muted text-lg leading-relaxed text-justify space-y-6 
                            [&_a]:text-btc-orange [&_a:hover]:text-theme-main [&_a]:transition-colors [&_a]:underline [&_a]:underline-offset-4 [&_a]:decoration-btc-orange/30
                            [&_strong]:text-btc-orange [&_strong]:font-bold [&_em]:text-theme-main">
                  <StoryContent />
                </div>
              </div>

            </div>
          );
        })
      )}
    </div>
  </div>

  {/* --- SECCIÓN OSCURA DEL FUNDADOR (TU CÓDIGO INTACTO) --- */}
  {fundador && FundadorContent && (
    <div class="bg-[#272727] py-24 border-t border-white/5 relative">
      <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col lg:flex-row items-center gap-16">
          
          <div class="w-full lg:w-7/12">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-white mb-8 uppercase tracking-tighter">
              {fundador.frontmatter.titulo_blanco} <span class="text-btc-orange">{fundador.frontmatter.titulo_color}</span> {fundador.frontmatter.titulo_sufijo}
            </h2>
            
            <div class="text-zinc-300 text-lg leading-relaxed text-justify space-y-6 mb-8
                        [&_strong]:text-white">
              <FundadorContent />
            </div>
            
            <div class="bg-black/40 p-8 rounded-2xl border-l-4 border-btc-orange backdrop-blur-sm">
              <p class="text-white italic text-lg leading-relaxed opacity-90">
                "{fundador.frontmatter.cita}"
              </p>
            </div>
          </div>
          
          <div class="w-full lg:w-5/12 flex justify-center">
            <div class="relative w-full max-w-md aspect-3/4 rounded-3xl overflow-hidden border-2 border-white/10 shadow-2xl group">
              <div class="absolute inset-0 bg-linear-to-b from-transparent via-transparent to-black/90 z-10"></div>
              <img src={fundador.frontmatter.imagen} alt={fundador.frontmatter.nombre} loading="lazy" decoding="async" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
              <div class="absolute bottom-0 left-0 w-full p-8 z-20">
                <h3 class="text-3xl font-display font-bold text-white uppercase">{fundador.frontmatter.nombre}</h3>
                <div class="h-1 w-12 bg-btc-orange rounded-full my-2"></div>
                <p class="text-zinc-400 text-sm tracking-widest uppercase">{fundador.frontmatter.rol}</p>
              </div>
            </div>
          </div>

        </div>
      </div>
    </div>
  )}
</section>