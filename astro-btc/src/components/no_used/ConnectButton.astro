---
// No necesitamos importar nada de versiones aquí
---

<div class="flex flex-col items-center mt-4 w-full max-w-2xl mx-auto z-20 relative animate-fade-in-up">
  <button
    id="connect-btn"
    class="w-full md:w-auto font-bold px-6 py-3 rounded-xl transition-all duration-300 uppercase text-xs tracking-widest cursor-pointer flex items-center justify-center gap-2 group/btn bg-btc-orange text-white hover:bg-white hover:text-btc-orange shadow-lg shadow-btc-orange/10"
  >
    <span>Conectarse</span>
    <svg
      class="w-4 h-4 group-hover/btn:translate-x-1 transition-transform"
      fill="none"
      stroke="currentColor"
      viewBox="0 0 24 24"
    >
      <path strokeLinecap="round" strokeLinejoin="round" strokeWidth="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
    </svg>
  </button>
</div>

<script>
  // Solo la lógica del scroll
  document.getElementById('connect-btn')?.addEventListener('click', () => {
    document.getElementById('ips')?.scrollIntoView({ behavior: 'smooth' });
  });

  // Forzamos el modo luz y el título al cargar la página
  document.documentElement.classList.add('light');
  document.title = "Builtechraft SMP - Minecraft Server";
</script>