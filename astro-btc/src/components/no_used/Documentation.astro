---
// src/components/Documentation.astro
---
<section class="py-24 bg-docs-gradient relative overflow-hidden transition-all duration-500">

    <div class="container mx-auto px-6 flex flex-col md:flex-row items-center gap-12 max-w-6xl relative z-10">
        
        <div class="w-full md:w-1/2 text-center md:text-left">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-(--grad-mod-text) mb-4 uppercase tracking-tight">
                Documentación <span class="text-(--text-modrinth)">Pública</span>
            </h2>
            
            <div class="h-1.5 w-24 bg-(--text-modrinth) mb-8 mx-auto md:mx-0 rounded-full"></div>
            
            <p class="text-(--grad-mod-text) text-lg leading-relaxed mb-8 opacity-90 text-justify md:text-left">
                Creemos en la transparencia total. Mantenemos una hoja de cálculo actualizada en tiempo real donde detallamos:
            </p>

            <ul class="space-y-4 text-lg text-(--grad-mod-text) inline-block text-left w-full">
                <li class="flex items-center gap-4 p-3 bg-black/20 rounded-xl backdrop-blur-sm">
                    <span class="text-(--text-modrinth) text-xl">✔</span> 
                    <span>Lista de Mods instalados</span>
                </li>
                <li class="flex items-center gap-4 p-3 bg-black/20 rounded-xl backdrop-blur-sm">
                    <span class="text-(--text-modrinth) text-xl">✔</span> 
                    <span>Reglas de Carpet Mod activas</span>
                </li>
                <li class="flex items-center gap-4 p-3 bg-black/20 rounded-xl backdrop-blur-sm">
                    <span class="text-(--text-modrinth) text-xl">✔</span> 
                    <span>Configuraciones del servidor</span>
                </li>
            </ul>
        </div>

        <div class="w-full md:w-1/2">
            <a href="https://docs.google.com/spreadsheets/d/1Iz5vklWMbVcgOCYRVN5NOEBX91VLfOCkHtI5ilxut-c/edit?usp=sharing" target="_blank" 
               class="block group relative bg-black/50 p-10 rounded-3xl overflow-hidden transition-all duration-300 hover:bg-white hover:scale-105 shadow-2xl">
                
                <div class="relative z-10 flex flex-col items-center justify-center text-center h-full gap-6">
                    <div class="w-20 h-20 bg-emerald-500/20 rounded-2xl flex items-center justify-center group-hover:bg-emerald-500/10 transition-colors border border-emerald-500/20">
                        <svg class="w-10 h-10 text-emerald-500" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                    </div>

                    <div>
                        <h3 class="text-2xl font-bold text-white group-hover:text-emerald-600 transition-colors mb-2">
                            Abrir Google Sheets
                        </h3>
                        <p class="text-zinc-300 group-hover:text-zinc-600 text-lg">
                            Control de Mods & Reglas Técnicas
                        </p>
                    </div>
                    
                    <div class="text-emerald-500 font-bold text-sm uppercase tracking-widest border-b-2 border-transparent group-hover:border-emerald-500 transition-all">
                        Ver Documento Oficial
                    </div>
                </div>
            </a>
        </div>

    </div>
</section>