---
// src/components/Mods.astro
---

<section id="descargas" class="py-20 bg-theme-main transition-colors duration-300 border-t border-gray-700/20">
    <div class="container mx-auto px-6 text-center">
        
        <div class="max-w-3xl mx-auto mb-12">
            <h2 class="text-3xl font-display font-bold text-theme-main mb-4">CONTROL <span class="text-btc-gold">TÉCNICO</span></h2>
            <p class="text-theme-muted">
                Transparencia total. Recomendamos jugar con Fabric para ver las texturas custom, shaders y optimización.
            </p>
        </div>

        <div class="flex flex-col md:flex-row justify-center gap-6 max-w-4xl mx-auto">
            
            <a href="https://modrinth.com/modpack/builtechraft-mods" target="_blank" class="flex-1 group relative overflow-hidden rounded-xl border border-green-500/30 bg-[#1BD96A]/5 hover:bg-[#1BD96A]/10 transition-all p-8 text-left">
                <div class="flex items-center gap-4 mb-4">
                    <div class="bg-green-500/20 p-3 rounded-lg text-green-400">
                        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 17.93c-3.95-.49-7-3.85-7-7.93 0-.62.08-1.21.21-1.79L9 15v1c0 1.1.9 2 2 2v1.93zm6.9-2.54c-.26-.81-1-1.39-1.9-1.39h-1v-3c0-.55-.45-1-1-1H8v-2h2c.55 0 1-.45 1-1V7h2c1.1 0 2-.9 2-2v-.41c2.93 1.19 5 4.06 5 7.41 0 2.08-.8 3.97-2.1 5.39z"/></svg>
                    </div>
                    <div>
                        <h3 class="font-bold text-xl text-theme-main group-hover:text-green-400 transition-colors">Modpack Oficial</h3>
                        <span class="text-xs font-bold uppercase text-green-500 bg-green-500/10 px-2 py-0.5 rounded">Modrinth</span>
                    </div>
                </div>
                <p class="text-sm text-theme-muted mb-4">
                    La experiencia completa. Instalación automática y actualizaciones seguras.
                </p>
                <div class="text-green-500 font-bold text-sm group-hover:underline">Instalar →</div>
            </a>

            <a href="https://docs.google.com/spreadsheets/d/1Iz5vklWMbVcgOCYRVN5NOEBX91VLfOCkHtI5ilxut-c/edit?gid=1873356549" target="_blank" class="flex-1 group relative overflow-hidden rounded-xl border border-gray-700/50 bg-theme-panel hover:border-btc-gold/50 transition-all p-8 text-left">
                <div class="flex items-center gap-4 mb-4">
                    <div class="bg-blue-500/20 p-3 rounded-lg text-blue-400 group-hover:text-btc-gold transition-colors">
                        <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24"><path d="M19 3H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zM9 17H7v-7h2v7zm4 0h-2V7h2v10zm4 0h-2v-4h2v4z"/></svg>
                    </div>
                    <div>
                        <h3 class="font-bold text-xl text-theme-main group-hover:text-btc-gold transition-colors">Hoja de Control</h3>
                        <span class="text-xs font-bold uppercase text-blue-400 bg-blue-500/10 px-2 py-0.5 rounded">Google Sheets</span>
                    </div>
                </div>
                <p class="text-sm text-theme-muted mb-4">
                    Lista detallada de mods permitidos, addons de Carpet y configuraciones técnicas del servidor.
                </p>
                <div class="text-blue-400 font-bold text-sm group-hover:underline">Ver Documento →</div>
            </a>

        </div>
    </div>
</section>