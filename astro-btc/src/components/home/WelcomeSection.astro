---
// src/components/home/WelcomeSection.astro
import welcomeCards from '../../data/welcomeCards.json';
---

<section class="welcome-section">
    <div class="container mx-auto px-6 max-w-6xl">
        
        <div class="max-w-3xl mb-16">
            <span class="welcome-badge">
                ¿Qué es Builtechraft?
            </span>
            <h2 class="welcome-title">
                Survival para construir,
                <span class="text-btc-orange">sin perder la esencia de Vanilla</span>
            </h2>
            <p class="welcome-desc">
                Builtechraft es un servidor Survival privado pensado para quienes disfrutan construyendo, desde una pequeña casa hasta grandes proyectos.
                Está basado en Fabric y mantiene una experiencia cercana a Minecraft Vanilla con mejoras cuidadosamente seleccionadas.
            </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
            {welcomeCards.map((card) => (
                <article class="welcome-card">
                    <h3 class="welcome-card-title">
                        {card.title}
                    </h3>
                    <p class="welcome-card-desc">
                        {card.desc}
                    </p>
                </article>
            ))}
        </div>
    </div>
</section>