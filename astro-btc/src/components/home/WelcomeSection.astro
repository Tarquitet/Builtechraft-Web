---
// src/components/home/WelcomeSection.astro
import welcomeCards from '../../data/welcomeCards.json';
---

<section class="welcome-section">
    <div class="container mx-auto px-6 max-w-6xl">
        
        <div class="max-w-3xl mb-16">
            <h2 class="welcome-title">
                Qué es
                <span class="text-btc-orange">Builtechraft</span>
            </h2>
            <p class="welcome-desc">
                Builtechraft es un servidor Survival privado pensado para los jugadores que disfrutan construir y plasmar sus ideas, desde una pequeña casa hasta mega estructuras.</br>Está basado en el cargador de mods popular Fabric y mantiene una experiencia cercana a Minecraft Vanilla con mejoras cuidadosamente seleccionadas.
            </p>
        </div>

        <div class="grid gap-6 md:grid-cols-2">
            {welcomeCards.map((card) => (
                <article class="welcome-card">
                    <h3 class="welcome-card-title">
                        {card.title}
                    </h3>
                    <p class="welcome-card-desc">
                        {card.desc}
                    </p>
                </article>
            ))}
        </div>
    </div>
</section>