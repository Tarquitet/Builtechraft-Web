---
// src/components/home/StatsRow.astro
---

<section class="py-12 bg-black/40 border-y border-white/5 relative z-10">
    <div class="container mx-auto px-6 max-w-5xl">
        <div class="grid grid-cols-2 md:grid-cols-3 gap-8 text-center divide-x divide-transparent md:divide-white/10">
            
            <div class="flex flex-col items-center">
                <span id="stat-years" class="block text-4xl font-display font-bold text-btc-orange mb-2">?? Años</span>
                <span class="text-xs font-bold text-zinc-400 uppercase tracking-widest">Desde 2020</span>
            </div>

            <div class="flex flex-col items-center">
                <span id="stat-mods" class="block text-4xl font-display font-bold text-btc-yellow mb-2">??</span>
                <span class="text-xs font-bold text-zinc-400 uppercase tracking-widest">Mods/Datapacks</span>
            </div>

            <div class="flex flex-col items-center">
                <span id="stat-version" class="block text-4xl font-display font-bold text-btc-orange mb-2">???</span>
                <span class="text-xs font-bold text-zinc-400 uppercase tracking-widest">Versión Actual</span>
            </div>

        </div>
    </div>
</section>

<script>
    import { getModsAndDatapacks } from '../../utils/sheetsClient.js';

    // 1. CÁLCULO AUTOMÁTICO DE AÑOS DESDE EL 22 DE ENERO DE 2020
    const officialDate = new Date('2020-01-22');
    const now = new Date();
    
    let diffYears = now.getFullYear() - officialDate.getFullYear();
    const monthDiff = now.getMonth() - officialDate.getMonth();
    if (monthDiff < 0 || (monthDiff === 0 && now.getDate() < officialDate.getDate())) {
        diffYears--;
    }

    const yearsEl = document.getElementById('stat-years');
    if (yearsEl) {
        yearsEl.innerText = `${diffYears} Años`;
    }

    // 2. FETCH DIRECTO Y SEGURO DE MODS Y DATAPACKS
    async function loadStatsCounts() {
        try {
            const { mods, datapacks } = await getModsAndDatapacks();
            
            const modsEl = document.getElementById('stat-mods');
            if (modsEl && mods && datapacks) {
                const total = mods.length + datapacks.length;
                modsEl.innerText = `${total}`;
            }
        } catch (e) {
            console.warn("No se pudieron cargar los contadores en StatsRow:", e);
            // Fallback por si falla la red
            const modsEl = document.getElementById('stat-mods');
            if (modsEl) modsEl.innerText = "...";
        }
    }

    // 3. ESCUCHA TAMBIÉN DEL EVENTO GLOBAL DEL CONFIGLOADER (Para versión y otros datos)
    window.addEventListener('btc:config-loaded', (e: any) => {
        const data = e.detail;
        const versionEl = document.getElementById('stat-version');
        if (versionEl && data.JavaMax) {
            versionEl.innerText = data.JavaMax.replace('.x', '');
        }
    });

    // Ejecutar al cargar la página y en transiciones de ViewTransitions de Astro
    loadStatsCounts();
    document.addEventListener('astro:page-load', loadStatsCounts);
</script>