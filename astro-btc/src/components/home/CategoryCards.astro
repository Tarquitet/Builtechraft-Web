---
// src/components/home/CategoryCards.astro
import cards from '../../data/aboutCards.json';
import links from '../../data/links.json';

const getLink = (key: string | undefined | null): string => {
    if (!key) return '#';
    const l = links as any;
    if (key.includes('.')) {
        const val = key.split('.').reduce((acc, part) => (acc == null ? acc : acc[part]), l);
        return typeof val === 'string' ? val : '#';
    }
    const find = (obj: any): string | null => {
        for (const [k, v] of Object.entries(obj)) {
            if (k === key && typeof v === 'string') return v;
            if (typeof v === 'object' && v !== null) {
                const r = find(v);
                if (r) return r;
            }
        }
        return null;
    };
    return find(l) || '#';
};
---

<section class="py-24 bg-theme-section relative z-10 border-t border-theme">
    <div class="container mx-auto px-6 max-w-7xl">
        
        <div class="text-center mb-16">
            <h2 class="category-title">
                Explora <span class="text-btc-orange">Nuestra Página Web</span>
            </h2>
            <p class="category-subtitle">Aquí tienes los enlaces a las secciones principales de nuestra página web.</p>
        </div>

        <div class="card-retro grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
            
            {cards.map((card: any) => {
                const href = getLink(card.keyLink);
                return (
                    <a 
                        href={href} 
                        target={card.isExternal ? "_blank" : "_self"}
                        rel={card.isExternal ? "noopener noreferrer" : undefined}
                        class={`card-retro ${card.hoverBorder}`}
                    >
                        <div class={`w-16 h-16 flex items-center justify-center shrink-0 border mb-5 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3 shadow-inner ${card.iconBg}`}>
                            <Fragment set:html={card.iconSvg} />
                        </div>
                        
                        <h3 class={`text-lg font-display font-bold text-theme-main uppercase tracking-wide mb-2 transition-colors duration-300 ${card.titleHover}`}>
                            {card.title}
                        </h3>
                        
                        <p class="text-theme-muted text-sm leading-relaxed flex-grow">
                            {card.desc}
                        </p>
                    </a>
                );
            })}
            
        </div>
        
    </div>
</section>