---
import cards from '../../data/aboutCards.json';
import links from '../../data/links.json';

const getLink = (key: string | undefined | null): string => {
    if (!key) return '#';
    const l = links as any;
    if (key.includes('.')) {
        const val = key.split('.').reduce((acc, part) => (acc == null ? acc : acc[part]), l);
        return typeof val === 'string' ? val : '#';
    }
    const find = (obj: any): string | null => {
        for (const [k, v] of Object.entries(obj)) {
            if (k === key && typeof v === 'string') return v;
            if (typeof v === 'object' && v !== null) {
                const r = find(v);
                if (r) return r;
            }
        }
        return null;
    };
    return find(l) || '#';
};
---

<section class="py-16 bg-theme-section relative z-10">
    <div class="container mx-auto px-6 max-w-5xl">
        
        <div class="text-center py-16 container mx-auto px-6 max-w-4xl">
            <h2 class="text-3xl md:text-4xl font-display font-bold text-theme-main uppercase tracking-tight">
                Explora <span class="text-btc-orange">Nuestra Web</span>
            </h2>
            <p class="text-theme-muted mt-3 text-base leading-relaxed max-w-2xl mx-auto">
                Descubre las secciones más importantes de nuestro sitio web y accede a información detallada sobre el servidor, sus mundos, mods, datapacks, staff y roadmap.    
            </p>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 md:gap-5">
  
            {cards.map((card: any) => {
                const href = getLink(card.keyLink);
                return (
                <a 
                    href={href} 
                    target={card.isExternal ? "_blank" : "_self"}
                    rel={card.isExternal ? "noopener noreferrer" : undefined}
                    class="group flex flex-col items-center justify-center gap-2 p-4 md:p-6 bg-theme-card border border-theme-1 transition-all duration-300 hover:border-btc-orange/50 hover:-translate-y-0.5 text-center"
                    style="box-shadow: 4px 4px 0px rgba(0,0,0,0.3);"
                >
                    <!-- Icono centrado arriba -->
                    <div class={`w-10 h-10 md:w-14 md:h-14 flex items-center justify-center shrink-0 border transition-transform duration-300 group-hover:scale-110 ${card.iconBg}`}>
                    <Fragment set:html={card.iconSvg} />
                    </div>
                    
                    <!-- Título debajo, truncado -->
                    <h3 class={`text-[10px] md:text-sm font-display font-bold uppercase tracking-wide leading-tight ${card.titleHover}`}>
                    {card.title}
                    </h3>
                </a>
                );
            })}
            
            </div>
        
    </div>
</section>