---
// src/components/home/CategoryCards.astro
import cards from '../../data/aboutCards.json';
---

<section class="py-24 bg-theme-section relative z-10 border-t border-theme">
    <div class="container mx-auto px-6 max-w-7xl">
        
        <div class="text-center mb-16">
            <h2 class="category-title">
                Explora <span class="text-btc-orange">Nuestra Página Web</span>
            </h2>
            <p class="category-subtitle">Aquí tienes los enlaces a las secciones principales de nuestra página web.</p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
            
            {cards.map((card: any) => (
                <a 
                    href={card.href} 
                    target={card.isExternal ? "_blank" : "_self"}
                    rel={card.isExternal ? "noopener noreferrer" : undefined}
                    class={`group flex flex-col items-center text-center bg-theme-card border border-theme rounded-3xl p-10 transition-all duration-300 hover:-translate-y-2 hover:shadow-2xl ${card.hoverBorder}`}
                >
                    <div class={`w-20 h-20 rounded-2xl flex items-center justify-center shrink-0 border mb-6 transition-transform duration-300 group-hover:scale-110 group-hover:-rotate-3 shadow-inner ${card.iconBg}`}>
                        <Fragment set:html={card.iconSvg} />
                    </div>
                    
                    <h3 class={`text-xl font-display font-bold text-theme-main uppercase tracking-wide mb-3 transition-colors duration-300 ${card.titleHover}`}>
                        {card.title}
                    </h3>
                    
                    <p class="text-theme-muted text-sm leading-relaxed flex-grow">
                        {card.desc}
                    </p>
                </a>
            ))}
            
        </div>
        
    </div>
</section>