---
// src/components/home/Hero.astro
import heroActions from '../../data/heroActions.json';
import links from '../../data/links.json';

// Helper para buscar llaves dinámicas en la estructura anidada y devolver siempre un string
const getLink = (key: string | undefined | null): string => {
    if (!key) return '#';
    const l = links as any;
    if (typeof l[key] === 'string') return l[key];
    for (const cat of Object.values(l)) {
        if (typeof cat === 'object' && cat !== null && !Array.isArray(cat) && typeof (cat as any)[key] === 'string') {
            return (cat as any)[key];
        }
    }
    return '#';
};

const bgImage = `url('${links.assets.heroBackground}')`;
---

<section id="inicio" class="hero-section">
    <div class="hero-bg-image" style={{ backgroundImage: bgImage }}></div>
    <div class="hero-overlay"></div>
    
    <div class="hero-content">
        <img src={links.assets.logoText} alt="Builtechraft" class="hero-logo" />
        
        <p class="hero-description">
            Un mundo privado de Minecraft sin reiniciarse desde su creación con el objetivo de reducir la dependencia de mods y plugins complejos mediante el uso de los datapacks y mecánicas del juego base.
        </p>

        <div class="flex flex-col sm:flex-row flex-wrap gap-4 justify-center items-center w-full">
            {heroActions.map((action: any) => {
                // Usamos el helper para obtener el string de forma segura
                const url = getLink(action.keyLink) || action.href || '#';
                return (
                    <a 
                        href={url} 
                        target={action.isExternal ? "_blank" : "_self"}
                        rel={action.isExternal ? "noopener noreferrer" : undefined}
                        class={`btn-retro inline-flex justify-center items-center gap-3 btn-retro w-full sm:w-auto ${action.btnClass}`}
                    >
                        {action.label}
                    </a>
                );
            })}
        </div>
    </div>
</section>