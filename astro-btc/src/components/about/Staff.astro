---
// src/components/wiki/Staff.astro
// Estilo LiberCraft SIN modal: la bio y redes van directo bajo la foto.
// Data-driven desde Google Sheets (getStaffData). Sin backdrop-blur = sin lag.
---

<section id="staff" class="py-24 relative overflow-hidden border-y border-theme bg-theme-section min-h-[750px]">
  <div class="container mx-auto px-6 max-w-5xl">
    <h2 class="text-4xl md:text-5xl font-display font-bold text-center mb-4 uppercase text-theme-main tracking-tight">
      Nuestro <span class="text-btc-orange">Equipo</span>
    </h2>
    <p class="text-theme-muted text-center text-sm md:text-base mb-16 max-w-2xl mx-auto">
      Gracias a estas damas y caballeros en ayudarnos en distintas áreas de este proyecto.
    </p>

    <div id="loading-staff" class="flex flex-col justify-center items-center py-10 text-theme-muted gap-3">
      <span class="text-4xl animate-bounce">👑</span>
      <span class="animate-pulse font-bold tracking-widest uppercase text-sm">Cargando equipo...</span>
    </div>

    <div id="staff-container" class="hidden flex-col gap-16 min-h-[450px]">
      <div id="staff-rows" class="flex flex-col gap-16"></div>
    </div>
  </div>
</section>

<style is:global>
  /* ===== GRUPOS POR ROL ===== */
  .staff-group { display: flex; flex-direction: column; align-items: center; gap: .75rem; }
  .sg-title {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.5rem;
    text-transform: uppercase;
    letter-spacing: .03em;
  }
  .sg-desc { color: var(--text-muted); font-size: .85rem; text-align: center; max-width: 480px; }
  .sg-cards {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
  }

  /* ===== TARJETA ESTILO LIBERCRAFT (SIN MODAL) ===== */
  .staff-card {
    width: 240px;
    background: var(--bg-card);
    border: 3px solid var(--c, #71717a);
    border-radius: 14px;
    padding: 1.5rem 1.25rem;
    text-align: center;
    transition: transform .25s, box-shadow .25s;
    box-shadow: 0 6px 18px -8px rgb(0 0 0 / .5);
    display: flex;
    flex-direction: column;
  }
  .staff-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 14px 30px -12px var(--c, #71717a);
  }
  .sc-avatar {
    width: 6.5rem;
    height: 6.5rem;
    margin: 0 auto 1rem;
    overflow: hidden;
    border-radius: 10px;
    background: var(--bg-section);
    flex-shrink: 0;
  }
  .sc-avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    image-rendering: pixelated;
  }
  .sc-name {
    color: var(--c, #71717a);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .05em;
    font-size: 1rem;
  }
  .sc-meta { display: block; color: var(--text-muted); font-size: .72rem; margin-top: .35rem; }
  .sc-quote { color: var(--text-muted); font-size: .78rem; line-height: 1.5; margin-top: .75rem; }
  .sc-bio {
    color: var(--text-muted);
    font-size: .76rem;
    line-height: 1.55;
    margin-top: .85rem;
    padding-top: .85rem;
    border-top: 1px solid var(--border-subtle);
    text-align: left;
  }
  .sc-socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: .4rem;
    margin-top: .9rem;
  }
  .sc-socials a {
    font-size: .6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    padding: .3rem .55rem;
    color: var(--text-muted);
    border: 1px solid var(--border-subtle);
    transition: color .2s, border-color .2s;
  }
  .sc-socials a:hover {
    color: var(--c, #71717a);
    border-color: var(--c, #71717a);
  }
</style>

<script>
import { getStaffData } from '../../utils/sheetsClient.js';
import links from '../../data/links.json';

document.addEventListener('DOMContentLoaded', async () => {
  const loadingEl = document.getElementById('loading-staff') as HTMLElement;
  const container = document.getElementById('staff-container') as HTMLElement;
  const rowsWrapper = document.getElementById('staff-rows') as HTMLElement;

  const defaultAvatar = links.assets.defaultAvatar;

  const ROLE_DESC: Record<string, string> = {
    'Fundador': 'Quien inició todo el proyecto. Dirección técnica y creativa del servidor.',
    'Admin': 'Administradores con acceso a los sistemas principales del servidor.',
    'Moderador': 'Cuidan la comunidad y ayudan con los problemas del día a día.',
  };

  try {
    const staffMembers = await getStaffData();

    if (staffMembers && staffMembers.length > 0 && rowsWrapper) {

      const grouped: Record<string, { color: string; members: any[] }> = {};
      staffMembers.forEach((m: any) => {
        const rol = (m.Rol || 'Staff').trim();
        const color = (m.Color || '#71717a').trim();
        if (!grouped[rol]) grouped[rol] = { color, members: [] };
        grouped[rol].members.push(m);
      });

      let html = '';
      for (const [rol, data] of Object.entries(grouped)) {
        html += `
          <div class="staff-group">
            <h3 class="sg-title" style="color: ${data.color};">${rol}</h3>
            ${ROLE_DESC[rol] ? `<p class="sg-desc">${ROLE_DESC[rol]}</p>` : ''}
            <div class="sg-cards">
        `;

        for (const m of data.members) {
          const avatar = (m.Avatar || '').trim() || defaultAvatar;
          const meta = [m.Clan, m.Pronombres].filter((v: string) => v && v.trim()).join(' · ');

          // Redes sociales (solo las que tengan URL)
          let socialsHtml = '';
          ['Twitch', 'Youtube', 'Github', 'Twitter', 'Instagram'].forEach((red) => {
            if (m[red] && m[red].trim() !== '') {
              socialsHtml += `<a href="${m[red].trim()}" target="_blank" rel="noopener noreferrer">${red}</a>`;
            }
          });

          html += `
            <div class="staff-card" style="--c: ${data.color};">
              <div class="sc-avatar">
                <img src="${avatar}" alt="${m.Nombre}" loading="lazy" onerror="this.onerror=null;this.src='${defaultAvatar}';" />
              </div>
              <h4 class="sc-name">${m.Nombre}</h4>
              ${meta ? `<span class="sc-meta">${meta}</span>` : ''}
              ${m.Frase ? `<p class="sc-quote">"${m.Frase}"</p>` : ''}
              ${m.Bio ? `<p class="sc-bio">${m.Bio}</p>` : ''}
              ${socialsHtml ? `<div class="sc-socials">${socialsHtml}</div>` : ''}
            </div>
          `;
        }

        html += `</div></div>`;
      }

      rowsWrapper.innerHTML = html;
      if (loadingEl) loadingEl.style.display = 'none';
      if (container) {
        container.classList.remove('hidden');
        container.classList.add('flex');
      }
    }
  } catch (error) {
    console.error('Error cargando staff:', error);
    if (loadingEl) loadingEl.innerHTML = "<span class='text-red-500 font-bold'>Error al conectar con la API de Staff.</span>";
  }
});
</script>