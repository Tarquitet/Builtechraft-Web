---
import { getDictionary, getLocaleFromPath } from '../../lib/i18n';

const dict = getDictionary(getLocaleFromPath(Astro.url.pathname));
---

<section id="staff" data-error-message={dict.home.staff.error} class="py-12 md:py-16 lg:py-24 relative overflow-hidden border-y border-theme bg-theme-section">
  <div class="container mx-auto px-6 max-w-5xl">
    <h2 class="text-3xl md:text-4xl lg:text-5xl font-display font-bold text-center mb-4 uppercase text-theme-main tracking-tight">
      {dict.home.staff.title}
    </h2>
    <p class="text-theme-muted text-center text-sm md:text-base mb-12 md:mb-16 max-w-2xl mx-auto">
      {dict.home.staff.description}
    </p>

    <div id="loading-staff" class="flex flex-col justify-center items-center py-10 text-theme-muted gap-3">
      <span class="text-4xl animate-bounce">👑</span>
      <span class="animate-pulse font-bold tracking-widest uppercase text-sm">{dict.home.staff.loading}</span>
    </div>

    <div id="staff-container" class="hidden flex-col min-h-[300px]">
      <div id="staff-rows" class="flex flex-col"></div>
    </div>
  </div>
</section>

<style is:global>
  .staff-group { 
    display: flex !important;
    flex-direction: column !important;
    align-items: center !important;
    gap: 0.25rem !important;
    margin-bottom: 1rem !important;
  }

  .sg-title {
    font-family: var(--font-display) !important;
    font-weight: 700 !important;
    font-size: 1.6rem !important;
    text-transform: uppercase !important;
    letter-spacing: 0.1em !important;
    text-align: center !important;
    margin: 0 !important;
    padding: 0 !important;
  }

  .sg-cards {
    display: flex !important;
    gap: 0.5rem !important;
    margin-top: 0.25rem !important;
    overflow-x: auto !important;
    padding: 0.25rem !important;
    scroll-snap-type: x mandatory !important;
    -webkit-overflow-scrolling: touch !important;
    scrollbar-width: none !important;
    width: 100% !important;
  }

  .sg-cards::-webkit-scrollbar { display: none !important; }

  .staff-card {
    min-width: 200px !important;
    max-width: 200px !important;
    width: 200px !important;
    scroll-snap-align: center !important;
    background: var(--bg-card) !important;
    border: 3px solid var(--c, #71717a) !important;
    border-radius: 14px !important;
    padding: 0.75rem !important;
    text-align: center !important;
    transition: transform .25s, box-shadow .25s !important;
    box-shadow: 0 6px 18px -8px rgb(0 0 0 / .5) !important;
    display: flex !important;
    flex-direction: column !important;
    flex-shrink: 0 !important;
    cursor: default !important;
  }

  .sc-avatar {
    width: 4.5rem !important;
    height: 4.5rem !important;
    margin: 0 auto 0.5rem !important;
    overflow: hidden !important;
    border-radius: 10px !important;
    background: var(--bg-section) !important;
    flex-shrink: 0 !important;
  }

  .sc-avatar img {
    width: 100% !important;
    height: 100% !important;
    object-fit: cover !important;
    image-rendering: pixelated !important;
  }

  .sc-name {
    color: var(--c, #71717a) !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.05em !important;
    font-size: 1rem !important;
    margin: 0 !important;
  }

  .sc-meta { 
    display: block !important; 
    color: var(--text-muted) !important; 
    font-size: 0.7rem !important; 
    margin-top: 0.25rem !important; 
  }

  .sc-quote { 
    color: var(--text-muted) !important; 
    font-size: 0.75rem !important; 
    line-height: 1.4 !important; 
    margin-top: 0.5rem !important; 
  }

  .sc-bio {
    color: var(--text-muted) !important;
    font-size: 0.8rem !important;
    line-height: 1.5 !important;
    margin-top: 0.5rem !important;
    padding-top: 0.5rem !important;
    border-top: 1px solid var(--border-subtle) !important;
    text-align: left !important;
    display: none !important;
  }

  .sc-socials {
    display: none !important;
    flex-wrap: wrap !important;
    justify-content: center !important;
    gap: 0.4rem !important;
    margin-top: 0.5rem !important;
  }

  .sc-socials a {
    font-size: 0.6rem !important;
    font-weight: 700 !important;
    text-transform: uppercase !important;
    letter-spacing: 0.08em !important;
    padding: 0.3rem 0.5rem !important;
    color: var(--text-muted) !important;
    border: 1px solid var(--border-subtle) !important;
    transition: color .2s, border-color .2s !important;
  }

  .sc-socials a:hover {
    color: var(--c, #71717a) !important;
    border-color: var(--c, #71717a) !important;
  }

  .sc-expand-arrow {
    display: block !important;
    margin-top: 0.5rem !important;
    color: var(--c, #71717a) !important;
    transition: transform .3s !important;
  }

  .sc-expand-arrow svg {
    width: 1.25rem !important;
    height: 1.25rem !important;
  }

  .staff-card.is-expanded .sc-bio,
  .staff-card.is-expanded .sc-socials {
    display: flex !important;
  }

  .staff-card.is-expanded .sc-expand-arrow svg {
    transform: rotate(180deg) !important;
  }

  /* ===== DESKTOP: Hover activo, tarjetas completas ===== */
  @media (min-width: 768px) {
    .staff-group {
      margin-bottom: 2.5rem !important;
      gap: 0.5rem !important;
    }
    
    .sg-title {
      font-size: 1.75rem !important;
    }
    
    .sg-cards {
      flex-wrap: wrap !important;
      justify-content: center !important;
      overflow-x: visible !important;
      padding: 0 !important;
      margin-top: 1rem !important;
    }
    
    .staff-card {
      min-width: auto !important;
      max-width: none !important;
      width: 240px !important;
      padding: 1.25rem !important;
      cursor: default !important;
    }
    
    .staff-card:hover {
      transform: translateY(-4px) !important;
      box-shadow: 0 14px 30px -12px var(--c, #71717a) !important;
    }
    
    .sc-avatar {
      width: 6rem !important;
      height: 6rem !important;
    }
    
    .sc-name { font-size: 1.05rem !important; }
    .sc-bio { display: block !important; font-size: 0.76rem !important; }
    .sc-socials { display: flex !important; }
    .sc-expand-arrow { display: none !important; }
  }
</style>

<script>
import { getStaffData } from '../../utils/sheetsClient.js';
import links from '../../data/links.json';

document.addEventListener('DOMContentLoaded', async () => {
  const loadingEl = document.getElementById('loading-staff') as HTMLElement;
  const container = document.getElementById('staff-container') as HTMLElement;
  const rowsWrapper = document.getElementById('staff-rows') as HTMLElement;

  const defaultAvatar = links.assets.defaultAvatar;

  try {
    const locale = document.documentElement.lang === 'en' ? 'en' : 'es';
    const staffMembers = await getStaffData(locale);

    if (staffMembers && staffMembers.length > 0 && rowsWrapper) {
      let html = '';
      let currentRole = '';

      staffMembers.forEach((m: any) => {
        const rol = (m.Rol || 'Staff').trim();
        const color = (m.Color || '#71717a').trim();

        if (rol !== currentRole) {
          if (currentRole !== '') html += `</div></div>`;
          
          currentRole = rol;
          html += `
            <div class="staff-group">
              <h3 class="sg-title" style="color: ${color};">${rol}</h3>
              <div class="sg-cards">
          `;
        }

        const avatar = (m.Avatar || '').trim() || defaultAvatar;
        const meta = [m.Clan, m.Pronombres].filter((v: string) => v && String(v).trim()).join(' · ');
        
        let socialsHtml = '';
        ['Twitch', 'Youtube', 'Github', 'Twitter', 'Instagram'].forEach((red) => {
          if (m[red] && String(m[red]).trim() !== '') {
            socialsHtml += `<a href="${m[red].trim()}" target="_blank" rel="noopener noreferrer">${red}</a>`;
          }
        });

        html += `
          <div class="staff-card" style="--c: ${color};">
            <div class="sc-avatar">
              <img src="${avatar}" alt="${m.Nombre}" loading="lazy" onerror="this.onerror=null;this.src='${defaultAvatar}';" />
            </div>
            <h4 class="sc-name">${m.Nombre}</h4>
            ${meta ? `<span class="sc-meta">${meta}</span>` : ''}
            ${m.Frase ? `<p class="sc-quote">"${m.Frase}"</p>` : ''}
            ${m.Bio ? `<p class="sc-bio">${m.Bio}</p>` : ''}
            ${socialsHtml ? `<div class="sc-socials">${socialsHtml}</div>` : ''}
            <div class="sc-expand-arrow">
              <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </div>
          </div>
        `;
      });

      if (currentRole !== '') html += `</div></div>`;

      rowsWrapper.innerHTML = html;
      if (loadingEl) loadingEl.style.display = 'none';
      if (container) {
        container.classList.remove('hidden');
        container.classList.add('flex');
      }

      // Toggle de expansión SOLO en móvil
      const isMobile = () => window.innerWidth < 768;
      
      document.querySelectorAll('.staff-card').forEach((card) => {
        card.addEventListener('click', (e) => {
          // Solo expandir en móvil
          if (isMobile()) {
            // Evitar que se expanda si se hace clic en un enlace de redes sociales
            if ((e.target as HTMLElement).tagName === 'A') return;
            card.classList.toggle('is-expanded');
          }
        });
      });
    }
  } catch (error) {
    console.error('Error cargando staff:', error);
    if (loadingEl) loadingEl.innerHTML = `<span class='text-red-500 font-bold'>${document.getElementById('staff')?.getAttribute('data-error-message') || ''}</span>`;
  }
});
</script>