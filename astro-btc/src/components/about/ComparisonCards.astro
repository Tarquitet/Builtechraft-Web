---
// src/components/about/ComparisonCards.astro
import cards from '../../data/comparisonCards.json';
import links from '../../data/links.json';

const getLink = (key: string | undefined | null): string => {
  if (!key) return '#';
  const l = links as any;
  const find = (obj: any): string | null => {
    for (const [k, v] of Object.entries(obj)) {
      if (k === key && typeof v === 'string') return v;
      if (typeof v === 'object' && v !== null) {
        const r = find(v);
        if (r) return r;
      }
    }
    return null;
  };
  return find(l) || '#';
};

const getColorClasses = (color: string) => {
  switch (color) {
    case 'red':
      return { text: 'text-red-400', border: 'border-red-500/30' };
    case 'yellow':
      return { text: 'text-btc-yellow', border: 'border-btc-yellow/30' };
    case 'emerald':
      return { text: 'text-emerald-400', border: 'border-emerald-500/30' };
    default:
      return { text: 'text-theme-main', border: 'border-theme' };
  }
};
---

<div class="mt-12">
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    {cards.cards.map((card) => {
      const colors = getColorClasses(card.color);
      return (
        <div class={`card-retro ${colors.border} ${card.highlighted ? 'border-theme-accent' : ''} flex flex-col`}>
          <span class="text-5xl mb-4 block">{card.icon}</span>
          <h3 class={`text-xl font-display font-bold uppercase tracking-tight mb-1 ${colors.text}`}>
            {card.title}
          </h3>
          <p class="text-xs text-theme-muted uppercase tracking-widest mb-3">
            {card.subtitle}
          </p>
          <p class="text-sm text-theme-muted leading-relaxed mb-4 flex-grow">
            {card.summary}
          </p>
          <p class={`text-sm font-bold ${colors.text} border-t border-theme pt-3 mt-auto`}>
            {card.verdict}
          </p>
        </div>
      );
    })}
  </div>

  {/* Único link de salida: el botón grande */}
  <div class="text-center">
    <a 
      href={getLink(cards.wikiLink.linkKey)}
      class="btn-retro inline-flex items-center gap-3"
    >
      {cards.wikiLink.text}
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
      </svg>
    </a>
  </div>
</div>