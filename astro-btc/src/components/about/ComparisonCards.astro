---
import cards from '../../data/comparisonCards.json';
import links from '../../data/links.json';

const getLink = (key: string | undefined | null): string => {
  if (!key) return '#';
  const l = links as any;
  const find = (obj: any): string | null => {
    for (const [k, v] of Object.entries(obj)) {
      if (k === key && typeof v === 'string') return v;
      if (typeof v === 'object' && v !== null) {
        const r = find(v);
        if (r) return r;
      }
    }
    return null;
  };
  return find(l) || '#';
};

const getColorClasses = (color: string) => {
  switch (color) {
    case 'red': return { text: 'text-red-400', border: 'border-red-500/30' };
    case 'yellow': return { text: 'text-btc-yellow', border: 'border-btc-yellow/30' };
    case 'emerald': return { text: 'text-emerald-400', border: 'border-emerald-500/30' };
    default: return { text: 'text-theme-main', border: 'border-theme-1' };
  }
};
---

<div class="mt-12">

  <!-- Tarjetas de comparación -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
    {cards.cards.map((card) => {
      const colors = getColorClasses(card.color);
      return (
        <div class={`card-retro ${colors.border} ${card.highlighted ? 'border-btc-orange/50' : ''} flex flex-col`}>
          <span class="text-5xl mb-4 block">{card.icon}</span>
          <h3 class={`text-xl font-display font-bold uppercase tracking-tight mb-1 ${colors.text}`}>
            {card.title}
          </h3>
          <p class="text-xs text-theme-muted uppercase tracking-widest mb-3">
            {card.subtitle}
          </p>
          <p class="text-sm text-theme-muted leading-relaxed mb-4 flex-grow">
            {card.summary}
          </p>
          <p class={`text-sm font-bold ${colors.text} mt-auto pt-3`}>
            {card.verdict}
          </p>
        </div>
      );
    })}
  </div>

  <!-- Botones -->
  <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mt-8">
    <a 
      href={getLink(cards.modsLink.linkKey)}
      class="btn-retro inline-flex items-center gap-3"
    >
      {cards.modsLink.text}
    </a>

    <a 
      href={getLink(cards.wikiLink.linkKey)}
      class="btn-retro inline-flex items-center gap-3"
    >
      {cards.wikiLink.text}
    </a>
  </div>
</div>