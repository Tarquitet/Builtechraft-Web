---
import links from '../../data/links.json';
import { getDictionary, getLocaleFromPath, localizePath } from '../../lib/i18n';

const dict = getDictionary(getLocaleFromPath(Astro.url.pathname));

const modpackPageUrl = links.modpack.url;
const bobbyUrl = links.modpack?.bobbyCache || '#';
const locale = getLocaleFromPath(Astro.url.pathname);
const bobbyGuideUrl = localizePath(links.wiki?.wikiBobby || '/wiki/bobby', locale);
const modpackGuideUrl = localizePath(links.wiki.wikiModpackTutorial, locale);
---

<section id="modpack" class="py-24 relative overflow-hidden bg-theme-section">
    <div class="container mx-auto px-6 max-w-4xl text-center relative z-10">
        
        <span class="px-4 py-1.5 rounded-full border border-btc-orange/30 bg-btc-orange/10 text-btc-orange text-[10px] font-bold uppercase tracking-[0.2em] mb-4 inline-block">
            {dict.home.modpack.badge}
        </span>
        
        <h2 class="text-3xl md:text-4xl font-display font-bold uppercase tracking-tight text-theme-main mb-6">
            {dict.home.modpack.title}
        </h2>
        
        <p class="text-theme-muted text-lg leading-relaxed mb-8 max-w-2xl mx-auto">
            {dict.home.modpack.description}
        </p>

        <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-16">
            <a href={modpackPageUrl} target="_blank" class="px-8 py-4 bg-btc-orange text-white font-bold uppercase tracking-wider text-sm hover:bg-btc-orange/90 transition-all" style="box-shadow: 4px 4px 0px rgba(0,0,0,0.5);">
                {dict.home.modpack.profiles}
            </a>
            <a href={modpackGuideUrl} class="px-8 py-4 bg-theme-card border border-theme-1 text-theme-main font-bold uppercase tracking-wider text-sm hover:border-btc-orange hover:text-btc-orange transition-all" style="box-shadow: 4px 4px 0px rgba(0,0,0,0.5);">
                {dict.home.modpack.guide}
            </a>
        </div>

        <!-- SECCIÓN BOBBY - Oculta en móvil, visible en desktop -->
        <div class="hidden md:flex w-full border border-theme-1 bg-theme-card p-8 md:p-10 flex-col md:flex-row items-center gap-8 relative overflow-hidden group hover:border-btc-orange/30 transition-colors" style="box-shadow: 6px 6px 0px rgba(0,0,0,0.5);">
            
            <div class="w-20 h-20 bg-theme-alternate border border-theme-1 flex items-center justify-center shrink-0 rounded-lg">
                <span class="text-4xl">🔭</span>
            </div>
            
            <div class="flex-1 text-center md:text-left z-10">
                <h4 class="text-2xl font-display font-bold text-btc-orange mb-3 tracking-tight">{dict.home.modpack.bobbyTitle}</h4>
                <p class="text-base leading-relaxed max-w-3xl text-theme-muted">
                    {dict.home.modpack.bobbyDescription}
                </p>
                <div class="mt-4 flex flex-wrap justify-center md:justify-start gap-4">
                    <a href={bobbyGuideUrl} class="text-xs font-bold uppercase tracking-widest text-theme-muted hover:text-btc-orange transition-colors flex items-center gap-2">
                        {dict.home.modpack.installInstructions} →
                    </a>
                </div>
            </div>
            
            <div class="z-10 shrink-0 mt-4 md:mt-0 w-full md:w-auto">
                <a 
                    href={bobbyUrl} 
                    target="_blank" 
                    rel="noopener noreferrer"
                    class="flex items-center justify-center gap-3 bg-[#5865F2]/10 hover:bg-[#5865F2] text-[#5865F2] hover:text-white border border-[#5865F2]/30 px-8 py-4 transition-all duration-300 font-bold uppercase tracking-widest text-xs w-full md:w-auto" 
                    style="box-shadow: 4px 4px 0px rgba(0,0,0,0.3);"
                >
                    {dict.home.modpack.downloadCache}
                </a>
            </div>
        </div>

    </div>
</section>