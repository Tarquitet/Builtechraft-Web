---
// src/components/wiki/Roadmap.astro
---
<style>
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .hide-scrollbar::-webkit-scrollbar { display: none; }
</style>

<div id="roadmap" class="hidden flex-col mt-4 relative z-20 pb-16">
    <p class="text-theme-muted text-sm md:text-base mb-6">
        Consulta nuestras futuras expansiones, mantenimientos planeados y actualizaciones del servidor.
    </p>

    <div id="roadmap-filters" class="flex flex-wrap gap-2 mb-8 border-b border-theme pb-6">
        </div>

    <div class="relative w-full group">
        <button id="rm-prev" class="absolute left-0 top-1/2 -translate-y-1/2 -ml-4 md:-ml-6 z-10 bg-theme-card text-theme-main p-3 border-theme-1 opacity-0 group-hover:opacity-100 transition-opacity disabled:opacity-0 hidden md:flex items-center justify-center hover:bg-btc-orange hover:border-btc-orange hover:text-white shadow-lg cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>

        <div id="roadmap-container" class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-6 hide-scrollbar scroll-smooth">
            </div>

        <button id="rm-next" class="absolute right-0 top-1/2 -translate-y-1/2 -mr-4 md:-ml-6 z-10 bg-theme-card text-theme-main p-3 border-theme-1 opacity-0 group-hover:opacity-100 transition-opacity disabled:opacity-0 hidden md:flex items-center justify-center hover:bg-btc-orange hover:border-btc-orange hover:text-white shadow-lg cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
    </div>
</div>

<script>
import { getRoadmapData } from '../../utils/sheetsClient.js';
document.addEventListener('DOMContentLoaded', async () => {
    const container = document.getElementById('roadmap-container');
    const section = document.getElementById('roadmap');
    const filtersContainer = document.getElementById('roadmap-filters');
    if (!container || !section || !filtersContainer) return;

    const btnPrev = document.getElementById('rm-prev') as HTMLButtonElement | null;
    const btnNext = document.getElementById('rm-next') as HTMLButtonElement | null;

    const getStatusStyle = (estado: string) => {
        const s = estado?.toLowerCase().trim() || '';
        if (s.includes('progreso')) return { text: 'text-btc-orange', bg: 'bg-btc-orange/10', border: 'border-btc-orange/30', icon: '⚡' };
        if (s.includes('planeado')) return { text: 'text-blue-500', bg: 'bg-blue-500/10', border: 'border-blue-500/30', icon: '📌' };
        if (s.includes('prueba'))   return { text: 'text-purple-500', bg: 'bg-purple-500/10', border: 'border-purple-500/30', icon: '🔬' };
        return { text: 'text-emerald-500', bg: 'bg-emerald-500/10', border: 'border-emerald-500/30', icon: '✅' };
    };

    try {
        const data = await getRoadmapData();
        if (!data || data.length === 0) return;

        // Inyección de Tarjetas con Clases Globales
        container.innerHTML = data.map((item: any) => {
            const estadoLimpio = item.Estado || 'Pendiente';
            const style = getStatusStyle(estadoLimpio);
            
            return `
                <div class="roadmap-card snap-center shrink-0 w-[85vw] md:w-[calc(33.333%-1rem)] bg-theme-card border-theme-1  p-6 flex flex-col group hover:border-btc-orange/30 shadow-lg" data-status="${estadoLimpio}">
                    <div class="mb-5">
                        <span class="text-[10px] font-bold uppercase tracking-widest ${style.text} ${style.bg} border-theme-1 ${style.border} px-3 py-1.5 inline-flex items-center gap-1.5 whitespace-nowrap">
                            ${style.icon} ${estadoLimpio}
                        </span>
                    </div>
                    <h3 class="px-1 font-bold text-theme-main text-xl mb-3 leading-tight">
                        ${item.Titulo}
                    </h3>
                    <p class="px-1 text-theme-muted text-sm leading-relaxed flex-grow">
                        ${item.Descripcion}
                    </p>
                </div>
            `;
        }).join('');

        const cards = container.querySelectorAll('.roadmap-card');
        const uniqueStatuses = [...new Set(data.map((item: any) => item.Estado || 'Pendiente'))];

        // Inyección de Botones de Filtro
        filtersContainer.innerHTML = uniqueStatuses.map(status => `
            <button class="rm-filter-btn px-5 py-2.5 bg-theme-alternate text-theme-muted hover:text-theme-main  text-xs font-bold uppercase tracking-widest border-theme-1 hover:border-btc-orange/50 transition-all" data-filter="${status}">
                ${status}
            </button>
        `).join('');

        const applyFilter = (filterValue: string, activeBtn: HTMLElement) => {
            // Limpiar botón previo
            const currentActive = filtersContainer.querySelector('.is-active-filter');
            if (currentActive) {
                currentActive.classList.remove('is-active-filter', 'bg-btc-orange/10', 'text-btc-orange', 'border-btc-orange/50');
                currentActive.classList.add('bg-theme-alternate', 'text-theme-muted', 'border-theme-1');
            }
            
            // Activar nuevo botón
            activeBtn.classList.remove('bg-theme-alternate', 'text-theme-muted', 'border-theme-1');
            activeBtn.classList.add('is-active-filter', 'bg-btc-orange/10', 'text-btc-orange', 'border-btc-orange/50');

            cards.forEach((card) => {
                const el = card as HTMLElement;
                el.style.display = el.getAttribute('data-status') === filterValue ? '' : 'none';
            });
            container.scrollLeft = 0;
        };

        filtersContainer.addEventListener('click', (e) => {
            const btn = (e.target as HTMLElement).closest('.rm-filter-btn') as HTMLElement;
            if (btn) applyFilter(btn.getAttribute('data-filter') as string, btn);
        });

        if (uniqueStatuses.length > 0) {
            applyFilter(uniqueStatuses[0] as string, filtersContainer.firstElementChild as HTMLElement);
        }

        if (btnPrev && btnNext) {
            const updateArrows = () => {
                const maxScroll = container.scrollWidth - container.clientWidth;
                btnPrev.disabled = container.scrollLeft <= 5;
                btnNext.disabled = container.scrollLeft >= maxScroll - 5;
            };
            container.addEventListener('scroll', updateArrows, { passive: true });
            const scrollSlider = (directionMultiplier: number) => {
                const firstVisible = Array.from(cards).find(c => (c as HTMLElement).style.display !== 'none') as HTMLElement;
                const cardWidth = firstVisible ? firstVisible.offsetWidth + 24 : 300;
                container.scrollBy({ left: cardWidth * directionMultiplier, behavior: 'smooth' });
            };
            btnPrev.addEventListener('click', () => scrollSlider(-1));
            btnNext.addEventListener('click', () => scrollSlider(1));
        }

        section.classList.remove('hidden');
        section.classList.add('flex');
    } catch (e) {
        console.error("Error cargando el Roadmap:", e);
    }
});
</script>