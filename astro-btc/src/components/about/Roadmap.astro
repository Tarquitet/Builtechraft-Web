---
import { getDictionary, getLocaleFromPath } from '../../lib/i18n';

const locale = getLocaleFromPath(Astro.url.pathname);
const dict = getDictionary(locale);
---
<style>
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .hide-scrollbar::-webkit-scrollbar { display: none; }
</style>

<div id="roadmap-component" class="hidden flex-col mt-4 relative z-20 pb-16">
    <div id="roadmap-filters" class="flex flex-wrap gap-2 mb-8 pb-6"></div>

    <div class="relative w-full group">
        <button id="rm-prev" class="absolute left-0 top-1/2 -translate-y-1/2 -ml-4 md:-ml-6 z-10 bg-theme-card text-theme-main p-3 border border-theme-1 opacity-0 group-hover:opacity-100 transition-opacity disabled:opacity-0 hidden md:flex items-center justify-center hover:bg-btc-orange hover:border-btc-orange hover:text-white shadow-lg cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        </button>

        <div id="roadmap-container" class="flex overflow-x-auto snap-x snap-mandatory gap-6 pb-6 hide-scrollbar scroll-smooth"></div>

        <button id="rm-next" class="absolute right-0 top-1/2 -translate-y-1/2 -mr-4 md:-mr-6 z-10 bg-theme-card text-theme-main p-3 border border-theme-1 opacity-0 group-hover:opacity-100 transition-opacity disabled:opacity-0 hidden md:flex items-center justify-center hover:bg-btc-orange hover:border-btc-orange hover:text-white shadow-lg cursor-pointer">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
        </button>
    </div>
</div>

<script>
// @ts-nocheck
document.addEventListener('DOMContentLoaded', async () => {
    const container = document.getElementById('roadmap-container');
    const section = document.getElementById('roadmap-component');
    const filtersContainer = document.getElementById('roadmap-filters');
    if (!container || !section || !filtersContainer) return;
    
    const locale = document.documentElement.lang === 'en' ? 'en' : 'es';
    const btnPrev = document.getElementById('rm-prev');
    const btnNext = document.getElementById('rm-next');

    try {
        const { getRoadmapData } = await import('../../utils/sheetsClient.js');
        const data = await getRoadmapData(locale);
        
        if (!data || data.length === 0) return;

        // 1. Obtener estados únicos DIRECTAMENTE del JSON (ya viene traducido)
        const uniqueStatuses = [...new Set(data.map(item => item.Estado))];

        // 2. Renderizar tarjetas usando el texto EXACTO del JSON. Sin traducciones, sin emojis.
        container.innerHTML = data.map((item) => {
            return `
                <div class="roadmap-card snap-center shrink-0 w-[85vw] md:w-[calc(33.333%-1rem)] bg-theme-card border border-theme-1 p-6 flex flex-col group hover:border-btc-orange/30" style="box-shadow: 6px 6px 0px rgba(0,0,0,0.3);" data-status="${item.Estado}">
                    <h3 class="px-1 font-bold text-theme-main text-xl mb-3 leading-tight">${item.Titulo}</h3>
                    <p class="px-1 text-theme-muted text-sm leading-relaxed flex-grow">${item.Descripcion}</p>
                </div>
            `;
        }).join('');

        // 3. Renderizar filtros con los estados exactos del JSON
        filtersContainer.innerHTML = uniqueStatuses.map(status => `
            <button class="rm-filter-btn px-5 py-2.5 bg-theme-alternate text-theme-muted hover:text-theme-main text-xs font-bold uppercase tracking-widest border border-theme-1 hover:border-btc-orange/50 transition-all" data-filter="${status}">
                ${status}
            </button>
        `).join('');

        // 4. Lógica de filtrado simple
        const applyFilter = (filterValue, activeBtn) => {
            const currentActive = filtersContainer.querySelector('.is-active-filter');
            if (currentActive) {
                currentActive.classList.remove('is-active-filter', 'bg-btc-orange/10', 'text-btc-orange', 'border-btc-orange/50');
                currentActive.classList.add('bg-theme-alternate', 'text-theme-muted', 'border-theme-1');
            }
            activeBtn.classList.remove('bg-theme-alternate', 'text-theme-muted', 'border-theme-1');
            activeBtn.classList.add('is-active-filter', 'bg-btc-orange/10', 'text-btc-orange', 'border-btc-orange/50');

            container.querySelectorAll('.roadmap-card').forEach((card) => {
                card.style.display = card.getAttribute('data-status') === filterValue ? '' : 'none';
            });
            container.scrollLeft = 0;
        };

        filtersContainer.addEventListener('click', (e) => {
            const btn = e.target.closest('.rm-filter-btn');
            if (btn) applyFilter(btn.getAttribute('data-filter'), btn);
        });

        if (uniqueStatuses.length > 0) {
            applyFilter(uniqueStatuses[0], filtersContainer.firstElementChild);
        }

        if (btnPrev && btnNext) {
            const updateArrows = () => {
                const maxScroll = container.scrollWidth - container.clientWidth;
                btnPrev.disabled = container.scrollLeft <= 5;
                btnNext.disabled = container.scrollLeft >= maxScroll - 5;
            };
            container.addEventListener('scroll', updateArrows, { passive: true });
            
            const scrollSlider = (directionMultiplier) => {
                const firstVisible = Array.from(container.querySelectorAll('.roadmap-card')).find(c => c.style.display !== 'none');
                const cardWidth = firstVisible ? firstVisible.offsetWidth + 24 : 300;
                container.scrollBy({ left: cardWidth * directionMultiplier, behavior: 'smooth' });
            };
            btnPrev.addEventListener('click', () => scrollSlider(-1));
            btnNext.addEventListener('click', () => scrollSlider(1));
        }

        section.classList.remove('hidden');
        section.classList.add('flex');
    } catch (e) {
        console.error("Error cargando el Roadmap:", e);
    }
});
</script>