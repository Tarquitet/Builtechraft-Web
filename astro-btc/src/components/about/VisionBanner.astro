---
// src/components/about/VisionBanner.astro
const bgImage = "url('/images/gallery/2_3.avif')";
---

<section
    id="vision"
    class="relative w-full py-32 md:py-40 overflow-hidden flex flex-col items-center justify-center text-center"
>
    <!-- Fondo -->
    <div
        class="absolute inset-0 z-0 bg-cover bg-center opacity-85 transform-gpu"
        style={{ backgroundImage: bgImage }}
    ></div>

    <!-- Overlay -->
    <div class="absolute inset-0 z-10 bg-black/45 pointer-events-none"></div>

    <div class="container mx-auto px-6 max-w-4xl relative z-20">

        <span
            class="px-4 py-1.5 rounded-full border border-btc-orange/40 bg-btc-orange/20 text-btc-orange text-[10px] font-bold uppercase tracking-[0.2em] inline-block mb-6"
        >
            Sobre Builtechraft
        </span>

        <h1 class="text-5xl md:text-7xl font-display font-bold text-white uppercase tracking-tight mb-8">
            Un proyecto creado para disfrutar <span class="text-btc-orange">Minecraft</span>
        </h1>

        <p class="text-zinc-100 text-lg md:text-xl leading-relaxed max-w-3xl mx-auto">
            Builtechraft nació con una idea sencilla: mantener la esencia de Minecraft mientras construimos un mundo épico con mejoras que hagan la experiencia más cómoda y agradable. Donde cada mod, datapack se eligen para un balance justo para todo tipo de jugadores.
        </p>

    </div>
</section>