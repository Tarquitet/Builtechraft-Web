---
// src/components/Modpack.astro
const modpackUrl = "https://modrinth.com/modpack/builtechraft-mods";
const prismUrl = "https://prismlauncher.org/";
const elyPrismUrl = "https://ely.by/launcher";
---

<section id="modpack" class="py-20 bg-modpack-gradient relative overflow-hidden section-optimize">
    
    <div class="absolute inset-0 bg-[url('/images/grid-pattern.png')] opacity-[0.05] mix-blend-overlay z-0"></div>

    <div class="container mx-auto px-6 relative z-10">
        <div class="flex flex-col md:flex-row items-center justify-center gap-12 md:gap-16">
            
            <div class="w-full md:w-1/2 text-left max-w-lg">
                <h2 class="text-3xl md:text-5xl font-display font-bold text-(--grad-mod-text) mb-4 uppercase tracking-tighter leading-none">
                    Potencia tu <span class="text-(--text-highlight)">Experiencia</span>
                </h2>
                
                <p class="text-(--grad-mod-text) opacity-90 mb-6 text-base leading-relaxed">
                    Nuestro modpack oficial para Minecraft Java integra las herramientas técnicas esenciales (Litematica, MiniHUD, Essentials) y optimizaciones clave para Builtechraft. Disponible también para 
                    <a href={prismUrl} target="_blank" class="text-(--text-highlight) hover:text-white underline underline-offset-2 transition-colors font-bold">Prism Launcher</a> y 
                    <a href={elyPrismUrl} target="_blank" class="text-(--text-highlight) hover:text-white underline underline-offset-2 transition-colors font-bold">Ely.Prism</a>.
                </p>
            </div>

            <div class="w-full md:w-auto shrink-0 flex justify-center">
                <div 
                    class="modpack-card p-6 rounded-4xl border border-white/10 shadow-xl glass-gpu transition-all duration-500 hover:border-white/20 w-full md:w-75"
                    data-modrinth-url={modpackUrl}
                >
                    <div class="modpack-icon-container w-40 h-40 mx-auto mb-6 bg-black/25 rounded-3xl border border-white/5 overflow-hidden flex items-center justify-center shadow-inner relative">
                        <span class="text-7xl modpack-emoji animate-pulse">📦</span>
                    </div>

                    <div class="text-center">
                        <a href={modpackUrl} target="_blank" 
                           class="inline-flex items-center justify-center gap-3 w-full bg-[#1bd96a] text-black font-bold py-4 rounded-xl shadow-lg transition-all duration-300 hover:scale-[1.02] hover:bg-white hover:shadow-[#1bd96a]/30">
                            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                                <path d="M12 2L4.5 20.29L5.21 21L12 18L18.79 21L19.5 20.29L12 2Z"/>
                            </svg>
                            DESCARGAR MODPACK
                        </a>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
    document.addEventListener('DOMContentLoaded', async () => {
        const card = document.querySelector('.modpack-card');
        if (!card) return;

        const url = card.getAttribute('data-modrinth-url');
        const container = card.querySelector('.modpack-icon-container');
        const emoji = card.querySelector('.modpack-emoji');

        const getSlug = (u) => {
            const parts = u.split('?')[0].split('/');
            return parts[parts.length - 1] || parts[parts.length - 2];
        };

        const slug = getSlug(url);
        
        try {
            const response = await fetch(`https://api.modrinth.com/v2/project/${slug}`);
            if (response.ok) {
                const data = await response.json();
                if (data.icon_url && container) {
                    if (emoji) emoji.style.display = 'none';
                    const img = document.createElement('img');
                    img.src = data.icon_url;
                    img.className = "w-full h-full object-cover animate-fade-in";
                    container.appendChild(img);
                }
            }
        } catch (e) {}
    });
</script>

<style>
    @keyframes fade-in {
        from { opacity: 0; transform: scale(0.9); }
        to { opacity: 1; transform: scale(1); }
    }
    .animate-fade-in {
        animation: fade-in 0.6s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }
</style>