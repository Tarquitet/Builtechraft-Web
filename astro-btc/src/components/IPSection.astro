---
import { SERVER_INFO } from '../config';
const { javaIP, bedrockIP, bedrockPort } = SERVER_INFO;
---

<section id="ips" class="py-24 bg-[#272727] relative overflow-hidden transition-colors duration-300">
    <div class="absolute inset-0 bg-[url('/images/grid-pattern.png')] opacity-[0.03] mix-blend-overlay pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10">
        
        <h2 class="text-3xl md:text-4xl font-display font-bold text-center mb-16 uppercase text-white tracking-tight">
            COMO SER PARTE <span class="text-btc-orange">DEL SERVIDOR</span>
        </h2>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto mb-16">
            
            <div id="card-java" class="group relative bg-[#18181b] border-2 border-zinc-800 rounded-3xl p-8 transition-all duration-300 hover:border-btc-orange hover:shadow-2xl hover:shadow-btc-orange/10 flex flex-col">
                <div class="offline-badge absolute top-4 right-4 bg-zinc-800 border border-zinc-700 text-zinc-500 text-[10px] font-bold px-2 py-1 rounded hidden uppercase tracking-widest">● Offline</div>
                <div class="flex items-center gap-4 mb-6">
                    <div class="icon-box w-14 h-14 rounded-xl bg-linear-to-br from-orange-600 to-yellow-600 flex items-center justify-center text-3xl shadow-lg border-4 border-[#18181b] transition-all">☕</div>
                    <div>
                        <h3 class="text-2xl font-bold text-white uppercase leading-none">JAVA</h3>
                        <span class="text-[10px] font-bold text-zinc-500 uppercase tracking-widest">PC Edition (Fabric)</span>
                    </div>
                </div>
                <div class="bg-black/40 rounded-xl p-5 border border-zinc-800 mb-6 group-hover:border-btc-orange/50 transition-colors flex-1 flex flex-col justify-center relative">
                    <span class="text-[10px] text-zinc-500 uppercase font-bold tracking-wider mb-2 block">Dirección IP</span>
                    <button onclick={`copyText('${javaIP}', this)`} class="action-btn w-full text-left flex justify-between items-center group/ip cursor-pointer" title="Copiar IP">
                        <span class="text-lg md:text-xl text-white font-mono font-bold truncate mr-2">{javaIP}</span>
                        <svg class="w-5 h-5 text-zinc-600 group-hover/ip:text-btc-orange transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                    </button>
                </div>
                <button onclick={`copyText('${javaIP}', this)`} class="main-btn w-full py-4 bg-btc-orange text-white rounded-xl font-bold text-sm transition-all duration-300 hover:bg-white hover:text-btc-orange uppercase tracking-widest shadow-lg">Copiar IP Java</button>
            </div>

            <div id="card-bedrock" class="group relative bg-[#18181b] border-2 border-zinc-800 rounded-3xl p-8 transition-all duration-300 hover:border-blue-500 hover:shadow-2xl hover:shadow-blue-500/10 flex flex-col">
                <div class="offline-badge absolute top-4 right-4 bg-zinc-800 border border-zinc-700 text-zinc-500 text-[10px] font-bold px-2 py-1 rounded hidden uppercase tracking-widest">● Offline</div>
                <div class="flex items-center gap-4 mb-6">
                    <div class="icon-box w-14 h-14 rounded-xl bg-linear-to-br from-blue-600 to-cyan-500 flex items-center justify-center text-3xl shadow-lg border-4 border-[#18181b] transition-all">📱</div>
                    <div>
                        <h3 class="text-2xl font-bold text-white uppercase leading-none">BEDROCK</h3>
                        <span class="text-[10px] font-bold text-blue-400 uppercase tracking-widest">Móvil / Consola</span>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6 flex-1">
                    <div class="sm:col-span-2 bg-black/40 rounded-xl p-5 border border-zinc-800 group-hover:border-blue-500/30 transition-colors flex flex-col justify-center relative">
                        <span class="text-[10px] text-zinc-500 uppercase font-bold tracking-wider mb-2 block">Dirección IP</span>
                        <button onclick={`copyText('${bedrockIP}', this)`} class="action-btn w-full text-left flex justify-between items-center group/ip cursor-pointer" title="Copiar IP">
                            <span class="text-lg md:text-xl text-white font-mono font-bold truncate mr-2">{bedrockIP}</span>
                        </button>
                    </div>
                    <div class="bg-black/40 rounded-xl p-5 border border-zinc-800 text-center flex flex-col justify-center transition-colors group-hover:border-blue-500/30 cursor-pointer relative" onclick={`copyText('${bedrockPort}', this)`}>
                        <span class="text-[10px] text-zinc-500 uppercase font-bold tracking-wider mb-1 block">Puerto</span>
                        <div class="flex items-center justify-center gap-2">
                             <code class="text-xl text-blue-400 font-mono font-bold">{bedrockPort}</code>
                             <svg class="w-4 h-4 text-zinc-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                        </div>
                    </div>
                </div>
                <button onclick={`copyText('${bedrockIP}', this)`} class="main-btn w-full py-4 bg-blue-600 text-white rounded-xl font-bold text-sm transition-all duration-300 hover:bg-white hover:text-blue-600 uppercase tracking-widest shadow-lg">Copiar IP Bedrock</button>
            </div>

        </div>

        <div class="max-w-5xl mx-auto">
            <h3 class="text-xs font-bold text-zinc-400 uppercase tracking-[0.2em] mb-12 text-center">
                PASOS PARA ENTRAR EN EL SERVIDOR
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 text-sm">
                
                <div class="relative pl-8 md:pl-0 text-left md:text-center border-l-2 border-yellow-500 md:border-l-0 md:border-t-2 md:pt-6">
                    <span class="text-4xl font-black text-yellow-500/20 absolute -top-3 left-8 md:left-1/2 md:-translate-x-1/2 md:-top-10 z-0 select-none">1</span>
                    <div class="relative z-10">
                        <h4 class="text-yellow-500 font-bold mb-2 uppercase flex items-center md:justify-center gap-2">
                            Normas y Acceso
                        </h4>
                        <p class="text-zinc-300 leading-relaxed font-medium mb-3">
                            Servidor privado con <strong>Whitelist</strong>. Pide entrada en <a href="#discord" class="text-white hover:text-btc-orange underline underline-offset-4 decoration-white/30 hover:decoration-btc-orange transition-all font-bold">Discord</a>, primero <strong>debes conocer la ley</strong>.
                        </p>
                        
                        <div class="flex flex-col gap-1 md:items-center items-start">
                            <a href="#reglas" class="inline-flex items-center gap-1 text-[11px] font-bold uppercase tracking-wider text-btc-orange hover:text-white transition-colors border-b border-btc-orange/30 hover:border-white pb-0.5">
                                <span class="text-lg leading-none">📜</span> Leer Normas (Obligatorio)
                            </a>
                            <a href="#historia" class="inline-block text-[10px] uppercase tracking-wider text-zinc-500 hover:text-zinc-300 transition-colors">
                                ¿Por qué es privado?
                            </a>
                        </div>
                    </div>
                </div>

                <div class="relative pl-8 md:pl-0 text-left md:text-center border-l-2 border-zinc-600 md:border-l-0 md:border-t-2 md:pt-6">
                    <span class="text-4xl font-black text-white/10 absolute -top-3 left-8 md:left-1/2 md:-translate-x-1/2 md:-top-10 z-0 select-none">2</span>
                    <div class="relative z-10">
                        <h4 class="text-white font-bold mb-2 uppercase">Configura</h4>
                        <p class="text-zinc-300 leading-relaxed font-medium">
                            Copia la IP. En <strong>Bedrock</strong>, asegúrate de cambiar el puerto al <span class="text-blue-400 font-mono font-bold bg-blue-500/10 px-1 rounded">{bedrockPort}</span>.
                        </p>
                    </div>
                </div>

                <div class="relative pl-8 md:pl-0 text-left md:text-center border-l-2 border-zinc-600 md:border-l-0 md:border-t-2 md:pt-6">
                    <span class="text-4xl font-black text-white/10 absolute -top-3 left-8 md:left-1/2 md:-translate-x-1/2 md:-top-10 z-0 select-none">3</span>
                    <div class="relative z-10">
                        <h4 class="text-white font-bold mb-2 uppercase">Conecta</h4>
                        <p class="text-zinc-300 leading-relaxed font-medium">
                            Entra. Si ves el mensaje <em class="text-zinc-400 bg-white/5 px-1 rounded not-italic">"Not Whitelisted"</em>, regresa al Paso 1.
                        </p>
                    </div>
                </div>

            </div>
        </div>

    </div>
</section>

<style>
    .is-offline { border-color: #3f3f46 !important; opacity: 0.7; pointer-events: none; }
    .is-offline button { pointer-events: auto; cursor: not-allowed; }
    .is-offline .icon-box { background: #27272a !important; border-color: #3f3f46 !important; box-shadow: none !important; filter: grayscale(100%); }
    .is-offline .main-btn { background-color: #27272a !important; color: #71717a !important; box-shadow: none !important; }
    .is-offline .offline-badge { display: block !important; }
</style>

<script is:inline define:vars={{ javaIP, bedrockIP, bedrockPort }}>
    // ... tus scripts ...
    async function copyText(text, btnElement) {
        // ... copiado ...
         try {
            await navigator.clipboard.writeText(text);
            const originalHTML = btnElement.innerHTML;
            if (btnElement.tagName === 'BUTTON' && !btnElement.querySelector('svg')) {
               btnElement.innerText = "¡COPIADO!";
               btnElement.classList.add('bg-green-600', 'text-white');
               const originalClasses = btnElement.className;
               setTimeout(() => {
                   btnElement.innerText = originalHTML;
                   btnElement.className = originalClasses;
                   btnElement.classList.remove('bg-green-600', 'text-white');
               }, 2000);
            } else {
               const originalContent = btnElement.innerHTML;
               btnElement.innerHTML = `<svg class="w-5 h-5 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7"></path></svg>`;
               btnElement.classList.add('border-green-500');
               setTimeout(() => { 
                   btnElement.innerHTML = originalContent; 
                   btnElement.classList.remove('border-green-500');
               }, 2000);
            }
        } catch (err) { console.error('Error: ', err); }
    }

    document.addEventListener('DOMContentLoaded', () => {
        const checkStatus = async (type, ip, elementId) => {
             // ... status check ...
             try {
                const query = type === 'bedrock' ? `${ip}:${bedrockPort}` : ip;
                const response = await fetch(`https://api.mcstatus.io/v2/status/${type}/${query}`);
                const data = await response.json();
                if (!data.online) {
                    const card = document.getElementById(elementId);
                    if (card) card.classList.add('is-offline');
                }
            } catch (error) { console.error(`Error checking status for ${elementId}`, error); }
        };
        checkStatus('java', javaIP, 'card-java');
        checkStatus('bedrock', bedrockIP, 'card-bedrock');
    });
</script>