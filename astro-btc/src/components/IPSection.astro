---
import JavaCard from './ip/JavaCard.astro';
import BedrockCard from './ip/BedrockCard.astro';
import VersionBox from './ip/VersionBox.astro';
---

<section id="jugar" class="py-24 bg-[#111] border-y border-white/5 relative overflow-hidden">
    <div class="absolute inset-0 bg-[url('/images/dirt-pattern.png')] opacity-5 mix-blend-overlay pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10 max-w-5xl">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            
            <div class="flex flex-col gap-4">
                <h2 class="text-3xl md:text-4xl font-display font-black text-white uppercase tracking-tighter mb-2">
                    Acceso al <span class="text-btc-orange">Servidor</span>
                </h2>
                <p class="text-zinc-400 text-sm mb-6">Copia la dirección del servidor para conectarte. El servidor tiene Whitelist.</p>

                <JavaCard />
                <BedrockCard />
                <VersionBox />
            </div>

            <div class="flex h-full">
                <a href="https://discord.gg/4KzRH5DPzx" target="_blank" rel="noopener noreferrer" class="w-full h-full min-h-[300px] bg-[#5865F2]/10 hover:bg-[#5865F2]/20 border border-[#5865F2]/30 hover:border-[#5865F2] rounded-3xl p-8 flex flex-col items-center justify-center text-center transition-all duration-300 group shadow-lg">
                    <div class="w-20 h-20 bg-[#5865F2] rounded-2xl flex items-center justify-center mb-6 shadow-[0_0_30px_rgba(88,101,242,0.4)] group-hover:scale-110 group-hover:-translate-y-2 transition-all duration-300">
                        <svg class="w-10 h-10 text-white" fill="currentColor" viewBox="0 0 24 24">
                            <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"/>
                        </svg>
                    </div>
                    <h3 class="text-2xl font-display font-black text-white uppercase tracking-tight mb-2">Únete a Discord</h3>
                    <p class="text-zinc-400 text-xs leading-relaxed max-w-[250px]">
                        La única forma de entrar a la Whitelist y jugar es formando parte de nuestra comunidad.
                    </p>
                </a>
            </div>
        </div>
    </div>
</section>

<script src="https://cdnjs.cloudflare.com/ajax/libs/PapaParse/5.4.1/papaparse.min.js" is:inline></script>

<script type="module" is:inline>
    import { getModsAndDatapacks, checkServerFeatures } from '/src/utils/sheetsClient.js';

    document.addEventListener('DOMContentLoaded', async () => {
        const bedrockCard = document.getElementById('bedrock-card-container');
        const versionBox = document.getElementById('version-box-container');

        try {
            const { mods } = await getModsAndDatapacks();
            const features = checkServerFeatures(mods);

            if (features.isBedrock && bedrockCard) {
                bedrockCard.classList.remove('hidden');
                bedrockCard.classList.add('flex');
            }
            if (features.isMultiVersion && versionBox) {
                versionBox.classList.remove('hidden');
            }
        } catch (error) {
            console.error("Error comprobando features IP:", error);
        }

        // Lógica Global de copiado (usada por JavaCard y BedrockCard)
        window.copyText = async function(text, btnElement) {
            try {
                await navigator.clipboard.writeText(text);
                const originalText = btnElement.innerText;
                btnElement.innerText = "¡COPIADO!";
                btnElement.classList.add('!bg-green-600', '!text-white', '!border-green-500');
                
                setTimeout(() => {
                    btnElement.innerText = originalText;
                    btnElement.classList.remove('!bg-green-600', '!text-white', '!border-green-500');
                }, 2000);
            } catch (err) { console.error('Error:', err); }
        };
    });
</script>