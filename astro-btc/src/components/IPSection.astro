---
// src/components/IPSection.astro
---
<section id="ips" class="py-24 bg-[#272727] relative overflow-hidden transition-colors duration-300">
    <div class="container mx-auto px-6 relative z-10">
        
        <h2 class="text-4xl font-display font-bold text-center mb-16 uppercase text-white tracking-tight">
            DIRECCIÓN IP PARA <span class="text-(--text-highlight)">JUGAR</span>
        </h2>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
            
            <div class="group relative bg-[#18181b] border-2 border-zinc-800 rounded-3xl p-8 transition-all duration-300 hover:border-btc-orange">
                
                <div class="flex justify-between items-start mb-6">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-2xl bg-linear-to-br from-orange-500 to-yellow-500 flex items-center justify-center text-3xl shadow-lg">
                            ☕
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-white uppercase">JAVA</h3>
                            <span class="text-xs font-bold text-btc-orange uppercase tracking-widest">PC Edition (Fabric)</span>
                        </div>
                    </div>
                </div>

                <div class="bg-black/40 rounded-xl p-5 border-2 border-zinc-800 mb-6 group-hover:border-btc-orange/50 transition-colors">
                    <span class="text-[10px] text-zinc-500 uppercase font-bold tracking-wider mb-1 block">Dirección IP (Java)</span>
                    <button onclick="copyText('rock-partition.gl.joinmc.link', event)" class="w-full text-left text-xl text-white font-mono font-bold hover:text-btc-orange transition-colors truncate cursor-pointer">
                        rock-partition.gl.joinmc.link
                    </button>
                </div>
                
                <button onclick="copyText('rock-partition.gl.joinmc.link', event)" class="w-full py-4 bg-btc-orange text-white rounded-xl font-bold text-sm transition-all duration-300 hover:bg-white hover:text-btc-orange uppercase tracking-widest">
                    Copiar IP Java
                </button>
            </div>

            <div class="group relative bg-[#18181b] border-2 border-zinc-800 rounded-3xl p-8 transition-all duration-300 hover:border-blue-500">
                
                <div class="flex justify-between items-start mb-6">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-2xl bg-linear-to-br from-blue-600 to-cyan-400 flex items-center justify-center text-3xl text-white shadow-lg">
                            📱
                        </div>
                        <div>
                            <h3 class="text-2xl font-bold text-white uppercase">BEDROCK</h3>
                            <span class="text-xs font-bold text-blue-400 uppercase tracking-widest">Móvil / Consola</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6">
                    <div class="sm:col-span-2 bg-black/40 rounded-xl p-5 border-2 border-zinc-800 group-hover:border-blue-500/50 transition-colors">
                        <span class="text-[10px] text-zinc-500 uppercase font-bold tracking-wider mb-1 block">Dirección IP (Bedrock)</span>
                        <button onclick="copyText('warning-fc.gl.at.ply.gg', event)" class="w-full text-left text-xl text-white font-mono font-bold hover:text-blue-400 transition-colors truncate cursor-pointer">
                            warning-fc.gl.at.ply.gg
                        </button>
                    </div>
                    
                    <button onclick="copyText('55879', event)" class="bg-black/40 rounded-xl p-5 border-2 border-zinc-800 text-center flex flex-col justify-center transition-all hover:border-blue-500/50 cursor-pointer group/port">
                        <span class="text-[10px] text-zinc-500 uppercase font-bold tracking-wider mb-1 block">Puerto</span>
                        <code class="text-xl text-white font-mono font-bold group-hover/port:text-blue-400 transition-colors">55879</code>
                    </button>
                </div>

                <button onclick="copyText('warning-fc.gl.at.ply.gg', event)" class="w-full py-4 bg-blue-500 text-white rounded-xl font-bold text-sm transition-all duration-300 hover:bg-white hover:text-blue-500 uppercase tracking-widest">
                    Copiar IP Bedrock
                </button>
            </div>

        </div>
    </div>
</section>

<script is:inline>
    async function copyText(text, event) {
        try {
            await navigator.clipboard.writeText(text);
            const btn = event.currentTarget;
            const originalContent = btn.innerHTML;
            
            // Feedback visual sin cambiar el tamaño de la caja
            if (btn.tagName === 'BUTTON' && btn.innerText.includes('COPIAR')) {
                btn.innerText = "¡COPIADO!";
            }
            
            btn.classList.add('border-green-500');
            
            setTimeout(() => {
                btn.innerHTML = originalContent;
                btn.classList.remove('border-green-500');
            }, 1500);
        } catch (err) {
            console.error('Error al copiar: ', err);
        }
    }
</script>