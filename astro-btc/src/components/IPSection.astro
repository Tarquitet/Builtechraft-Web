---
import { SERVER_INFO } from '../config-ip';
const { javaIP, bedrockIP, bedrockPort } = SERVER_INFO;
---

<section id="ips" class="py-24 bg-[#272727] relative overflow-hidden">
    <div class="container mx-auto px-6 relative z-10">
        
        <h2 class="text-3xl md:text-4xl font-display font-bold text-center mb-16 uppercase text-white tracking-tight">
            COMO SER PARTE <span class="text-btc-orange">DEL SERVIDOR</span>
        </h2>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto mb-16">
            <div id="card-java" class="group relative bg-[#18181b] border-2 border-zinc-800 rounded-3xl p-8 transition-all duration-500 flex flex-col">
                <div class="offline-badge absolute top-4 right-4 bg-red-600 border border-white/20 text-white text-[10px] font-bold px-2 py-1 rounded hidden uppercase tracking-widest z-20">● Offline</div>
                <div class="flex items-center gap-4 mb-6">
                    <div class="icon-box w-14 h-14 rounded-xl bg-linear-to-br from-orange-600 to-yellow-600 flex items-center justify-center text-3xl shadow-lg border-4 border-[#18181b]">☕</div>
                    <div>
                        <h3 class="text-2xl font-bold text-white uppercase leading-none">JAVA</h3>
                        <span class="text-[10px] font-bold text-btc-orange uppercase tracking-widest">PC Edition (Fabric)</span>
                    </div>
                </div>
                <div class="bg-black/40 rounded-xl p-5 border border-zinc-800 mb-6 group-hover:border-btc-orange/50 transition-colors flex-1 flex flex-col justify-center relative">
                    <span class="text-[10px] text-zinc-500 uppercase font-bold tracking-wider mb-2 block">Dirección IP</span>
                    <button onclick={`copyText('${javaIP}', this)`} class="action-btn w-full text-left flex justify-between items-center group/ip cursor-pointer" title="Copiar IP">
                        <span class="text-lg md:text-xl text-white font-mono font-bold truncate mr-2 ip-text">{javaIP}</span>
                        <svg class="w-5 h-5 text-zinc-600 group-hover/ip:text-btc-orange transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                        </svg>
                    </button>
                </div>
                <button onclick={`copyText('${javaIP}', this)`} class="main-btn w-full py-4 bg-btc-orange text-white rounded-xl font-bold text-sm transition-all duration-300 hover:bg-white hover:text-btc-orange uppercase tracking-widest shadow-lg">Copiar IP Java</button>
            </div>

            <div id="card-bedrock" class="group relative bg-[#18181b] border-2 border-zinc-800 rounded-3xl p-8 transition-all duration-500 flex flex-col">
                <div class="offline-badge absolute top-4 right-4 bg-red-600 border border-white/20 text-white text-[10px] font-bold px-2 py-1 rounded hidden uppercase tracking-widest z-20">● Offline</div>
                <div class="flex items-center gap-4 mb-6">
                    <div class="icon-box w-14 h-14 rounded-xl bg-linear-to-br from-blue-600 to-cyan-500 flex items-center justify-center text-3xl shadow-lg border-4 border-[#18181b]">📱</div>
                    <div>
                        <h3 class="text-2xl font-bold text-white uppercase leading-none">BEDROCK</h3>
                        <span class="text-[10px] font-bold text-blue-400 uppercase tracking-widest">Móvil / Consola</span>
                    </div>
                </div>
                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-6 flex-1">
                    <div class="sm:col-span-2 bg-black/40 rounded-xl p-5 border border-zinc-800 group-hover:border-blue-500/30 transition-colors flex flex-col justify-center relative">
                        <span class="text-[10px] text-zinc-500 uppercase font-bold tracking-wider mb-2 block">Dirección IP</span>
                        <button onclick={`copyText('${bedrockIP}', this)`} class="action-btn w-full text-left flex justify-between items-center group/ip cursor-pointer" title="Copiar IP">
                            <span class="text-lg md:text-xl text-white font-mono font-bold truncate mr-2 ip-text">{bedrockIP}</span>
                            <svg class="w-4 h-4 text-zinc-600 group-hover:text-blue-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path>
                            </svg>
                        </button>
                    </div>
                    <div class="bg-black/40 rounded-xl p-5 border border-zinc-800 text-center flex flex-col justify-center transition-colors group-hover:border-blue-500/30 cursor-pointer relative" onclick={`copyText('${bedrockPort}', this)`}>
                        <span class="text-[10px] text-zinc-500 uppercase font-bold tracking-wider mb-1 block">Puerto</span>
                        <code class="text-xl text-blue-400 font-mono font-bold ip-text">{bedrockPort}</code>
                    </div>
                </div>
                <div class="grid grid-cols-2 gap-3 mt-auto">
                    <button onclick={`copyText('${bedrockIP}', this)`} class="main-btn py-4 bg-blue-600 text-white rounded-xl font-bold text-[10px] md:text-xs transition-all duration-300 hover:bg-white hover:text-blue-600 uppercase tracking-widest shadow-lg">Copiar IP</button>
                    <a href={`minecraft://?addExternalServer=Builtechraft%7C${bedrockIP}%7C${bedrockPort}`} class="py-4 bg-zinc-800 text-blue-400 border border-blue-500/30 rounded-xl font-bold text-[10px] md:text-xs text-center transition-all duration-300 hover:bg-blue-500 hover:text-white hover:border-blue-500 uppercase tracking-widest flex items-center justify-center">Entrar Directo</a>
                </div>
            </div>
        </div>

        <div class="max-w-5xl mx-auto mb-16">
            <h3 class="text-xs font-bold text-zinc-300 uppercase tracking-[0.2em] mb-12 text-center">
                PROCESO DE CONEXIÓN
            </h3>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-12 md:gap-8 text-sm">
                <div class="relative pl-8 md:pl-0 text-left md:text-center border-l-2 border-btc-orange md:border-l-0 md:border-t-2 md:pt-6">
                    <span class="text-4xl font-black text-btc-orange/50 absolute -top-3 left-8 md:left-1/2 md:-translate-x-1/2 md:-top-10 z-0 select-none">1</span>
                    <div class="relative z-10">
                        <h4 class="text-btc-orange font-bold mb-2 uppercase">Normas y Whitelist</h4>
                        <p class="text-zinc-300 leading-relaxed font-medium">
                            Servidor privado. Lee las <a href="#reglas" class="text-white hover:text-btc-orange underline underline-offset-4 decoration-white/20 transition-all font-bold">Normas Oficiales</a> y solicita tu acceso vía <a href="#discord" class="text-blue-500 hover:text-btc-orange transition-colors duration-300 font-bold underline underline-offset-4 decoration-blue-500/30 hover:decoration-btc-orange">Discord</a>.
                        </p>
                    </div>
                </div>

                <div class="relative pl-8 md:pl-0 text-left md:text-center border-l-2 border-zinc-600 md:border-l-0 md:border-t-2 md:pt-6">
                    <span class="text-4xl font-black text-white/50 absolute -top-3 left-8 md:left-1/2 md:-translate-x-1/2 md:-top-10 z-0 select-none">2</span>
                    <div class="relative z-10">
                        <h4 class="text-zinc-400 font-bold mb-2 uppercase">Configura</h4>
                        <p class="text-zinc-300 leading-relaxed font-medium">
                            Copia la IP. En <strong>Bedrock</strong>, recuerda cambiar el puerto al <span class="text-blue-400 font-mono font-bold bg-blue-500/10 px-1 rounded">{bedrockPort}</span>.
                        </p>
                    </div>
                </div>

                <div class="relative pl-8 md:pl-0 text-left md:text-center border-l-2 border-zinc-600 md:border-l-0 md:border-t-2 md:pt-6">
                    <span class="text-4xl font-black text-white/50 absolute -top-3 left-8 md:left-1/2 md:-translate-x-1/2 md:-top-10 z-0 select-none">3</span>
                    <div class="relative z-10">
                        <h4 class="text-zinc-400 font-bold mb-2 uppercase">¡Listo!</h4>
                        <p class="text-zinc-300 leading-relaxed font-medium">
                            Entra al servidor. Si aparece el mensaje <em class="text-zinc-400 bg-white/5 px-1 rounded not-italic">"Not Whitelisted"</em>. Regresa al paso 1.
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <div id="version-warning-box" class="max-w-4xl mx-auto bg-amber-500/5 border border-amber-500/20 rounded-2xl p-6 transition-all opacity-50">
            <div class="flex flex-col md:flex-row items-center justify-between gap-6 text-center md:text-left">
                <div class="space-y-2 flex-1">
                    <h4 class="text-amber-500 font-bold uppercase tracking-widest text-xs flex items-center justify-center md:justify-start gap-2 m-0">
                        ⚠️ INFORMACIÓN IMPORTANTE
                    </h4>
                    <p id="version-text" class="text-zinc-300 text-sm leading-relaxed m-0">
                        Consultando información...
                    </p>
                </div>

                <a href="#discord" class="whitespace-nowrap bg-zinc-800 hover:bg-zinc-700 text-zinc-300 text-[10px] font-bold py-2.5 px-5 rounded-xl border border-zinc-700 transition-all uppercase tracking-widest shadow-lg hover:text-white">
                    Más info en Discord
                </a>
            </div>
        </div>

    </div>
</section>

<script is:inline>
    // 1. Escuchar el evento que manda el ServerStatus.jsx
    window.addEventListener('btc:server-versions', (e) => {
        const warningBox = document.getElementById('version-warning-box');
        const versionText = document.getElementById('version-text');
        const cardJava = document.getElementById('card-java');
        const cardBedrock = document.getElementById('card-bedrock');
        
        // Obtenemos los datos limpiados del React
        const { online, javaMin, javaMax, bedrockVersion, recommended } = e.detail;

        if (warningBox && versionText) {
            if (online) {
                // ONLINE
                warningBox.classList.remove('opacity-50');
                cardJava?.classList.remove('is-offline');
                cardBedrock?.classList.remove('is-offline');
                
                // Lógica condicional para Bedrock (por si en el futuro trae un rango separado por guion)
                let bedrockHtml = `📱 Compatible con <strong>Bedrock</strong> desde la versión <span class="text-white font-mono font-bold">${bedrockVersion}</span>.`;
                if (bedrockVersion && bedrockVersion.includes('-')) {
                    const parts = bedrockVersion.split('-');
                    bedrockHtml = `📱 Compatible con <strong>Bedrock</strong> desde la versión <span class="text-white font-mono font-bold">${parts[0].trim()}</span> hasta la <span class="text-white font-mono font-bold">${parts[1].trim()}</span>.`;
                }

                versionText.innerHTML = `
                    <span class="block mb-2">☕ Soportamos para <strong>Java</strong> desde la versión <span class="text-white font-mono font-bold">${javaMin}</span> hasta la <span class="text-white font-mono font-bold">${javaMax}</span> (recomendada).</span>
                    <span class="block mb-1">${bedrockHtml}</span>
                `;
            } else {
                // OFFLINE
                warningBox.classList.add('opacity-50');
                cardJava?.classList.add('is-offline');
                cardBedrock?.classList.add('is-offline');
                
                versionText.innerHTML = `Servidor fuera de línea. La versión recomendada para conectarse es la <span class="text-white font-mono font-bold">${recommended}</span>.`;
            }
        }
    });

    // 2. Función de copiado con bloqueo estricto cuando está Offline
    window.copyText = async function(text, btnElement) {
        if (btnElement.closest('.is-offline')) return;

        try {
            await navigator.clipboard.writeText(text);
            const textEl = btnElement.querySelector('.ip-text') || btnElement;
            const original = textEl.innerText;
            
            if (original === "¡COPIADO!") return;
            
            textEl.innerText = "¡COPIADO!";
            if (btnElement.classList.contains('main-btn')) {
                btnElement.classList.add('!bg-green-600', '!text-white');
            } else {
                textEl.classList.add('text-green-500');
            }

            setTimeout(() => {
                textEl.innerText = original;
                textEl.classList.remove('text-green-500');
                btnElement.classList.remove('!bg-green-600', '!text-white');
            }, 2000);
        } catch (err) { console.error('Error al copiar: ', err); }
    };
</script>

<style>
    .hidden { display: none !important; }
    /* Bloqueo visual y de interacción cuando está Offline */
    .is-offline { 
        filter: grayscale(1); 
        opacity: 0.4; 
        pointer-events: none !important; 
        cursor: not-allowed;
    }
    .is-offline .offline-badge { display: block; }
</style>