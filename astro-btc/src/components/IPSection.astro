---
// src/components/IPSection.astro
---
<section id="ips" class="py-24 bg-[#0a0a0c] relative overflow-hidden">
    
    <div class="absolute top-1/2 left-0 w-96 h-96 bg-orange-500/10 rounded-full blur-[120px] -translate-y-1/2 pointer-events-none"></div>
    <div class="absolute top-1/2 right-0 w-96 h-96 bg-blue-500/10 rounded-full blur-[120px] -translate-y-1/2 pointer-events-none"></div>

    <div class="container mx-auto px-6 relative z-10">
        <h2 class="text-4xl font-display font-bold text-center mb-16 uppercase text-white tracking-tight">
            Punto de <span class="text-transparent bg-clip-text bg-gradient-to-r from-btc-gold to-btc-orange">Conexión</span>
        </h2>
        
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
            
            <div class="group relative bg-[#111114] border border-orange-500/20 rounded-3xl p-8 transition-all hover:border-orange-500/50 hover:shadow-[0_0_30px_rgba(249,115,22,0.1)]">
                <div class="flex justify-between items-start mb-6">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-orange-500 to-yellow-500 flex items-center justify-center text-2xl text-black shadow-lg">☕</div>
                        <div>
                            <h3 class="text-2xl font-bold text-white">JAVA</h3>
                            <span class="text-xs font-bold text-orange-400 uppercase tracking-widest">PC Edition (Fabric)</span>
                        </div>
                    </div>
                </div>

                <div class="bg-black/40 rounded-xl p-5 border border-white/5 mb-4 group-hover:border-orange-500/30 transition-colors relative">
                    <span class="text-[10px] text-gray-500 uppercase font-bold tracking-wider mb-1 block">Dirección IP (Clic para copiar)</span>
                    <button onclick="copyText('rock-partition.gl.joinmc.link')" class="w-full text-left text-xl md:text-2xl text-white font-mono font-bold hover:text-orange-400 transition-colors break-all" title="Clic para copiar">
                        rock-partition.gl.joinmc.link
                    </button>
                </div>
                
                <button onclick="copyText('rock-partition.gl.joinmc.link')" class="w-full py-3 bg-orange-600/10 hover:bg-orange-600 text-orange-500 hover:text-white border border-orange-500/50 rounded-lg font-bold text-sm transition-all flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                    COPIAR IP JAVA
                </button>
            </div>

            <div class="group relative bg-[#111114] border border-blue-500/20 rounded-3xl p-8 transition-all hover:border-blue-500/50 hover:shadow-[0_0_30px_rgba(59,130,246,0.1)]">
                <div class="flex justify-between items-start mb-6">
                    <div class="flex items-center gap-4">
                        <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-blue-600 to-cyan-400 flex items-center justify-center text-2xl text-white shadow-lg">📱</div>
                        <div>
                            <h3 class="text-2xl font-bold text-white">BEDROCK</h3>
                            <span class="text-xs font-bold text-blue-400 uppercase tracking-widest">Móvil / Consola</span>
                        </div>
                    </div>
                </div>

                <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mb-4">
                    <div class="sm:col-span-2 bg-black/40 rounded-xl p-4 border border-white/5 relative">
                        <span class="text-[10px] text-gray-500 uppercase font-bold tracking-wider mb-1 block">IP</span>
                        <button onclick="copyText('warning-fc.gl.at.ply.gg')" class="w-full text-left text-lg text-white font-mono font-bold hover:text-blue-400 transition-colors truncate" title="Clic para copiar">
                            warning-fc.gl.at.ply.gg
                        </button>
                    </div>
                    <div class="bg-blue-500/10 rounded-xl p-4 border border-blue-500/20 text-center">
                        <span class="text-[10px] text-blue-300 uppercase font-bold tracking-wider mb-1 block">Puerto</span>
                        <code class="text-xl text-white font-mono font-bold">55879</code>
                    </div>
                </div>

                <button onclick="copyText('warning-fc.gl.at.ply.gg')" class="w-full py-3 bg-blue-600/10 hover:bg-blue-600 text-blue-500 hover:text-white border border-blue-500/50 rounded-lg font-bold text-sm transition-all flex items-center justify-center gap-2">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 5H6a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2v-1M8 5a2 2 0 002 2h2a2 2 0 002-2M8 5a2 2 0 012-2h2a2 2 0 012 2m0 0h2a2 2 0 012 2v3m2 4H10m0 0l3-3m-3 3l3 3"></path></svg>
                    COPIAR IP BEDROCK
                </button>
            </div>

        </div>
    </div>
</section>

<script is:inline>
    function copyText(text) {
        navigator.clipboard.writeText(text);
        alert('¡IP Copiada! ' + text);
    }
</script>