---
import ConfigLoader from './ip/ConfigLoader.astro';
import JavaCard from './ip/JavaCard.astro';
import BedrockCard from './ip/BedrockCard.astro';
import VersionBox from './ip/VersionBox.astro';
import DiscordCard from './ip/DiscordCard.astro';
---

<ConfigLoader />

<section id="jugar" class="py-24 bg-[#111] border-y border-white/5 relative overflow-hidden">
    <div class="absolute inset-0 opacity-5 mix-blend-overlay pointer-events-none"></div>

        <div class="container mx-auto px-6 relative z-10 max-w-4xl">
            
            <div class="flex flex-col items-center text-center mb-10">
                <h2 class="text-3xl md:text-5xl font-display font-black text-white uppercase tracking-tighter mb-4">
                    Acceso al <span class="text-btc-orange">Servidor</span>
                </h2>
                <p class="text-zinc-400 text-sm md:text-base max-w-xl">
                    Copia la dirección del servidor y únete a la comunidad
                </p>
            </div>

            <div class="flex flex-col gap-4 mb-6">
                <JavaCard />
                <BedrockCard />
                <VersionBox />
            </div>

            <DiscordCard />
        </div>
    </div>
</section>