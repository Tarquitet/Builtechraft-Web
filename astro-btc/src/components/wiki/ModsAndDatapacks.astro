---
// src/components/wiki/ModsAndDatapacks.astro
---

<style>
    .mod-item:nth-child(odd) { align-self: flex-start; margin-top: 0.5rem; }
    .mod-item:nth-child(even) { align-self: flex-end; margin-bottom: 0.5rem; }
    
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    .hide-scrollbar::-webkit-scrollbar { display: none; }

    /* ===== BOTONES DE SCROLL CON ZERO JS (CSS Overflow 5) ===== */
    .slider {
        position: relative;
        scroll-behavior: smooth;
    }

    .slider::scroll-button(left),
    .slider::scroll-button(right) {
        position: absolute;
        top: 50%;
        translate: 0 -50%;
        z-index: 10;
        display: grid;
        place-items: center;
        inline-size: 2.75rem;
        block-size: 2.75rem;
        border-radius: 50%;
        border: 1px solid var(--border-subtle);
        background: var(--bg-card);
        color: var(--text-main);
        cursor: pointer;
        opacity: 0;
        transition: opacity .25s, background-color .25s, color .25s;
    }

    .slider::scroll-button(left)  { content: "←"; left: -0.75rem; }
    .slider::scroll-button(right) { content: "→"; right: -0.75rem; }

    .slider:hover::scroll-button(left),
    .slider:hover::scroll-button(right) { opacity: 1; }

    .slider::scroll-button(left):hover,
    .slider::scroll-button(right):hover {
        background: #ea580c;
        border-color: #ea580c;
        color: #fff;
    }

    /* Se deshabilitan solos en los bordes (zero JS) */
    .slider::scroll-button(left):disabled,
    .slider::scroll-button(right):disabled {
        opacity: 0;
        pointer-events: none;
    }
</style>

<div id="loading-mods" class="flex flex-col justify-center items-center py-10 mb-10 text-theme-muted gap-3">
    <span class="text-3xl animate-bounce">📦</span>
    <span class="animate-pulse font-bold tracking-widest uppercase text-sm">Sincronizando base de datos...</span>
</div>

<div id="datapacks-section" class="hidden flex-col mb-16 relative z-20">
    <div class="mb-6 flex items-center gap-3 border-b border-theme pb-4">
        <span class="text-2xl">🗂️</span>
        <h3 class="text-xl font-display font-bold text-btc-yellow uppercase tracking-widest m-0">Datapacks Instalados</h3>
    </div>
    
    <div id="datapacks-list" class="slider flex overflow-x-auto snap-x snap-mandatory gap-5 pb-4 hide-scrollbar h-[420px] px-2 py-4"></div>
</div>

<div id="mods-section" class="hidden flex-col mb-20 relative z-20">
    <div class="mb-6 flex items-center gap-3 border-b border-theme pb-4">
        <span class="text-2xl">⚙️</span>
        <h3 class="text-xl font-display font-bold text-blue-500 uppercase tracking-widest m-0">Mods del Servidor</h3>
    </div>
    
    <div id="mods-list" class="slider flex overflow-x-auto snap-x snap-mandatory gap-5 pb-4 hide-scrollbar h-[420px] px-2 py-4"></div>
</div>

<script>
import { getModsAndDatapacks } from '../../utils/sheetsClient.js';

const createModCardHTML = (item: any) => {
    const getColorClass = (tipo: string) => {
        const t = tipo ? tipo.toLowerCase() : '';
        if(t.includes('mod')) return { border: 'border-blue-500/50', badge: 'bg-blue-500/10 text-blue-500 border-blue-500/20' };
        if(t.includes('plugin')) return { border: 'border-orange-500/50', badge: 'bg-orange-500/10 text-orange-500 border-orange-500/20' };
        if(t.includes('proxy')) return { border: 'border-emerald-500/50', badge: 'bg-emerald-500/10 text-emerald-500 border-emerald-500/20' };
        if(t.includes('datapack')) return { border: 'border-btc-yellow/50', badge: 'bg-yellow-500/10 text-btc-yellow border-btc-yellow/20' };
        return { border: 'border-theme-muted/50', badge: 'bg-theme-alternate text-theme-muted border-theme' };
    };

    const colors = getColorClass(item.Type);
    const iconSrc = item.Icon 
        ? `<img src="${item.Icon}" alt="${item.Name}" class="w-full h-full object-contain drop-shadow-lg transition-transform duration-500 group-hover/card:scale-105" loading="lazy" />` 
        : `<div class="w-full h-full flex items-center justify-center text-theme-muted text-4xl font-bold opacity-30">?</div>`;
    
    const maxChars = 85; 
    const fullDesc = item.Desc || '';
    const isTruncated = fullDesc.length > maxChars;
    const displayDesc = isTruncated ? fullDesc.substring(0, maxChars).trim() + '...' : fullDesc;
    
    return `
        <div class="mod-item snap-center shrink-0 w-60 flex flex-col bg-theme-card border border-theme rounded-2xl overflow-hidden hover:${colors.border} transition-colors duration-300 shadow-lg group/card">
            <div class="w-full h-32 bg-black/10 dark:bg-black/40 relative flex items-center justify-center border-b border-theme p-4">
                ${iconSrc}
            </div>
            <div class="p-5 flex flex-col flex-grow">
                <h4 class="font-bold text-theme-main text-sm m-0 mb-3 truncate">${item.Name}</h4>
                <span class="text-[9px] uppercase tracking-widest font-bold px-2 py-0.5 rounded ${colors.badge} border inline-block mb-3 self-start">${item.Type}</span>
                <p class="text-xs text-theme-muted leading-relaxed m-0 flex-grow">${displayDesc}</p>
                <a href="${item.Url}" target="_blank" rel="noopener noreferrer" class="mt-5 w-full text-center py-2.5 px-4 rounded-xl text-[10px] font-bold uppercase tracking-widest transition-colors border border-theme bg-theme-alternate hover:bg-btc-orange/10 hover:text-btc-orange text-theme-main">
                    ${isTruncated ? 'Leer más' : 'Ver enlace'}
                </a>
            </div>
        </div>
    `;
};

document.addEventListener('DOMContentLoaded', async () => {
    const dpList = document.getElementById('datapacks-list');
    const modsList = document.getElementById('mods-list');
    const dpSection = document.getElementById('datapacks-section');
    const modsSection = document.getElementById('mods-section');
    const loadingEl = document.getElementById('loading-mods');

    try {
        const { mods, datapacks } = await getModsAndDatapacks();
        
        if (datapacks.length > 0 && dpList && dpSection) {
            dpList.innerHTML = datapacks.map(createModCardHTML).join('');
            dpSection.classList.replace('hidden', 'flex');
        }

        if (mods.length > 0 && modsList && modsSection) {
            modsList.innerHTML = mods.map(createModCardHTML).join('');
            modsSection.classList.replace('hidden', 'flex');
        }
        
        if(loadingEl) loadingEl.style.display = 'none';
    } catch (err) {
        console.error("Error cargando mods:", err);
        if(loadingEl) loadingEl.innerHTML = "<span class='text-red-500 font-bold'>Error al conectar con la base de datos.</span>";
    }
});
</script>