---
// src/components/wiki/Staff.astro
export const title = "Miembros del Equipo";
export const category = "Equipo y Staff";
export const order = 2;
---

<section id="staff" class="py-24 relative overflow-hidden border-y border-white/5 bg-[#0a0a0c] min-h-[750px]">
    <div class="container mx-auto px-6 max-w-4xl">
        <h2 class="text-4xl md:text-5xl font-display font-bold text-center mb-16 uppercase text-white tracking-tight">
            Nuestro <span class="text-btc-orange">Equipo</span>
        </h2>

        <div id="loading-staff" class="flex flex-col justify-center items-center py-10 text-zinc-500 gap-3">
            <span class="text-4xl animate-bounce">👑</span>
            <span class="animate-pulse font-bold tracking-widest uppercase text-sm">Cargando equipo...</span>
        </div>

        <!-- CONTENEDOR PRINCIPAL CON ALTURA MÍNIMA PARA EVITAR SALTOS -->
        <div id="staff-container" class="hidden flex-col gap-12 min-h-[450px]">
            
            <!-- FILAS JERÁRQUICAS SIMPLES -->
            <div id="staff-rows" class="flex flex-col gap-10">
                
                <!-- Nivel 1: Líder -->
                <div class="flex flex-col items-center gap-4">
                    <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-btc-orange bg-btc-orange/10 px-3 py-1 rounded-full border border-btc-orange/20">Líder / Fundador</span>
                    <div id="row-lider" class="flex flex-wrap justify-center gap-4"></div>
                </div>

                <!-- Nivel 2: Administradores -->
                <div class="flex flex-col items-center gap-4">
                    <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-red-400 bg-red-500/10 px-3 py-1 rounded-full border border-red-500/20">Administradores</span>
                    <div id="row-admin" class="flex flex-wrap justify-center gap-4"></div>
                </div>

                <!-- Nivel 3: Vigilantes -->
                <div class="flex flex-col items-center gap-4">
                    <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-blue-400 bg-blue-500/10 px-3 py-1 rounded-full border border-blue-500/20">Vigilantes</span>
                    <div id="row-vigilante" class="flex flex-wrap justify-center gap-4"></div>
                </div>

                <!-- Nivel 4: Retirados -->
                <div class="flex flex-col items-center gap-4 pt-6 border-t border-white/5">
                    <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-zinc-500 bg-zinc-800/40 px-3 py-1 rounded-full border border-zinc-700/40">Retirados</span>
                    <div id="row-retirado" class="flex flex-wrap justify-center gap-4 opacity-75"></div>
                </div>

            </div>

            <!-- TARJETA DE DETALLE -->
            <div id="staff-detail-card" class="hidden bg-zinc-900 border border-white/10 rounded-3xl p-8 shadow-2xl flex-col sm:flex-row items-center gap-6 relative">
                <button id="close-detail-btn" class="absolute top-4 right-4 text-zinc-400 hover:text-white p-2 text-xs font-bold uppercase tracking-widest cursor-pointer">
                    ✕ Cerrar
                </button>
                <div id="detail-avatar-container" class="w-24 h-24 rounded-2xl overflow-hidden shrink-0 bg-black border border-white/10">
                    <img id="detail-avatar" src="" alt="" class="w-full h-full object-cover" />
                </div>
                <div class="flex flex-col text-center sm:text-left">
                    <h3 id="detail-name" class="text-2xl font-bold text-white uppercase mb-1">Nombre</h3>
                    <span id="detail-role" class="text-xs font-bold uppercase tracking-widest text-btc-orange mb-3">Rol</span>
                    <p id="detail-bio" class="text-zinc-300 text-xs leading-relaxed mb-4">Biografía...</p>
                    <div id="detail-socials" class="flex flex-wrap justify-center sm:justify-start gap-2"></div>
                </div>
            </div>

        </div>
    </div>
</section>

<script>
import { getStaffData } from '../../utils/sheetsClient.js';

document.addEventListener('DOMContentLoaded', async () => {
    const loadingEl = document.getElementById('loading-staff');
    const container = document.getElementById('staff-container');
    const rowsWrapper = document.getElementById('staff-rows');
    const detailCard = document.getElementById('staff-detail-card');
    const closeBtn = document.getElementById('close-detail-btn');

    const rowLider = document.getElementById('row-lider');
    const rowAdmin = document.getElementById('row-admin');
    const rowVigilante = document.getElementById('row-vigilante');
    const rowRetirado = document.getElementById('row-retirado');

    const defaultAvatar = 'https://ui-avatars.com/api/?name=Staff&background=18181b&color=fff&size=150';

    const getRoleCategory = (rol: string) => {
        const r = rol?.toLowerCase().trim() || '';
        if (r.includes('lider') || r.includes('líder') || r.includes('fundador')) return 'lider';
        if (r.includes('admin')) return 'admin';
        if (r.includes('vigilante') || r.includes('moderador')) return 'vigilante';
        return 'retirado';
    };

    const getBorderColor = (cat: string) => {
        if (cat === 'lider') return 'border-btc-orange hover:border-white';
        if (cat === 'admin') return 'border-red-500 hover:border-white';
        if (cat === 'vigilante') return 'border-blue-500 hover:border-white';
        return 'border-zinc-700 hover:border-zinc-400';
    };

    try {
        const staffMembers = await getStaffData();

        if (staffMembers && staffMembers.length > 0) {
            staffMembers.forEach((member: any) => {
                const cat = getRoleCategory(member.Rol);
                const borderColor = getBorderColor(cat);
                const avatarUrl = member.Avatar?.trim() ? member.Avatar.trim() : defaultAvatar;

                const btnHtml = `
                    <button class="staff-btn bg-zinc-900 border ${borderColor} rounded-2xl px-5 py-3 flex items-center gap-3 cursor-pointer transition-all duration-300 hover:bg-zinc-800 shadow-md group" data-member='${JSON.stringify(member)}'>
                        <img src="${avatarUrl}" alt="${member.Nombre}" class="w-10 h-10 rounded-full object-cover bg-black" onerror="this.onerror=null; this.src='${defaultAvatar}';" />
                        <div class="text-left">
                            <h4 class="text-white font-bold text-xs uppercase tracking-wider group-hover:text-btc-orange transition-colors">${member.Nombre}</h4>
                            <span class="text-[9px] text-zinc-400 uppercase tracking-widest block">${member.Rol || 'Staff'}</span>
                        </div>
                    </button>
                `;

                if (cat === 'lider' && rowLider) rowLider.innerHTML += btnHtml;
                else if (cat === 'admin' && rowAdmin) rowAdmin.innerHTML += btnHtml;
                else if (cat === 'vigilante' && rowVigilante) rowVigilante.innerHTML += btnHtml;
                else if (rowRetirado) rowRetirado.innerHTML += btnHtml;
            });

            if (loadingEl) loadingEl.style.display = 'none';
            if (container) {
                container.classList.remove('hidden');
                container.classList.add('flex');
            }

            const buttons = document.querySelectorAll('.staff-btn');
            buttons.forEach(btn => {
                btn.addEventListener('click', () => {
                    const data = JSON.parse(btn.getAttribute('data-member') || '{}');
                    
                    if (rowsWrapper) rowsWrapper.style.display = 'none';
                    
                    const imgEl = document.getElementById('detail-avatar') as HTMLImageElement;
                    if (imgEl) imgEl.src = data.Avatar?.trim() ? data.Avatar.trim() : defaultAvatar;
                    
                    const nameEl = document.getElementById('detail-name');
                    if (nameEl) nameEl.textContent = data.Nombre;

                    const roleEl = document.getElementById('detail-role');
                    if (roleEl) roleEl.textContent = data.Rol || 'Staff';

                    const bioEl = document.getElementById('detail-bio');
                    if (bioEl) bioEl.textContent = data.Bio || 'Sin biografía disponible.';

                    const socialsEl = document.getElementById('detail-socials');
                    if (socialsEl) {
                        socialsEl.innerHTML = '';
                        ['Twitch', 'Youtube', 'Github'].forEach(red => {
                            if (data[red] && data[red].trim() !== '') {
                                socialsEl.innerHTML += `<a href="${data[red]}" target="_blank" rel="noopener noreferrer" class="px-3 py-1.5 bg-white/5 hover:bg-btc-orange border border-white/10 rounded-xl text-[10px] font-bold uppercase tracking-widest text-zinc-200 hover:text-white transition-all">${red}</a>`;
                            }
                        });
                    }

                    if (detailCard) {
                        detailCard.classList.remove('hidden');
                        detailCard.classList.add('flex');
                    }
                });
            });

            if (closeBtn) {
                closeBtn.addEventListener('click', () => {
                    if (detailCard) {
                        detailCard.classList.remove('flex');
                        detailCard.classList.add('hidden');
                    }
                    if (rowsWrapper) rowsWrapper.style.display = 'flex';
                });
            }
        }
    } catch (error) {
        console.error("Error cargando staff:", error);
        if (loadingEl) loadingEl.innerHTML = "<span class='text-red-400 font-bold'>Error al conectar con la API de Staff.</span>";
    }
});
</script>