---
// src/components/wiki/WikiRuleItem.astro
// Sub-norma con código (1.1.a) en badge naranja. Va DENTRO de WikiRule.
const { code = '' } = Astro.props as { code?: string };
---

<div class="wiki-rule-item">
  {code && <span class="wri-code">{code}</span>}
  <div class="wri-text"><slot /></div>
</div>

<style is:global>
  .wiki-rule-item {
    display: flex;
    gap: .7rem;
    padding: .6rem .7rem;
    background: color-mix(in srgb, var(--bg-card) 60%, var(--bg-section, transparent));
    border-left: 2px solid color-mix(in srgb, var(--text-accent) 45%, transparent);
    margin-bottom: .5rem;
  }
  .wri-code {
    flex-shrink: 0;
    font-family: monospace;
    font-size: .65rem;
    font-weight: 700;
    color: var(--text-accent);
    background: color-mix(in srgb, var(--text-accent) 10%, transparent);
    border: 1px solid color-mix(in srgb, var(--text-accent) 25%, transparent);
    padding: .15rem .4rem;
    height: fit-content;
    margin-top: .15rem;
  }
  .wri-text { color: var(--text-muted); font-size: .85rem; line-height: 1.6; }
  .wri-text strong { color: var(--text-main); }
  .wri-text p { margin: 0; }
</style>