---
// src/components/wiki/WikiLink.astro
import links from '../../data/links.json';
import { getLocaleFromPath, localizePath } from '../../lib/i18n';

const { to } = Astro.props as { to: string };
const articleModules = import.meta.glob('../../data/wiki/*/*/articles/*.mdx');
const articlePath = Object.keys(articleModules).find((path) => path.endsWith(`/${to}.mdx`));
const pathParts = articlePath?.split('/') || [];
const category = pathParts[pathParts.length - 3];
const isDiscord = to === 'discord';
const targetPath = to.startsWith('/') ? to : articlePath ? `/wiki/${category}/articles/${to}` : `/wiki/${to}`;
const url = isDiscord
  ? links.social.discord
  : localizePath(targetPath, getLocaleFromPath(Astro.url.pathname));
const isExternal = url.startsWith('http');
---

<a href={url} class="wiki-link" target={isExternal ? '_blank' : undefined} rel={isExternal ? 'noopener noreferrer' : undefined}><slot /></a>

<style>
  .wiki-link {
    color: var(--text-accent);
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(249, 115, 22, 0.3);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s;
  }
  .wiki-link:hover {
    text-decoration-color: var(--text-accent);
  }
</style>