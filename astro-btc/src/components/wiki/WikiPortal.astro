---
import { getDictionary, getLocaleFromPath, localizePath, type Locale } from '../../lib/i18n';
import { getWikiCategories, getWikiArticles } from '../../lib/wikiContent';
import { DiscordBanner } from '../discord/DiscordBanner.astro';

const locale = getLocaleFromPath(Astro.url.pathname) as Locale;
const dict = getDictionary(locale);
const wikiDict = dict.common?.wiki || {};
const localizedPrefix = locale === 'en' ? '/en' : '';

const categories = getWikiCategories(locale)
  .filter((entry: any) => entry.category !== 'depracted') 
  .map((entry: any) => {
    const slug = entry.category;
    const mod = entry.module;
    const fm = mod.frontmatter ?? {};
    const categoryCopy = wikiDict.categories?.[slug] || {};
    const articles = getWikiArticles(locale, slug);
    
    return {
      slug,
      title: categoryCopy.title || fm.title || slug,
      description: categoryCopy.description || fm.description || '',
      icon: fm.icon || '📂',
      color: fm.color || 'text-btc-orange',
      order: fm.order ?? 99,
      articles: articles.map((art: any) => ({
        ...(art.module.frontmatter ?? {}),
        slug: art.slug,
        url: `${localizedPrefix}/wiki/${slug}/articles/${art.slug}`,
      })),
    };
  })
  .sort((a: any, b: any) => a.order - b.order);
---

<main class="pt-32 pb-24 min-h-screen bg-theme-section">
  <div class="container mx-auto px-6 max-w-7xl">
    
    <div class="text-center mb-12">
      <h1 class="text-4xl md:text-5xl font-display font-bold uppercase tracking-tight text-theme-main">
        {wikiDict.portalTitle || 'Builtechraft Documentation'}
      </h1>
      <p class="text-theme-muted mt-4 max-w-2xl mx-auto text-lg">
        {wikiDict.portalDescription || 'Choose a category to explore guides, tutorials, and technical documentation.'}
      </p>
    </div>

    {categories.map((cat: any) => (
      <section class="mb-16">
        <div class="flex items-center gap-3 mb-6">
          <span class="text-4xl">{cat.icon}</span>
          <div>
            <h2 class={`text-2xl font-display font-bold uppercase tracking-wide ${cat.color}`}>
              {cat.title}
            </h2>
            {cat.description && (
              <p class="text-theme-muted text-sm">{cat.description}</p>
            )}
          </div>
        </div>

        {cat.articles.length > 0 ? (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            {cat.articles.map((article: any) => (
              <a 
                href={article.url} 
                class="group flex items-start gap-4 p-4 bg-theme-card border border-theme-1 rounded-lg transition-all duration-300 hover:border-btc-orange/50 hover:-translate-y-0.5"
                style="box-shadow: 3px 3px 0px rgba(0,0,0,0.2);"
              >
                <span class="text-3xl shrink-0">{article.icon ?? '📄'}</span>
                <div class="flex-1 min-w-0">
                  <h3 class={`text-base font-display font-bold uppercase tracking-wide mb-1 ${article.color ?? 'text-btc-orange'} group-hover:underline truncate`}>
                    {article.title}
                  </h3>
                  <p class="text-xs text-theme-muted leading-relaxed line-clamp-2">
                    {article.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="text-center py-8 border border-dashed border-theme rounded-lg bg-theme-card/50">
            <p class="text-theme-muted text-sm">{wikiDict.noArticles || 'Todavía no hay artículos en esta categoría.'}</p>
          </div>
        )}
      </section>
    ))}
  </div>
</main>