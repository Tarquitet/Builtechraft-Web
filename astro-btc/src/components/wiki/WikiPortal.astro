---
import { getDictionary, getLocaleFromPath, type Locale } from '../../lib/i18n';
import { getWikiCategories, getWikiArticles } from '../../lib/wikiContent';

const locale = getLocaleFromPath(Astro.url.pathname) as Locale;
const dict = getDictionary(locale);
const wikiDict = dict.common?.wiki || {};

// Siempre usa el prefijo del idioma (/es o /en)
const localizedPrefix = `/${locale}`;

const categories = getWikiCategories(locale)
  .filter((entry: any) => entry.category !== 'depracted') 
  .map((entry: any) => {
    const slug = entry.category;
    const mod = entry.module;
    const fm = mod.frontmatter ?? {};
    const categoryCopy = wikiDict.categories?.[slug] || {};
    const articles = getWikiArticles(locale, slug);
    
    return {
      slug,
      title: categoryCopy.title || fm.title || slug,
      description: categoryCopy.description || fm.description || '',
      icon: fm.icon || '📂',
      color: fm.color || 'text-btc-orange',
      order: fm.order ?? 99,
      articles: articles.map((art: any) => ({
        ...(art.module.frontmatter ?? {}),
        slug: art.slug,
        url: `${localizedPrefix}/wiki/${slug}/articles/${art.slug}`,
      })),
    };
  })
  .sort((a: any, b: any) => a.order - b.order);
---

<main class="pt-32 pb-24 min-h-screen bg-theme-section">
  <div class="container mx-auto px-4 md:px-6 max-w-7xl">
    <div class="text-center mb-12">
      <h1 class="text-3xl md:text-5xl font-display font-bold uppercase tracking-tight text-theme-main">
        {wikiDict.portalTitle || 'Builtechraft Documentation'}
      </h1>
      <p class="text-theme-muted mt-4 max-w-2xl mx-auto text-sm md:text-lg">
        {wikiDict.portalDescription || 'Choose a category to explore guides, tutorials, and technical documentation.'}
      </p>
    </div>

    {categories.map((cat: any) => (
      <section class="mb-12 md:mb-16">
        <div class="flex items-center gap-3 mb-4 md:mb-6">
          <span class="text-3xl md:text-4xl">{cat.icon}</span>
          <div>
            <h2 class={`text-xl md:text-2xl font-display font-bold uppercase tracking-wide ${cat.color}`}>
              {cat.title}
            </h2>
            {cat.description && (
              <p class="text-theme-muted text-xs md:text-sm">{cat.description}</p>
            )}
          </div>
        </div>

        {cat.articles.length > 0 ? (
          <!-- CAMBIO: grid-cols-2 en móvil, sin aspect-square para que sean botones rectangulares bajos -->
          <div class="grid grid-cols-2 md:grid-cols-2 lg:grid-cols-3 gap-3 md:gap-4">
            {cat.articles.map((article: any) => (
              <a 
                href={article.url}
                class="group relative flex flex-col items-center justify-center text-center p-2 md:p-4 md:flex md:items-start md:text-left bg-theme-card border border-theme-1 rounded-lg transition-all duration-300 hover:border-btc-orange/50 hover:-translate-y-0.5 h-auto min-h-[80px] md:min-h-0 md:h-auto"
                style="box-shadow: 3px 3px 0px rgba(0,0,0,0.2);"
              >
                <!-- CAMBIO: Emoji más pequeño en móvil, sin margen inferior -->
                <span class="text-xl md:text-3xl shrink-0 mb-1 md:mb-2">{article.icon ?? '📄'}</span>
                
                <div class="flex-1 min-w-0 w-full">
                  <!-- CAMBIO: Título más pequeño en móvil, sin line-clamp para que crezca según el texto -->
                  <h3 class={`text-[10px] md:text-base font-display font-bold uppercase tracking-wide ${article.color ?? 'text-btc-orange'} group-hover:underline line-clamp-2 md:line-clamp-2`}>
                    {article.title}
                  </h3>
                  
                  <!-- Descripción OCULTA en móvil, visible solo en desktop -->
                  <p class="hidden md:block text-xs text-theme-muted leading-relaxed line-clamp-2 mt-1">
                    {article.description}
                  </p>
                </div>
              </a>
            ))}
          </div>
        ) : (
          <div class="text-center py-8 border border-dashed border-theme rounded-lg bg-theme-card/50">
            <p class="text-theme-muted text-sm">{wikiDict.noArticles || 'Todavía no hay artículos en esta categoría.'}</p>
          </div>
        )}
      </section>
    ))}
  </div>
</main>